TIMEZONE=America/New_York
REPORT_OUTPUT_DIR=reports
REPORT_LOG_DIR=logs
STATE_FILE=data/state.json

# ── Output generation ────────────────────────────────────────────────────────
GENERATE_PDF=true
GENERATE_DOCX=true
GENERATE_TOS=true

# ── Alert channels ───────────────────────────────────────────────────────────
ENABLE_EMAIL=false
ENABLE_WHATSAPP=false
ENABLE_SLACK=false
ENABLE_TELEGRAM=true

# ── Error log & notifications ─────────────────────────────────────────────────
# ERROR_NOTIFY_TELEGRAM: send Telegram alert when any pipeline stage errors
ERROR_NOTIFY_TELEGRAM=true

# ── Email (fill in when ready, then set ENABLE_EMAIL=true) ───────────────────
REPORT_EMAIL_FROM=alerts@yourdomain.com
REPORT_EMAIL_TO=you@yourdomain.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_VALUE
SMTP_USE_TLS=true

# ── Slack (fill in when ready, then set ENABLE_SLACK=true) ───────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/this/value

# ── Twilio WhatsApp (fill in when ready, then set ENABLE_WHATSAPP=true) ──────
TWILIO_SID=replace_with_twilio_sid
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_VALUE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+15555555555

# ── Telegram ──────────────────────────────────────────────────────────────────
# Setup: message @BotFather → /newbot → copy token
# Get chat_id: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_VALUE
TELEGRAM_CHAT_ID=123456789,987654321   # comma-separated telegram chat ids

# ── Finviz Elite ─────────────────────────────────────────────────────────────
# TOKEN (primary — from elite.finviz.com/api_explanation.ashx, never expires)
FINVIZ_API_TOKEN=REPLACE_WITH_YOUR_VALUE

# COOKIE (fallback — refresh periodically when expired)
FINVIZ_COOKIE=REPLACE_WITH_YOUR_VALUE
FINVIZ_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# ── Finviz News API ───────────────────────────────────────────────────────────
FINVIZ_NEWS_ENABLED=true

# ── Yahoo Finance News (5th fallback, no key needed) ─────────────────────────
YAHOO_NEWS_ENABLED=true

# ── Catalyst APIs ─────────────────────────────────────────────────────────────
FINNHUB_API_KEY=REPLACE_WITH_YOUR_VALUE
NEWSAPI_KEY=REPLACE_WITH_YOUR_VALUE
POLYGON_API_KEY=REPLACE_WITH_YOUR_VALUE
FMP_API_KEY=REPLACE_WITH_YOUR_VALUE
ALPHA_VANTAGE_API_KEY=REPLACE_WITH_YOUR_VALUE

# ── Local LLM (Ollama / Intel Arc) ────────────────────────────────────────────
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3:14b
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_BACKEND=vulkan
LOCAL_LLM_REQUIRE_GPU=true

# Ollama / Intel Arc Vulkan runtime (set in systemd override for persistent service)
OLLAMA_VULKAN=1
GGML_VK_VISIBLE_DEVICES=0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_VALUE
CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001
CLAUDE_ESCALATION_MODEL=claude-sonnet-4-20250514

# ── Optional fallback LLMs (leave blank, not used) ────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_YOUR_VALUE
BRAVE_SEARCH_API_KEY=REPLACE_WITH_YOUR_VALUE

# ── LLM (OpenAI) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_YOUR_VALUE

# ─ Postgres (set these to enable DB; leave unset for JSON-only mode) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trade_ai
DB_USER=trade_ai
DB_PASSWORD=set_to_your_postgres_password_here

# Default automated-trading account (canonical key; legacy alpaca_paper still accepted until migrated)
DEFAULT_PAPER_ACCOUNT=tradeai_automated
AUTOMATED_ACCOUNT_KEY=tradeai_automated
# Dual-lane entry routing (watchlist bridge + pullback/MACD): paper=ATM, broker=2FA
WATCHLIST_PAPER_ACCOUNT=tradeai_automated
WATCHLIST_BROKER_ACCOUNT=schwab_taxable
# Gate paper protection auto-apply until operator watches one ATM cycle (1=on, 0=hold)
PROTECTION_ATM_AUTO_APPLY_PAPER=1
# Trailing % is computed per proposal (hybrid: family base + ATR×mult, R-gated). Optional override cap:
# PROTECTION_TRAIL_PERCENT_MAX=12
