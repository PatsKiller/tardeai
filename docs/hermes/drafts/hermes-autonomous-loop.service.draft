# Hermes Autonomous Research Loop Service
# Requires Phase 3F approval before activation

[Unit]
Description=Hermes Autonomous Research Loop
After=network-online.target ollama.service hermes-gateway.service

[Service]
Type=oneshot
User=johnclaw
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/hermes_autonomous_loop.py --loop ticker_challenger --apply --max-rows 5
TimeoutStartSec=600
