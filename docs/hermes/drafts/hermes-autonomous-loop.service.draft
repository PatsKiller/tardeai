[Unit]
Description=Hermes Autonomous Ticker Challenger Loop
After=network-online.target ollama.service hermes-gateway.service

[Service]
Type=oneshot
User=johnclaw
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/hermes_autonomous_loop.py --loop ticker_challenger --dry-run --max-rows 3
TimeoutStartSec=600

# Safety: Do NOT change --dry-run to --apply without Phase 3F+ approval
