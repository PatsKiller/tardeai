  "contract_gaps": [
    {"gap":"no unified control-plane namespace","impact":"Consumers must join many legacy endpoints and cannot rely on one typed envelope or pagination contract","priority":"P1"},
    {"gap":"runtime status semantics vary by endpoint","impact":"LIVE/CALLABLE_ONLY/EXPECTED_IDLE/SHADOW/BROKEN are not consistently represented","priority":"P1"},
    {"gap":"workflow lineage is fragmented","impact":"No canonical event-to-entity-to-research-to-CIO trace endpoint with stable node/edge IDs","priority":"P1"},
    {"gap":"evidence class is not universal","impact":"Replay, shadow, dry-run and natural-current evidence can be conflated by UI consumers","priority":"P1"},
    {"gap":"store and identity health lack one contract","impact":"CanonicalStoreRegistry and identity confidence/unknown reasons are not exposed as a single read model","priority":"P1"},
    {"gap":"notification funnel is split","impact":"Candidate, policy disposition, delivery, receipt and dedupe require multiple sources","priority":"P1"},
    {"gap":"maturity evidence is not normalized","impact":"Scores and proof references cannot be compared dimension-by-dimension without bespoke adapters","priority":"P1"},
    {"gap":"pagination/filtering is inconsistent","impact":"Several routes return fixed limits or unbounded dashboard payloads","priority":"P2"},
    {"gap":"write surface is mixed into legacy dispatcher","impact":"Read-only administrative consumers need explicit method/authority metadata to avoid accidental mutation","priority":"P1"}
  ],
