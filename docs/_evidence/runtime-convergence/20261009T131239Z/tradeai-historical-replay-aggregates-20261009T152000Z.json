    "strategy_event_contract_field_presence": {
      "sql": "SELECT count(*) AS rows,count(*) FILTER(WHERE fired_at IS NOT NULL) AS rows_with_fired_at,min(fired_at) AS earliest_fired_at,max(fired_at) AS latest_fired_at,count(*) FILTER(WHERE fired_at>NOW()) AS future_fired_at,count(*) FILTER(WHERE price>0 AND price::text NOT IN ('NaN','Infinity','-Infinity')) AS positive_finite_stored_price,count(*) FILTER(WHERE btrim(coalesce(source_table,''))<>'' AND btrim(coalesce(source_record_id,''))<>'') AS source_record_lineage_present,count(*) FILTER(WHERE btrim(coalesce(sync_run_id,''))<>'') AS sync_run_lineage_present,count(*) FILTER(WHERE btrim(coalesce(discovery_trace_id,''))<>'') AS discovery_trace_present,count(*) FILTER(WHERE upper(signal_type)='GO') AS signal_type_go,count(*) FILTER(WHERE upper(signal_type) IN ('BUY','STRONG_BUY','ADD','ADD_ON_PULLBACK','REENTRY','ENTRY_NEAR','UPGRADE','CONVICTION','HOLD','MONITOR','HEDGE','SELL','TRIM','REDUCE','EXIT')) AS supported_advisory_signal_type,count(*) FILTER(WHERE fired_at>=NOW()-INTERVAL '30 days') AS event_rows_30d,count(*) FILTER(WHERE fired_at>=NOW()-INTERVAL '60 days') AS event_rows_60d,count(*) FILTER(WHERE fired_at>=NOW()-INTERVAL '90 days') AS event_rows_90d,count(*) FILTER(WHERE fired_at IS NOT NULL AND price>0 AND price::text NOT IN ('NaN','Infinity','-Infinity') AND btrim(coalesce(source_table,''))<>'' AND btrim(coalesce(source_record_id,''))<>'') AS fired_price_lineage_candidate_subset FROM public.strategy_signals",
