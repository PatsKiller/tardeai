# Operator test instance. Localhost UI only. No docker.sock. No production database URL.
name: m8m-n8n

networks:
  lab:
    internal: false

volumes:
  n8n-pg:
  n8n-data:

# 2026-10-22 FW-P2: the n8n_app password, generated by scripts/ops/n8n_db_app_role.py --apply into a file the
# operator owns (mode 600, dir 700). Non-swarm compose bind-mounts it read-only at /run/secrets/<name>; the
# container user node is uid 1000 = the file owner.
secrets:
  n8n_app_pg_password:
    file: /home/johnclaw/.config/tradeai/n8n/n8n_app_pg_password

services:
  n8n-db:
    image: postgres:16.15-alpine
    container_name: m8m-n8n-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: n8n
      POSTGRES_USER: n8n
      POSTGRES_PASSWORD: ${N8N_PG_PASSWORD}
    volumes:
      - n8n-pg:/var/lib/postgresql/data
    networks: [lab]
    mem_limit: 256m
    pids_limit: 128
    security_opt: ["no-new-privileges:true"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d n8n -U n8n"]
      interval: 5s
      timeout: 3s
      retries: 20

  n8n:
    # 2026-10-22 FW-P5 (AGENTS 23.24 Security (3), 23.23 governance (6)): pinned by digest, not only by tag.
    # Digest = the Docker Hub OCI index of n8nio/n8n:2.43.0, measured 2026-10-22 (docker buildx imagetools
    # inspect) and equal to the image the container runs today (docker inspect m8m-n8n .Image).
    image: n8nio/n8n:2.43.0@sha256:c6a3a0461d1d3ffc16d849adf57606c2b028667ade70cce2faa2ff094734873c
    container_name: m8m-n8n
    restart: unless-stopped
    environment:
      DB_TYPE: postgresdb
      DB_POSTGRESDB_HOST: n8n-db
      DB_POSTGRESDB_PORT: "5432"
      DB_POSTGRESDB_DATABASE: n8n
      # 2026-10-22 FW-P2 (AGENTS 23.10 P13, 23.23 governance (7)): n8n connects as n8n_app, a non-superuser that
      # owns the n8n schema objects (scripts/ops/n8n_db_app_role.py). The bootstrap superuser n8n stays for the
      # db container only; this container no longer holds its password. n8n reads <VAR>_FILE only when <VAR> is
      # unset, so DB_POSTGRESDB_PASSWORD is removed, not left beside the _FILE.
      DB_POSTGRESDB_USER: n8n_app
      DB_POSTGRESDB_PASSWORD_FILE: /run/secrets/n8n_app_pg_password
      N8N_ENCRYPTION_KEY: ${N8N_ENCRYPTION_KEY}
      N8N_HOST: 127.0.0.1
      N8N_PORT: "5678"
      N8N_PROTOCOL: http
      N8N_LISTEN_ADDRESS: 0.0.0.0
      WEBHOOK_URL: http://127.0.0.1:5678/
      N8N_DIAGNOSTICS_ENABLED: "false"
      N8N_VERSION_NOTIFICATIONS_ENABLED: "false"
      N8N_TEMPLATES_ENABLED: "false"
      N8N_HIRING_BANNER_ENABLED: "false"
      N8N_PERSONALIZATION_ENABLED: "false"
      N8N_COMMUNITY_PACKAGES_ENABLED: "false"
      N8N_BLOCK_ENV_ACCESS_IN_NODE: "true"
      N8N_PYTHON_ENABLED: "false"
      # 2026-10-09 audit C G7 / sec 23.10 P12: no n8n public API, so no n8n API key can exist.
      N8N_PUBLIC_API_DISABLED: "true"
      N8N_PUBLIC_API_SWAGGERUI_DISABLED: "true"
      # 2026-10-09 audit C G13 / sec 23.10 P22: AI features off (names measured in n8n 2.43.0 @n8n/config).
      N8N_AI_ENABLED: "false"
      N8N_AI_GATEWAY_ENABLED: "false"
      N8N_MCP_MANAGED_BY_ENV: "true"
      N8N_MCP_ACCESS_ENABLED: "false"
      N8N_MCP_BUILDER_ENABLED: "false"
      N8N_DISABLE_PUBLIC_CHAT_TRIGGER: "true"
      N8N_INSTANCE_AI_BROWSER_USE_ENABLED: "false"
      N8N_INSTANCE_AI_WORKFLOW_SUGGESTIONS_ENABLED: "false"
      N8N_INSTANCE_AI_SANDBOX_ENABLED: "false"
      N8N_AGENTS_TRACING_RECORD_INPUTS: "false"
      N8N_AGENTS_TRACING_RECORD_OUTPUTS: "false"
      # Default-on modules that carry the instance AI, native agents, chat hub, MCP server, MCP registry
      # (79 third-party servers) and AI workflow builder. Comma-separated (NOT JSON). Fallback if n8n will not
      # start with this line: delete only this line and recreate (compose-diff doc section 3b).
      N8N_DISABLED_MODULES: instance-ai,agents,chat-hub,mcp,mcp-registry,workflow-builder
      # Community packages: off and prevented from loading (0 installed, measured).
      N8N_COMMUNITY_PACKAGES_PREVENT_LOADING: "true"
      N8N_UNVERIFIED_PACKAGES_ENABLED: "false"
      N8N_VERIFIED_PACKAGES_ENABLED: "false"
      GENERIC_TIMEZONE: America/New_York
      # JSON array. A comma-separated string fails JSON.parse and becomes an empty exclude list.
      # Literal block: newlines are JSON whitespace. NO comments or trailing comma inside the block.
      # 2026-10-09 AGENTS.md 3.0.0 sec 23.8 / 23.10 P9, audit C G2+G13: kept the 8 original types, added
      # messaging senders, databases + brokers, file/git/n8n-API, MCP, HTTP/Code/search tools, vector stores
      # and memory (147 types), plus the Agent node and its chat/tool path (8 types, operator decision 2026-10-09: turning on the first Agent = removing these under a grant). Never listed: any type an active workflow uses (code, httpRequest, if,
      # scheduleTrigger, set, wait) nor noOp/errorTrigger/executeWorkflow. Proof: verify.sh check P9-b.
      NODES_EXCLUDE: |-
        [
        "n8n-nodes-base.executeCommand",
        "n8n-nodes-base.executeCommandTool",
        "n8n-nodes-base.ssh",
        "n8n-nodes-base.ftp",
        "n8n-nodes-base.emailSend",
        "n8n-nodes-base.emailSendTool",
        "n8n-nodes-base.emailSendHitlTool",
        "n8n-nodes-base.localFileTrigger",
        "n8n-nodes-base.telegram",
        "n8n-nodes-base.telegramTrigger",
        "n8n-nodes-base.telegramTool",
        "n8n-nodes-base.telegramHitlTool",
        "n8n-nodes-base.slack",
        "n8n-nodes-base.slackTrigger",
        "n8n-nodes-base.slackTool",
        "n8n-nodes-base.slackHitlTool",
        "n8n-nodes-base.discord",
        "n8n-nodes-base.discordTool",
        "n8n-nodes-base.discordHitlTool",
        "n8n-nodes-base.whatsApp",
        "n8n-nodes-base.whatsAppTrigger",
        "n8n-nodes-base.whatsAppTool",
        "n8n-nodes-base.whatsAppHitlTool",
        "n8n-nodes-base.microsoftTeams",
        "n8n-nodes-base.microsoftTeamsTrigger",
        "n8n-nodes-base.microsoftTeamsTool",
        "n8n-nodes-base.microsoftTeamsHitlTool",
        "n8n-nodes-base.googleChat",
        "n8n-nodes-base.googleChatTool",
        "n8n-nodes-base.googleChatHitlTool",
        "n8n-nodes-base.gmail",
        "n8n-nodes-base.gmailTrigger",
        "n8n-nodes-base.gmailTool",
        "n8n-nodes-base.gmailHitlTool",
        "n8n-nodes-base.microsoftOutlook",
        "n8n-nodes-base.microsoftOutlookTrigger",
        "n8n-nodes-base.microsoftOutlookTool",
        "n8n-nodes-base.microsoftOutlookHitlTool",
        "n8n-nodes-base.emailReadImap",
        "n8n-nodes-base.twilio",
        "n8n-nodes-base.twilioTrigger",
        "n8n-nodes-base.twilioTool",
        "n8n-nodes-base.matrix",
        "n8n-nodes-base.matrixTool",
        "n8n-nodes-base.mattermost",
        "n8n-nodes-base.mattermostTool",
        "n8n-nodes-base.rocketchat",
        "n8n-nodes-base.rocketchatTool",
        "n8n-nodes-base.zulip",
        "n8n-nodes-base.zulipTool",
        "n8n-nodes-base.sendGrid",
        "n8n-nodes-base.sendGridTool",
        "n8n-nodes-base.mailgun",
        "n8n-nodes-base.mailgunTool",
        "n8n-nodes-base.pushover",
        "n8n-nodes-base.pushoverTool",
        "n8n-nodes-base.postgres",
        "n8n-nodes-base.postgresTrigger",
        "n8n-nodes-base.postgresTool",
        "n8n-nodes-base.mySql",
        "n8n-nodes-base.mySqlTool",
        "n8n-nodes-base.microsoftSql",
        "n8n-nodes-base.microsoftSqlTool",
        "n8n-nodes-base.mongoDb",
        "n8n-nodes-base.mongoDbTool",
        "n8n-nodes-base.redis",
        "n8n-nodes-base.redisTrigger",
        "n8n-nodes-base.redisTool",
        "n8n-nodes-base.oracleDatabase",
        "n8n-nodes-base.oracleDatabaseTool",
        "n8n-nodes-base.questDb",
        "n8n-nodes-base.questDbTool",
        "n8n-nodes-base.timescaleDb",
        "n8n-nodes-base.timescaleDbTool",
        "n8n-nodes-base.crateDb",
        "n8n-nodes-base.crateDbTool",
        "n8n-nodes-base.snowflake",
        "n8n-nodes-base.snowflakeTool",
        "n8n-nodes-base.supabase",
        "n8n-nodes-base.supabaseTool",
        "n8n-nodes-base.elasticsearch",
        "n8n-nodes-base.elasticsearchTool",
        "n8n-nodes-base.googleBigQuery",
        "n8n-nodes-base.googleBigQueryTool",
        "n8n-nodes-base.databricks",
        "n8n-nodes-base.databricksTool",
        "n8n-nodes-base.dataTable",
        "n8n-nodes-base.dataTableTool",
        "n8n-nodes-base.kafka",
        "n8n-nodes-base.kafkaTrigger",
        "n8n-nodes-base.kafkaTool",
        "n8n-nodes-base.rabbitmq",
        "n8n-nodes-base.rabbitmqTrigger",
        "n8n-nodes-base.rabbitmqTool",
        "n8n-nodes-base.amqp",
        "n8n-nodes-base.amqpTrigger",
        "n8n-nodes-base.amqpTool",
        "n8n-nodes-base.mqtt",
        "n8n-nodes-base.mqttTrigger",
        "n8n-nodes-base.mqttTool",
        "n8n-nodes-base.readWriteFile",
        "n8n-nodes-base.readBinaryFile",
        "n8n-nodes-base.readBinaryFiles",
        "n8n-nodes-base.writeBinaryFile",
        "n8n-nodes-base.git",
        "n8n-nodes-base.gitTool",
        "n8n-nodes-base.n8n",
        "@n8n/n8n-nodes-langchain.mcpTrigger",
        "@n8n/n8n-nodes-langchain.mcpClient",
        "@n8n/n8n-nodes-langchain.mcpClientTool",
        "@n8n/n8n-nodes-langchain.mcpRegistryClientTool",
        "n8n-nodes-base.httpRequestTool",
        "@n8n/n8n-nodes-langchain.toolHttpRequest",
        "@n8n/n8n-nodes-langchain.toolCode",
        "@n8n/n8n-nodes-langchain.code",
        "@n8n/n8n-nodes-langchain.toolSearXng",
        "@n8n/n8n-nodes-langchain.toolSerpApi",
        "@n8n/n8n-nodes-langchain.toolWikipedia",
        "@n8n/n8n-nodes-langchain.toolWolframAlpha",
        "@n8n/n8n-nodes-langchain.chatHubVectorStorePGVector",
        "@n8n/n8n-nodes-langchain.chatHubVectorStorePinecone",
        "@n8n/n8n-nodes-langchain.chatHubVectorStoreQdrant",
        "@n8n/n8n-nodes-langchain.memoryBufferWindow",
        "@n8n/n8n-nodes-langchain.memoryChatRetriever",
        "@n8n/n8n-nodes-langchain.memoryManager",
        "@n8n/n8n-nodes-langchain.memoryMongoDbChat",
        "@n8n/n8n-nodes-langchain.memoryMotorhead",
        "@n8n/n8n-nodes-langchain.memoryPostgresChat",
        "@n8n/n8n-nodes-langchain.memoryRedisChat",
        "@n8n/n8n-nodes-langchain.memoryXata",
        "@n8n/n8n-nodes-langchain.memoryZep",
        "@n8n/n8n-nodes-langchain.vectorStoreAzureAISearch",
        "@n8n/n8n-nodes-langchain.vectorStoreChromaDB",
        "@n8n/n8n-nodes-langchain.vectorStoreDatabricks",
        "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
        "@n8n/n8n-nodes-langchain.vectorStoreInMemoryInsert",
        "@n8n/n8n-nodes-langchain.vectorStoreInMemoryLoad",
        "@n8n/n8n-nodes-langchain.vectorStoreMilvus",
        "@n8n/n8n-nodes-langchain.vectorStoreMongoDBAtlas",
        "@n8n/n8n-nodes-langchain.vectorStoreOracleDBVector",
        "@n8n/n8n-nodes-langchain.vectorStorePGVector",
        "@n8n/n8n-nodes-langchain.vectorStorePinecone",
        "@n8n/n8n-nodes-langchain.vectorStorePineconeInsert",
        "@n8n/n8n-nodes-langchain.vectorStorePineconeLoad",
        "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
        "@n8n/n8n-nodes-langchain.vectorStoreRedis",
        "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
        "@n8n/n8n-nodes-langchain.vectorStoreSupabaseInsert",
        "@n8n/n8n-nodes-langchain.vectorStoreSupabaseLoad",
        "@n8n/n8n-nodes-langchain.vectorStoreWeaviate",
        "@n8n/n8n-nodes-langchain.vectorStoreZep",
        "@n8n/n8n-nodes-langchain.vectorStoreZepInsert",
        "@n8n/n8n-nodes-langchain.vectorStoreZepLoad",
        "@n8n/n8n-nodes-langchain.toolVectorStore",
        "@n8n/n8n-nodes-langchain.retrieverVectorStore",
        "@n8n/n8n-nodes-langchain.agent",
        "@n8n/n8n-nodes-langchain.agentTool",
        "@n8n/n8n-nodes-langchain.openAiAssistant",
        "@n8n/n8n-nodes-langchain.toolWorkflow",
        "@n8n/n8n-nodes-langchain.toolExecutor",
        "@n8n/n8n-nodes-langchain.chatTrigger",
        "@n8n/n8n-nodes-langchain.manualChatTrigger",
        "@n8n/n8n-nodes-langchain.microsoftAgent365Trigger"
        ]
      # 2026-10-22 FW-P1 (AGENTS 23.23 governance (3), 23.24 Monitoring (1)): successful executions are saved, so
      # every run joins the ledger by run_id. Retention below: prune on, 168 h max age, 20000 rows max (n8n prunes
      # its own execution rows; nothing else is touched). Redaction: n8n 2.43 execution-data redaction (workflow
      # settings.redactionPolicy / instance floor) is license-gated (isDataRedactionLicensed) and resolves to 'none'
      # on this instance, so the controls are: manual runs not saved (below), N8N_BLOCK_ENV_ACCESS_IN_NODE, no
      # credential in any node output (relay bearer is a stored credential, never echoed), 168 h retention.
      EXECUTIONS_DATA_SAVE_ON_SUCCESS: all
      EXECUTIONS_DATA_SAVE_ON_ERROR: all
      # 2026-10-09 audit C G8 / sec 23.10 P19: manual (editor) runs are not stored.
      EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS: "false"
      EXECUTIONS_DATA_PRUNE: "true"
      EXECUTIONS_DATA_MAX_AGE: "168"
      EXECUTIONS_DATA_PRUNE_MAX_COUNT: "20000"
      N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "true"
    volumes:
      - n8n-data:/home/node/.n8n
    secrets:
      - n8n_app_pg_password
    ports:
      - "127.0.0.1:5678:5678"
    # 2026-10-10 F2 (grant 1beea8a48b03a87b): the run relay by a stable name, so workflows need no bare IP.
    # The relay binds 172.19.0.1:18092 (the lab network gateway). Not host.docker.internal: that is 172.17.0.1.
    extra_hosts:
      - "tradeai-relay:172.19.0.1"
    networks: [lab]
    depends_on:
      n8n-db:
        condition: service_healthy
    mem_limit: 768m
    pids_limit: 256
    security_opt: ["no-new-privileges:true"]
