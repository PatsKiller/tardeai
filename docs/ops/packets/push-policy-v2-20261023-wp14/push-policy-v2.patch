+def test_claim_check_against_a_real_board(tmp_path, monkeypatch):
+    from scripts.lib import agent_claim_board as CB
+
+    monkeypatch.setenv("TRADEAI_AGENT_CLAIMS_DIR", str(tmp_path / "claims"))
+    board = CB.ClaimBoard(tmp_path / "claims")
+    out = board.claim(task="t", paths=["scripts/x.py"], branch="feat/x", vendor="claude", session="s1", agent="a")
+    cid = out["claim_id"] if isinstance(out, dict) else getattr(out, "claim_id", None) or out.doc["claim_id"]
+    assert B.claim_check(cid, "feat/x")[0] is True
+    ok, why = B.claim_check(cid, "feat/y")
