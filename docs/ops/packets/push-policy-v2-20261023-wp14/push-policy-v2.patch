+# ------------------------------------------------------------------------------------------------ the hook itself
+
+
+def _run(cmd, cwd, env=None, check=False):
+    return subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True, check=check, timeout=120)
+
+
+def _mini(tmp: Path, *, policy: str | None, agents: str = AGENTS_20_ACTIVE) -> Path:
+    src, remote = tmp / "src", tmp / "remote.git"
+    src.mkdir()
+    _run(["git", "init", "-q", "--bare", str(remote)], tmp, check=True)
+    _run(["git", "init", "-q", "-b", "main"], src, check=True)
+    _run(["git", "config", "user.email", "p@t.local"], src, check=True)
+    _run(["git", "config", "user.name", "p"], src, check=True)
+    (src / ".githooks").mkdir()
+    shutil.copy2(PRE_PUSH, src / ".githooks/pre-push")
+    os.chmod(src / ".githooks/pre-push", os.stat(src / ".githooks/pre-push").st_mode | stat.S_IEXEC)
+    lib = src / "scripts" / "lib"
+    lib.mkdir(parents=True)
+    for name in (
+        "tradeai_push_budget.py",
+        "guard_push_auth.py",
+        "agent_claim_board.py",
+        "agent_claim_lifecycle.py",
+        "agent_claim_worklog.py",
+        "agent_file_lease.py",
+    ):
+        shutil.copy2(ROOT / "scripts/lib" / name, lib / name)
+    (src / "scripts" / "__init__.py").write_text("")
+    (lib / "__init__.py").write_text("")
+    (src / "scripts" / "check_no_secrets.py").write_text("import sys\nsys.exit(0)\n")
+    if policy is not None:
+        (src / "AI_WORK_POLICY.md").write_text(policy)
+    (src / "AGENTS.md").write_text(agents)
+    (src / "README").write_text("0\n")
+    _run(["git", "add", "."], src, check=True)
+    _run(["git", "commit", "-qm", "init"], src, check=True)
+    _run(["git", "remote", "add", "origin", str(remote)], src, check=True)
+    _run(["git", "config", "core.hooksPath", ".githooks"], src, check=True)
+    return src
+
+
+def _env(src: Path, tmp: Path, **extra: str) -> dict:
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("TRADEAI_", "AGENT_CLAIM_"))}
+    env.update(
+        {
+            "HOME": str(tmp / "home"),
+            "XDG_CONFIG_HOME": str(tmp / "home/.config"),
+            "GUARD_APPROVALS_DIR": str(tmp / "approvals"),
+            "TRADEAI_SKIP_SECRETS_SCAN": "1",
+            "TRADEAI_PUSH_BUDGET_PATH": str(src / ".git/tradeai-push-budget.v2.json"),
+            "TRADEAI_AGENT_CLAIMS_DIR": str(tmp / "claims"),
+            "TRADE_AI_CI": "1",
+            "PYTHONPATH": str(src),
+        }
+    )
+    env.update(extra)
+    return env
+
+
+def _commit(src: Path, n: int) -> None:
+    (src / "README").write_text(f"{n}\n")
+    _run(["git", "commit", "-qam", f"c{n}"], src, check=True)
+
+
+def _claim(tmp: Path, branch: str) -> str:
+    from scripts.lib import agent_claim_board as CB
+
+    out = CB.ClaimBoard(tmp / "claims").claim(
+        task="t", paths=["README"], branch=branch, vendor="claude", session="s1", agent="a"
+    )
+    return out["claim_id"] if isinstance(out, dict) else out.doc["claim_id"]
+
+
+def _ledger(src: Path) -> list[dict]:
+    p = src / ".git" / B.PUSH_LEDGER_NAME
+    return [json.loads(x) for x in p.read_text().splitlines()] if p.exists() else []
+
