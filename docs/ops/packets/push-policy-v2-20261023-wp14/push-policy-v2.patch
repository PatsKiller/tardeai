+
+
+def test_active_hook_train_class_fails_closed_without_a_reservation_bridge(tmp_path, monkeypatch):
+    (tmp_path / "AI_WORK_POLICY.md").write_text(POLICY_ACTIVE)
+    (tmp_path / "AGENTS.md").write_text(AGENTS_20_ACTIVE)
+    monkeypatch.setenv("TRADEAI_PUSH_BUDGET_PATH", str(tmp_path / "budget.json"))
+    tid = "train-20261023-1800"
+    d = B.hook_decide(
+        push_refs=f"refs/heads/train/{tid} {SHA_A} refs/heads/train/{tid} {ZERO}",
+        policy_root=tmp_path,
+        authorized=True,
+        env_override=False,
+        guard_ok=True,
+        guard_reason="override: untrusted env fixture",
+        guard_grant_id="0123abcd99887766",
