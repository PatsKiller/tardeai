+#   enforce  `Push-Policy-v2: ACTIVE` and AGENTS.md >= 20.0.0 ACTIVE (rule 11 is the standing operator intent
+#            for continuity pushes; the claim board is mandatory there).
+#
+# Not cryptographic security: like v1 it makes accidental push loops and habitual overrides fail closed, and it
+# writes every decision, allowed or refused, to an append-only local ledger.
+
+POLICY_V2_SCHEMA = "TradeAIPushPolicy@v2"
+LEDGER_EVENT_SCHEMA = "TradeAIPushEvent@v2"
+PUSH_LEDGER_NAME = "tradeai-push-ledger.v2.jsonl"
+MODE_LEGACY, MODE_SHADOW, MODE_ENFORCE = "legacy", "shadow", "enforce"
+CLASSES = ("wip", "review", "train", "operator")
+DEFAULT_CLASS = "review"
+POLICY_V2_MARKER_RE = re.compile(r"^Push-Policy-v2:\s*(PROPOSED|ACTIVE|WITHDRAWN)\b", re.MULTILINE)
+AGENTS_MIN_VERSION_FOR_ENFORCE = (20, 0, 0)
+
+WIP_MIN_INTERVAL_S = 15 * 60
+WIP_DAILY_MAX = 32
+WIP_COST_MIN = 1  # draft-quick-check: about one runner-minute
+DAY_S = 24 * 3600
+# Estimated GitHub-hosted runner-minutes per full-fleet PR run. Basis: 2026-10-23 sample, 200 pull_request runs over
+# 27 PR pushes, every PR runs cio-hardening (~9 min), cio-full-suite-sharded (11 jobs, ~6-7 min each), release-
+# readiness, agent-governance, aif-financial-senses, provider-cost, plus path-filtered UI jobs. A measured reconciler
+# (GitHub run timings) may replace the estimate; until then the estimate is the budget unit.
+REVIEW_COST_POLICY: dict[str, Any] = {
+    "est_minutes_per_push": 75,
+    "branch_daily_minutes": 300,  # ~4 full CI cycles per branch per rolling 24 h
+    "global_daily_minutes": 3000,  # ~40 full CI cycles per rolling 24 h for this repository (this host's ledger)
+    "basis": "estimate; docs/ops/PUSH_POLICY_V2.md (2026-10-23 sample)",
+}
+PROTECTED_EXACT = ("main", "master")
+PROTECTED_PREFIXES = ("train/", "refs/")  # refs/ = anything that is not refs/heads/* (tags, notes)
+TRAIN_ID_RE = re.compile(r"^(?:train-\d{8}-\d{4}(?:-[a-z0-9]{1,12})?|rt-\d{8}-\d{4}-[a-z0-9]{4,12})$")
+REASON_RE = re.compile(r"^(claim|operator|train):([A-Za-z0-9_.:-]{4,80})(?:\s+(.{0,200}))?$")
+
+
+def policy_marker(text: str | None) -> str | None:
+    """`PROPOSED` | `ACTIVE` | `WITHDRAWN` from AI_WORK_POLICY.md's `Push-Policy-v2:` line, or None."""
+    m = POLICY_V2_MARKER_RE.search(text or "")
+    return m.group(1) if m else None
+
+
+def agents_version_active(text: str | None) -> tuple[tuple[int, int, int] | None, bool]:
+    """(Policy-Version, Status is ACTIVE) from AGENTS.md's header block."""
+    v = re.search(r"^Policy-Version:\s*(\d+)\.(\d+)\.(\d+)\s*$", text or "", re.MULTILINE)
+    s = re.search(r"^Status:\s*(\S+)", text or "", re.MULTILINE)
+    ver = (int(v.group(1)), int(v.group(2)), int(v.group(3))) if v else None
+    return ver, bool(s and s.group(1).upper() == "ACTIVE")
+
+
+def policy_mode(policy_text: str | None, agents_text: str | None) -> tuple[str, str]:
+    """(mode, why). Fails toward legacy (v1, today's behaviour) when the policy cannot be read."""
+    marker = policy_marker(policy_text)
+    if marker is None or marker == "WITHDRAWN":
+        return MODE_LEGACY, f"Push-Policy-v2 marker {marker or 'absent'}"
+    if marker == "PROPOSED":
+        return MODE_SHADOW, "Push-Policy-v2: PROPOSED"
+    ver, active = agents_version_active(agents_text)
+    if ver is None or ver < AGENTS_MIN_VERSION_FOR_ENFORCE or not active:
+        shown = ".".join(map(str, ver)) if ver else "unknown"
+        return (
+            MODE_SHADOW,
+            f"Push-Policy-v2: ACTIVE but AGENTS.md {shown} {'ACTIVE' if active else 'not ACTIVE'} (< 20.0.0 ACTIVE)",
+        )
+    return MODE_ENFORCE, "Push-Policy-v2: ACTIVE and AGENTS.md >= 20.0.0 ACTIVE"
+
+
+def read_policy_mode(policy_root: Path | str) -> tuple[str, str]:
+    root = Path(policy_root)
+
+    def _read(name: str) -> str | None:
+        try:
+            return (root / name).read_text(encoding="utf-8")
+        except OSError:
+            return None
+
+    return policy_mode(_read("AI_WORK_POLICY.md"), _read("AGENTS.md"))
+
+
+def parse_reason(text: str | None) -> dict[str, str] | None:
+    """`claim:<id>`, `operator:<grant id>` or `train:<train id>`, optionally followed by free text."""
+    m = REASON_RE.match(str(text or "").strip())
+    if not m:
+        return None
+    return {"kind": m.group(1), "id": m.group(2), "note": (m.group(3) or "").strip()}
+
+
+def is_protected(branch: str) -> bool:
+    b = str(branch or "")
+    return b in PROTECTED_EXACT or b.startswith(PROTECTED_PREFIXES)
+
+
+# --------------------------------------------------------------------------- ledger (append-only)
+
+
+def ledger_path() -> Path:
+    return state_path().parent / PUSH_LEDGER_NAME
+
+
+def reservation_lock_path() -> Path:
+    """Shared across linked worktrees; held by the hook from decision through reservation."""
+    return ledger_path().with_name(PUSH_LEDGER_NAME + ".reservation.lock")
+
+
+def read_ledger(
+    *, since_ts: float | None = None, path: Path | None = None, strict: bool = False
+) -> list[dict[str, Any]]:
+    p = path or ledger_path()
+    out: list[dict[str, Any]] = []
+    try:
+        with p.open("r", encoding="utf-8") as fh:
+            for line in fh:
+                try:
+                    ev = json.loads(line)
+                except ValueError:
+                    if strict:
+                        raise
+                    continue
+                if not isinstance(ev, dict):
+                    if strict:
+                        raise ValueError("ledger row is not an object")
+                    continue
+                if since_ts is not None and float(ev.get("ts") or 0) < since_ts:
+                    continue
+                out.append(ev)
+    except FileNotFoundError:
+        return []
+    except OSError:
+        if strict:
+            raise
+        return []
+    return out
+
+
+def ledger_writable() -> bool:
+    """Tests (TRADE_AI_CI=1) write a ledger only into the scratch budget path they set (AGENTS.md §24.6)."""
+    return os.environ.get("TRADE_AI_CI") != "1" or bool(os.environ.get("TRADEAI_PUSH_BUDGET_PATH"))
+
+
+def append_ledger(event: dict[str, Any], *, path: Path | None = None) -> None:
+    """One JSON line per decision, under the budget lock. Never rewritten, never truncated."""
+    if path is None and not ledger_writable():
+        return
+    p = path or ledger_path()
+    ev = {"schema": LEDGER_EVENT_SCHEMA, **event}
+    with _locked(p):
+        with p.open("a", encoding="utf-8") as fh:
+            fh.write(json.dumps(ev, sort_keys=True) + "\n")
+            fh.flush()
+            os.fsync(fh.fileno())
+
+
+# --------------------------------------------------------------------------- probes (injectable for tests)
+
+
+def claim_check(claim_id: str, branch: str) -> tuple[bool, str]:
+    """An active, live (not stale) claim on the claim board whose branch is the pushed branch."""
+    if os.environ.get("TRADE_AI_CI") == "1" and not os.environ.get("TRADEAI_AGENT_CLAIMS_DIR"):
+        return False, "TRADE_AI_CI=1 without TRADEAI_AGENT_CLAIMS_DIR: tests never read the production claim board"
+    try:
+        from scripts.lib import agent_claim_board as CB  # noqa: PLC0415
+    except ImportError as exc:  # pragma: no cover - the board ships on main since #1977
+        return False, f"claim board unavailable ({type(exc).__name__})"
+    try:
+        view = CB.ClaimBoard().get(claim_id)
+    except Exception as exc:  # noqa: BLE001 - ClaimError and unreadable stores are both a refusal
+        return False, f"claim {claim_id}: {str(exc)[:160]}"
+    if view.state != "live":
+        return False, f"claim {claim_id} is {view.state} (needs a live claim: heartbeat within the stale window)"
+    cbranch = str(view.doc.get("branch") or "")
+    if cbranch != branch:
+        return False, f"claim {claim_id} is for branch {cbranch or '(none)'!r}, not {branch!r}"
+    stage = str(view.doc.get("stage") or "")
+    if stage in ("merged", "released"):
+        return False, f"claim {claim_id} is at stage {stage}: the work has landed; open a new claim"
+    return True, f"claim {claim_id} live on {branch}"
+
+
+def fast_forward(remote_sha: str, local_sha: str) -> bool | None:
+    """True: new branch or remote is an ancestor of local. False: a rewrite. None: remote object unknown here."""
+    if not remote_sha or remote_sha == ZERO_SHA:
+        return True
+    try:
+        rc = subprocess.run(
+            ["git", "merge-base", "--is-ancestor", remote_sha, local_sha], capture_output=True, timeout=30
+        ).returncode
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    return True if rc == 0 else (False if rc == 1 else None)
+
+
+def pr_lookup(branch: str) -> dict[str, Any]:
+    """The branch's open PR: {"state": "none"|"draft"|"ready"|"unknown", "number": int|None, "why": str}."""
+    if os.environ.get("TRADEAI_PUSH_PR_LOOKUP", "").lower() in ("off", "0", "false"):
+        return {"state": "unknown", "number": None, "why": "lookup disabled (TRADEAI_PUSH_PR_LOOKUP=off)"}
+    if os.environ.get("TRADE_AI_CI") == "1":
+        return {"state": "unknown", "number": None, "why": "TRADE_AI_CI=1: no GitHub lookup from tests"}
+    try:
+        p = subprocess.run(
+            ["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "number,isDraft", "--limit", "5"],
+            capture_output=True,
+            text=True,
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return {"state": "unknown", "number": None, "why": f"gh unavailable ({type(exc).__name__})"}
+    if p.returncode != 0:
+        return {"state": "unknown", "number": None, "why": f"gh rc={p.returncode}: {p.stderr.strip()[:120]}"}
+    try:
+        rows = json.loads(p.stdout or "[]")
+    except ValueError:
+        return {"state": "unknown", "number": None, "why": "gh output unreadable"}
+    if not rows:
+        return {"state": "none", "number": None, "why": "no open PR"}
+    ready = [r for r in rows if not r.get("isDraft")]
+    row = (ready or rows)[0]
+    return {"state": "ready" if ready else "draft", "number": row.get("number"), "why": "gh pr list"}
+
+
+# --------------------------------------------------------------------------- decision
+
+
+def _v2(code: str, allow: bool, why: str, **extra: Any) -> dict[str, Any]:
+    return {"allow": allow, "code": code, "why": why, **extra}
+
+
+def decide_v2(
+    refs: list[dict[str, Any]],
+    *,
+    push_class: str | None,
+    reason: str | None,
+    authorized: bool,
+    env_override: bool,
+    guard_ok: bool,
+    guard_reason: str | None,
+    guard_grant_id: str | None,
+    release_train_id: str | None,
+    events: list[dict[str, Any]],
+    now_ts: float,
+    claim_probe=claim_check,
+    ff_probe=fast_forward,
+    pr_probe=pr_lookup,
+) -> dict[str, Any]:
+    """The v2 verdict for one push (every ref must pass). Pure apart from the three injected probes."""
+    cls = (push_class or DEFAULT_CLASS).strip().lower()
+    notes: list[str] = []
+    if env_override:
+        notes.append(
+            "TRADEAI_REMOTE_PUSH_OVERRIDE is retired under v2 and lifts nothing; an over-budget push needs "
+            "an operator git-push grant whose reason says override, named by TRADEAI_PUSH_REASON=operator:<id>"
+        )
+    base = {"class": cls, "notes": notes, "cost_min": 0, "branches": [r["branch"] for r in refs]}
+    if cls not in CLASSES:
+        return _v2("REFUSED_CLASS", False, f"TRADEAI_PUSH_CLASS={cls!r} is not one of {', '.join(CLASSES)}", **base)
+    if not refs:
+        return _v2("REFUSED_NO_REFS", False, "no refs on the pre-push input", **base)
+    r = parse_reason(reason)
+
+    # train: the host release service's one ref, nothing else
+    if cls == "train":
+        tid = str(release_train_id or "")
+        want = f"train/{tid}"
+        if not TRAIN_ID_RE.match(tid):
+            return _v2("REFUSED_TRAIN", False, "TRADEAI_RELEASE_TRAIN_ID missing or malformed", **base)
+        if [x["branch"] for x in refs] != [want] or refs[0]["delete"]:
+            return _v2("REFUSED_TRAIN", False, f"class train pushes exactly {want} and nothing else", **base)
+        if not r or r["kind"] != "train" or r["id"] != tid:
+            return _v2("REFUSED_REASON", False, f"class train needs TRADEAI_PUSH_REASON=train:{tid}", **base)
+        # §25: an environment variable identifies a train; it cannot prove host-service
+        # identity or a reserved ReleaseCapability. The generic pre-push hook has no
+        # verified reservation bridge yet. Keep this class fail closed until that
+        # integration is separately reviewed; neither AUTHORIZED nor a guard override
+        # substitutes for the train's own reservation.
+        return _v2(
+            "TRAIN_AUTHORITY_UNPROVEN",
+            False,
+            "train ref/reason match, but verified host-service ReleaseCapability reservation "
+            "proof is not wired; environment variables identify only",
+            **base,
+        )
+
+    # operator: an operator-issued guard grant, named by the reason
+    if cls == "operator":
+        gid = str(guard_grant_id or "")
+        if not guard_ok or not gid:
+            return _v2(
+                "REFUSED_OPERATOR",
+                False,
+                "class operator needs an active guard git-push grant covering every "
+                "pushed ref (bin/guard grant git-push ..., issued by the operator)",
+                **base,
+            )
+        if not r or r["kind"] != "operator" or len(r["id"]) < 8 or not gid.startswith(r["id"]):
+            return _v2("REFUSED_REASON", False, f"class operator needs TRADEAI_PUSH_REASON=operator:{gid[:12]}", **base)
+        return _v2("OPERATOR", True, f"operator grant {gid[:12]}", **base)
+
+    # wip / review (agents)
+    for x in refs:
+        if x["delete"]:
+            return _v2(
+                "REFUSED_DELETE", False, f"deleting remote branch {x['branch']!r} is operator-only (§0 rule 6)", **base
+            )
+        if is_protected(x["branch"]):
+            return _v2(
+                "REFUSED_PROTECTED_REF",
+                False,
+                f"agents never push {x['branch']!r}: main and train/* are the "
+                "release train's and the operator's (AGENTS.md §25.1; AI_WORK_POLICY.md §28-§29)",
+                **base,
+            )
+    if not authorized:
+        return _v2(
+            "UNAUTHORIZED", False, "TRADEAI_REMOTE_PUSH_AUTHORIZED=1 (or an active git-push grant) is required", **base
+        )
+    if not r or r["kind"] != "claim":
+        return _v2(
+            "REFUSED_REASON",
+            False,
+            "set TRADEAI_PUSH_REASON=claim:<claim id> (scripts/agent_claim.py claim "
+            "...); an untyped or missing reason is refused",
+            **base,
+        )
+    for x in refs:
+        ok, why = claim_probe(r["id"], x["branch"])
+        if not ok:
+            return _v2("REFUSED_CLAIM", False, why, claim_id=r["id"], **base)
+    base["claim_id"] = r["id"]
+    over_grant = bool(guard_ok and grant_overrides_budget(guard_reason))
+
+    if cls == "wip":
+        for x in refs:
+            ff = ff_probe(x["remote_sha"], x["local_sha"])
+            if ff is False:
+                return _v2(
+                    "REFUSED_REWRITE", False, f"a wip push never rewrites {x['branch']!r} (non-fast-forward)", **base
+                )
+            if ff is None:
+                return _v2(
+                    "REFUSED_FF_UNKNOWN",
+                    False,
+                    f"cannot prove {x['branch']!r} fast-forwards: git fetch origin {x['branch']} first",
+                    **base,
+                )
+            pr = pr_probe(x["branch"])
+            base["pr_state"] = pr["state"]
+            if pr["state"] == "ready":
+                return _v2(
+                    "REFUSED_READY_PR",
+                    False,
+                    f"{x['branch']!r} has a READY PR #{pr['number']}; a push there "
+                    "starts full CI and is a review push (TRADEAI_PUSH_CLASS=review), or convert it to draft",
+                    **base,
+                )
+            if pr["state"] != "draft":
+                return _v2(
+                    "REFUSED_DRAFT_UNPROVEN",
+                    False,
+                    f"{x['branch']!r} needs a proven draft PR; state={pr['state']} "
+                    f"({pr['why']}). Unknown, absent or unreadable PR state cannot authorize WIP CI",
+                    **base,
+                )
+            mine = [
+                e
+                for e in events
+                if x["branch"] in (e.get("branches") or [e.get("branch")])
+                and e.get("class") == "wip"
+                and e.get("effective_allow")
+            ]
+            last = max((float(e.get("ts") or 0) for e in mine), default=0.0)
+            if last and now_ts - last < WIP_MIN_INTERVAL_S:
+                wait = int(WIP_MIN_INTERVAL_S - (now_ts - last))
+                return _v2(
+                    "RATE_LIMITED",
+                    False,
+                    f"one wip push per {WIP_MIN_INTERVAL_S // 60} min per branch; "
+                    f"{x['branch']!r} may push again in {wait} s (commit locally meanwhile)",
+                    **base,
+                )
+            today = [e for e in mine if now_ts - float(e.get("ts") or 0) < DAY_S]
+            if len(today) >= WIP_DAILY_MAX and not over_grant:
+                return _v2(
+                    "WIP_DAILY_CAP",
+                    False,
+                    f"{len(today)} wip pushes of {x['branch']!r} in 24 h (cap {WIP_DAILY_MAX})",
+                    **base,
+                )
+        base["cost_min"] = WIP_COST_MIN * len(refs)
+        return _v2("WIP", True, "continuity push (draft PR: draft-quick-check only)", **base)
+
+    # review: budgeted by estimated CI runner-minutes
+    est = int(REVIEW_COST_POLICY["est_minutes_per_push"])
+    day = [
+        e
+        for e in events
+        if now_ts - float(e.get("ts") or 0) < DAY_S
+        and e.get("effective_allow")
+        and e.get("class") in ("review", "operator")
+    ]
+    total_cost = 0
+    for x in refs:
+        pr = pr_probe(x["branch"])
+        base["pr_state"] = pr["state"]
+        cost = WIP_COST_MIN if pr["state"] == "draft" else est
+        if pr["state"] == "draft":
+            notes.append(
+                f"{x['branch']!r} has a DRAFT PR: this push runs draft-quick-check only; class wip is the "
+                "usual class for it"
+            )
+        spent_branch = sum(int(e.get("cost_min") or 0) for e in day if x["branch"] in (e.get("branches") or []))
+        spent_global = sum(int(e.get("cost_min") or 0) for e in day)
+        cap_b, cap_g = int(REVIEW_COST_POLICY["branch_daily_minutes"]), int(REVIEW_COST_POLICY["global_daily_minutes"])
+        base.update(
+            spent_branch_min=spent_branch, spent_global_min=spent_global, branch_cap_min=cap_b, global_cap_min=cap_g
+        )
+        if (spent_branch + cost > cap_b or spent_global + total_cost + cost > cap_g) and not over_grant:
+            which = "branch" if spent_branch + cost > cap_b else "repository"
+            return _v2(
+                "BUDGET_EXCEEDED_COST",
+                False,
+                f"{which} CI budget: {x['branch']!r} would reach "
+                f"{spent_branch + cost}/{cap_b} min, repository {spent_global + total_cost + cost}/{cap_g} min "
+                "in 24 h. Fix locally, or ask the operator for a git-push grant whose reason says override "
+                "and push with TRADEAI_PUSH_REASON=operator:<grant id> TRADEAI_PUSH_CLASS=operator",
+                **base,
+            )
+        total_cost += cost
+    base["cost_min"] = total_cost
+    return _v2("REVIEW_OVERRIDE_GRANT" if over_grant else "REVIEW", True, "review push", **base)
+
+
+def hook_decide(
+    *,
+    push_refs: str,
+    policy_root: Path | str,
+    authorized: bool,
+    env_override: bool,
+    guard_ok: bool,
+    guard_reason: str | None,
+    guard_grant_id: str | None,
+    push_class: str | None,
+    reason: str | None,
+    release_train_id: str | None,
+    now: datetime | None = None,
+    claim_probe=claim_check,
+    ff_probe=fast_forward,
+    pr_probe=pr_lookup,
+) -> dict[str, Any]:
+    """The pre-push decision: v1 (`decide_push`) in legacy and shadow modes, v2 in enforce mode."""
+    mode, mode_why = read_policy_mode(policy_root)
+    legacy = decide_push(
+        pushed_branches(push_refs),
+        authorized=authorized,
+        env_override=env_override,
+        grant_reason=guard_reason if guard_ok else None,
+        now=now,
+    )
+    out: dict[str, Any] = {"mode": mode, "mode_why": mode_why, "legacy": legacy, "v2": None}
+    if mode == MODE_LEGACY:
+        out.update(allow=legacy["allow"], code=legacy["reason"], engine="v1")
+        return out
+    at = _now(now).timestamp()
+    refs = parse_push_refs(push_refs)
+    if not refs:
+        b = current_branch()
+        refs = [
+            {
+                "local_ref": "HEAD",
+                "local_sha": "",
+                "remote_ref": f"refs/heads/{b}",
+                "remote_sha": ZERO_SHA,
+                "branch": b,
+                "delete": False,
+            }
+        ]
+    try:
+        events = read_ledger(since_ts=at - DAY_S, strict=mode == MODE_ENFORCE)
+        v2 = decide_v2(
+            refs,
+            push_class=push_class,
+            reason=reason,
+            authorized=authorized,
+            env_override=env_override,
+            guard_ok=guard_ok,
+            guard_reason=guard_reason,
+            guard_grant_id=guard_grant_id,
+            release_train_id=release_train_id,
+            events=events,
+            now_ts=at,
+            claim_probe=claim_probe,
+            ff_probe=ff_probe,
+            pr_probe=pr_probe,
+        )
+    except Exception as exc:  # noqa: BLE001 - a v2 fault never changes a shadow outcome; enforce fails closed
+        v2 = _v2(
+            "V2_ERROR",
+            False,
+            f"{type(exc).__name__}: {str(exc)[:160]}",
+            **{
+                "class": push_class or DEFAULT_CLASS,
+                "notes": [],
+                "cost_min": 0,
+                "branches": [r["branch"] for r in refs],
+            },
+        )
+    out["v2"] = v2
+    if mode == MODE_SHADOW:
+        out.update(allow=legacy["allow"], code=legacy["reason"], engine="v1 (v2 shadow)")
+    else:
+        out.update(allow=v2["allow"], code=v2["code"], engine="v2")
+    return out
+
+
+def ledger_event(
+    decision: dict[str, Any], *, refs_text: str, stage: str, now: datetime | None = None, reason: str | None = None
+) -> dict[str, Any]:
+    """One hook decision; `pushed` reserves budget before upload, not proof of remote acceptance."""
+    v2 = decision.get("v2") or {}
+    at = _now(now)
+    refs = parse_push_refs(refs_text)
+    return {
+        "ts": at.timestamp(),
+        "at": at.replace(microsecond=0).isoformat(),
+        "stage": stage,
+        "mode": decision.get("mode"),
+        "engine": decision.get("engine"),
+        "effective_allow": bool(decision.get("allow")) and stage == "pushed",
+        "effective_code": decision.get("code"),
+        "legacy_code": (decision.get("legacy") or {}).get("reason"),
+        "v2_code": v2.get("code"),
+        "v2_allow": v2.get("allow"),
+        "v2_why": v2.get("why"),
+        "class": v2.get("class") or DEFAULT_CLASS,
+        "branches": v2.get("branches") or pushed_branches(refs_text),
+        "branch": (v2.get("branches") or pushed_branches(refs_text) or [""])[0],
+        "shas": {x["branch"]: x["local_sha"] for x in refs},
+        "cost_min": int(v2.get("cost_min") or 0) if decision.get("mode") == MODE_ENFORCE or v2.get("allow") else 0,
+        "pr_state": v2.get("pr_state"),
+        "claim_id": v2.get("claim_id"),
+        "reason": str(reason or "")[:240] or None,
+        "override_flag": os.environ.get("TRADEAI_REMOTE_PUSH_OVERRIDE") == "1",
+        "vendor": os.environ.get("AGENT_CLAIM_VENDOR") or None,
+        "session": os.environ.get("AGENT_CLAIM_SESSION") or None,
+    }
