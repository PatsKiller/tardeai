+def test_hook_concurrent_review_reservations_cannot_exceed_repository_cap(tmp_path):
+    src = _mini(tmp_path, policy=POLICY_ACTIVE)
+    _run(["git", "checkout", "-qb", "feat/x"], src, check=True)
+    cid = _claim(tmp_path, "feat/x")
+    env = _env(
+        src,
+        tmp_path,
+        TRADEAI_REMOTE_PUSH_AUTHORIZED="1",
+        TRADEAI_PUSH_CLASS="review",
+        TRADEAI_PUSH_REASON=f"claim:{cid}",
+    )
+    cost = int(B.REVIEW_COST_POLICY["est_minutes_per_push"])
+    cap = int(B.REVIEW_COST_POLICY["global_daily_minutes"])
+    import time
+
+    seed = {
+        "ts": time.time(),
+        "class": "review",
+        "effective_allow": True,
+        "cost_min": cap - cost,
+        "branches": ["feat/other"],
+        "branch": "feat/other",
+    }
+    ledger = src / ".git" / B.PUSH_LEDGER_NAME
+    ledger.write_text(json.dumps(seed) + "\n")
+    head = _run(["git", "rev-parse", "HEAD"], src, check=True).stdout.strip()
+    refs = f"refs/heads/feat/x {head} refs/heads/feat/x {ZERO}\n"
+    # Direct hook invocations exercise the real cross-process lock without remote traffic.
+    ps = [
+        subprocess.Popen(
+            ["bash", str(src / ".githooks/pre-push")],
+            cwd=src,
+            env=env,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for _ in range(5)
+    ]
+    outputs = [p.communicate(refs, timeout=120) for p in ps]
+    assert sum(p.returncode == 0 for p in ps) == 1, outputs
+    rows = _ledger(src)
+    accepted = [r for r in rows if r.get("effective_allow")]
+    assert sum(r["cost_min"] for r in accepted) == cap
+    rejected = [r for r in rows if r.get("stage") == "decided"]
+    assert len(rejected) == 4 and all(r["v2_code"] == "BUDGET_EXCEEDED_COST" for r in rejected)
+    assert all(not r["effective_allow"] for r in rejected)
+
