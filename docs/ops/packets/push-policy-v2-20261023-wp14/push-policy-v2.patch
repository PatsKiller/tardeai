+
+# ------------------------------------------------------------------------------------------------ hook_decide
+
+
+def test_shadow_mode_returns_the_v1_decision(tmp_path, monkeypatch):
+    monkeypatch.setenv("TRADEAI_PUSH_BUDGET_PATH", str(tmp_path / "budget.json"))
+    (tmp_path / "AI_WORK_POLICY.md").write_text(POLICY_PROPOSED)
+    (tmp_path / "AGENTS.md").write_text(AGENTS_20_ACTIVE)
+    refs = f"refs/heads/main {SHA_A} refs/heads/main {ZERO}\n"
+    d = B.hook_decide(
+        push_refs=refs,
+        policy_root=tmp_path,
+        authorized=True,
+        env_override=False,
+        guard_ok=False,
+        guard_reason=None,
+        guard_grant_id=None,
+        push_class=None,
+        reason=None,
+        release_train_id=None,
+        claim_probe=lambda c, b: (True, ""),
+        ff_probe=lambda r, l: True,
+        pr_probe=lambda b: {"state": "none", "number": None, "why": ""},
+    )
+    assert d["mode"] == B.MODE_SHADOW and d["allow"] is True and d["code"] == "AUTHORIZED"  # v1 allows main today
+    assert d["v2"]["code"] == "REFUSED_PROTECTED_REF"  # ... and v2 says what it would do
