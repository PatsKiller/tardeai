+    assert d["allow"] is False and d["code"] == "TRAIN_AUTHORITY_UNPROVEN"
+
+
+def test_operator_class_needs_the_grant_the_reason_names():
+    ok = decide(
+        [ref("main")],
+        push_class="operator",
+        reason="operator:0123abcd",
+        guard_ok=True,
+        guard_grant_id="0123abcd99887766",
+    )
+    assert ok["allow"] and ok["code"] == "OPERATOR"
+    assert not decide([ref("main")], push_class="operator", reason="operator:0123abcd")["allow"]
+    assert not decide(
+        [ref("main")],
+        push_class="operator",
+        reason="operator:ffffffff",
+        guard_ok=True,
+        guard_grant_id="0123abcd99887766",
+    )["allow"]
