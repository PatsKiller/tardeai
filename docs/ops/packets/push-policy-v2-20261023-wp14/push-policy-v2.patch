+def test_hook_shadow_is_v1_exactly_and_logs_every_decision(tmp_path):
+    src = _mini(tmp_path, policy=POLICY_PROPOSED)
+    _run(["git", "checkout", "-qb", "feat/x"], src, check=True)
+    env = _env(src, tmp_path, TRADEAI_REMOTE_PUSH_AUTHORIZED="1")
+    res = []
+    for n in range(1, 4):
+        _commit(src, n)
+        res.append(_run(["git", "push", "-q", "origin", "feat/x"], src, env))
+    assert [r.returncode == 0 for r in res] == [True, True, False]
+    assert "REMOTE PUSH BLOCKED (push budget)" in res[2].stderr
+    assert "push policy v2 (shadow, decides nothing)" in res[0].stdout
+    over = _run(["git", "push", "-q", "origin", "feat/x"], src, {**env, "TRADEAI_REMOTE_PUSH_OVERRIDE": "1"})
+    assert over.returncode == 0 and "TRADEAI_REMOTE_PUSH_OVERRIDE=1 is set" in over.stdout
+    led = _ledger(src)
+    assert [e["stage"] for e in led] == ["pushed", "pushed", "decided", "pushed"]
+    assert all(e["mode"] == "shadow" for e in led) and led[3]["override_flag"] is True
+    assert led[0]["v2_code"] == "REFUSED_REASON"  # no claim named: v2 would have refused
+
