+def test_hook_enforce_wip_is_outside_the_v1_count_and_rate_limited(tmp_path):
+    src = _mini(tmp_path, policy=POLICY_ACTIVE)
+    _run(["git", "checkout", "-qb", "feat/x"], src, check=True)
+    cid = _claim(tmp_path, "feat/x")
+    env = _env(
+        src, tmp_path, TRADEAI_REMOTE_PUSH_AUTHORIZED="1", TRADEAI_PUSH_CLASS="wip", TRADEAI_PUSH_REASON=f"claim:{cid}"
+    )
+    env = _draft_gh_fixture(tmp_path, env)
+    _commit(src, 1)
+    first = _run(["git", "push", "-q", "origin", "feat/x"], src, env)
+    assert first.returncode == 0, first.stderr
+    _commit(src, 2)
+    second = _run(["git", "push", "-q", "origin", "feat/x"], src, env)
+    assert second.returncode != 0 and "push policy v2: RATE_LIMITED" in second.stderr
+    # the v1 counter is untouched by a wip push
+    state = src / ".git/tradeai-push-budget.v2.json"
+    assert not state.exists() or "feat/x" not in state.read_text()
+    led = _ledger(src)
+    assert [(e["stage"], e["v2_code"]) for e in led] == [("pushed", "WIP"), ("decided", "RATE_LIMITED")]
+    assert led[0]["claim_id"] == cid and led[0]["class"] == "wip"
