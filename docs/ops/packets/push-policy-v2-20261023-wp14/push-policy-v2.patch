+++ b/tests/test_push_policy_v2_20261023.py
@@ -0,0 +1,729 @@
+"""Push policy v2 (2026-10-23, AI_WORK_POLICY.md §29): push classes, claim-typed reasons, CI-minute budget.
+
+Pins:
+  * mode: no marker -> legacy (v1 exactly); PROPOSED -> shadow (v1 decides, v2 logged); ACTIVE needs AGENTS.md
+    >= 20.0.0 ACTIVE as well, else it stays shadow; WITHDRAWN -> legacy;
+  * v2 classes: wip (claim, fast-forward, proven draft PR, 15-min rate limit, daily cap), review (claim, runner-minute
+    budget per branch and per repository), train (its one ref), operator (a grant the reason names);
+  * main / train/* / tags / deletes are refused to agents; TRADEAI_REMOTE_PUSH_OVERRIDE lifts nothing under v2;
+  * the hook: shadow behaves exactly as v1 and writes a ledger line per decision; enforce counts wip pushes outside
+    the v1 counter, refuses a second wip push inside 15 minutes, refuses main and an untyped reason; the policy is
+    read from the hook's own checkout, not from the pushed branch.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import stat
+import subprocess
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from scripts.lib import tradeai_push_budget as B  # noqa: E402
+
+PRE_PUSH = ROOT / ".githooks" / "pre-push"
+SHA_A, SHA_B, ZERO = "a" * 40, "b" * 40, "0" * 40
+NOW = 1_800_000_000.0
+AGENTS_20_ACTIVE = "Policy-Version:      20.0.0\nStatus:              ACTIVE\n"
+AGENTS_19_ACTIVE = "Policy-Version:      19.0.0\nStatus:              ACTIVE\n"
+POLICY_PROPOSED = "# 29. PUSH CLASSES\n\nPush-Policy-v2: PROPOSED\n"
+POLICY_ACTIVE = "# 29. PUSH CLASSES\n\nPush-Policy-v2: ACTIVE\n"
+CLAIM = "20261023T134307Z-claude-7ebccee4"
+
+
+def ref(branch: str, local: str = SHA_A, remote: str = ZERO) -> dict:
+    return {
+        "local_ref": f"refs/heads/{branch}",
+        "local_sha": local,
+        "remote_ref": f"refs/heads/{branch}",
+        "remote_sha": remote,
+        "branch": branch,
+        "delete": local == ZERO,
+    }
+
+
+def decide(refs, **kw):
+    args = dict(
+        push_class="wip",
+        reason=f"claim:{CLAIM}",
+        authorized=True,
+        env_override=False,
+        guard_ok=False,
+        guard_reason=None,
+        guard_grant_id=None,
+        release_train_id=None,
+        events=[],
+        now_ts=NOW,
+        claim_probe=lambda cid, br: (True, "live"),
+        ff_probe=lambda r, l: True,
+        pr_probe=lambda br: {"state": "draft", "number": 7, "why": "t"},
+    )
+    args.update(kw)
+    return B.decide_v2(refs, **args)
+
+
+# ------------------------------------------------------------------------------------------------ mode
+
+
+@pytest.mark.parametrize(
+    "policy, agents, mode",
+    [
+        (None, AGENTS_20_ACTIVE, B.MODE_LEGACY),
+        ("# policy without the line\n", AGENTS_20_ACTIVE, B.MODE_LEGACY),
+        (POLICY_PROPOSED, AGENTS_20_ACTIVE, B.MODE_SHADOW),
+        (POLICY_ACTIVE, AGENTS_19_ACTIVE, B.MODE_SHADOW),
+        (POLICY_ACTIVE, "Policy-Version:      20.0.0\nStatus:              PROPOSED\n", B.MODE_SHADOW),
+        (POLICY_ACTIVE, None, B.MODE_SHADOW),
+        (POLICY_ACTIVE, AGENTS_20_ACTIVE, B.MODE_ENFORCE),
+        (POLICY_ACTIVE, "Policy-Version:      21.3.1\nStatus:              ACTIVE\n", B.MODE_ENFORCE),
+        ("Push-Policy-v2: WITHDRAWN\n", AGENTS_20_ACTIVE, B.MODE_LEGACY),
+    ],
+)
+def test_policy_mode(policy, agents, mode):
+    assert B.policy_mode(policy, agents)[0] == mode
+
+
+def test_shipped_policy_marker_selects_its_explicit_rollout_mode():
+    policy = (ROOT / "AI_WORK_POLICY.md").read_text()
+    marker = B.policy_marker(policy)
+    assert marker in ("PROPOSED", "ACTIVE", "WITHDRAWN")
+    mode, _ = B.policy_mode(policy, AGENTS_20_ACTIVE)
+    assert mode == {"PROPOSED": B.MODE_SHADOW, "ACTIVE": B.MODE_ENFORCE, "WITHDRAWN": B.MODE_LEGACY}[marker]
+
+
+def test_reason_grammar():
+    assert B.parse_reason(f"claim:{CLAIM}") == {"kind": "claim", "id": CLAIM, "note": ""}
+    assert B.parse_reason(f"claim:{CLAIM} hourly checkpoint")["note"] == "hourly checkpoint"
+    assert B.parse_reason("operator:abcdef12")["kind"] == "operator"
+    for bad in (None, "", "override", "push it", "claim:", "claim:x", "CLAIM:abcd1234", "claim abcd1234"):
+        assert B.parse_reason(bad) is None, bad
+
+
+@pytest.mark.parametrize(
+    "branch, protected",
+    [
+        ("main", True),
+        ("master", True),
+        ("train/train-20261023-1800", True),
+        ("refs/tags/v1", True),
+        ("feat/x", False),
+        ("release/batch-8", False),
+        ("mainline/x", False),
+    ],
+)
+def test_protected_refs(branch, protected):
+    assert B.is_protected(branch) is protected
+
+
+# ------------------------------------------------------------------------------------------------ wip
+
+
+def test_wip_with_a_live_claim_on_a_draft_is_allowed_and_cheap():
+    d = decide([ref("feat/x")])
+    assert d["allow"] and d["code"] == "WIP" and d["cost_min"] == B.WIP_COST_MIN
+
+
+def test_wip_needs_a_typed_claim_reason():
+    for reason in (None, "override", "hourly checkpoint", "operator:abcdef12"):
+        d = decide([ref("feat/x")], reason=reason)
+        assert not d["allow"] and d["code"] == "REFUSED_REASON", reason
+
+
+def test_wip_claim_must_be_live_and_for_this_branch():
+    d = decide([ref("feat/x")], claim_probe=lambda cid, br: (False, f"claim {cid} is for branch 'feat/y'"))
+    assert not d["allow"] and d["code"] == "REFUSED_CLAIM" and "feat/y" in d["why"]
+
+
+def test_wip_is_rate_limited_per_branch():
+    ev = {"class": "wip", "branch": "feat/x", "effective_allow": True, "ts": NOW - 300}
+    d = decide([ref("feat/x")], events=[ev])
+    assert not d["allow"] and d["code"] == "RATE_LIMITED" and "600 s" in d["why"]
+    assert decide([ref("feat/y")], events=[ev])["allow"]  # another branch is not limited
+    assert decide([ref("feat/x")], events=[{**ev, "ts": NOW - B.WIP_MIN_INTERVAL_S}])["allow"]
+    assert decide([ref("feat/x")], events=[{**ev, "effective_allow": False}])["allow"]  # a refusal is not a push
+
+
+def test_wip_daily_cap():
+    evs = [
+        {"class": "wip", "branch": "feat/x", "effective_allow": True, "ts": NOW - 1000 - i * 1000}
+        for i in range(B.WIP_DAILY_MAX)
+    ]
+    d = decide([ref("feat/x")], events=evs)
+    assert not d["allow"] and d["code"] == "WIP_DAILY_CAP"
+
+
+def test_wip_never_rewrites_and_must_prove_fast_forward():
+    assert decide([ref("feat/x", remote=SHA_B)], ff_probe=lambda r, l: False)["code"] == "REFUSED_REWRITE"
+    assert decide([ref("feat/x", remote=SHA_B)], ff_probe=lambda r, l: None)["code"] == "REFUSED_FF_UNKNOWN"
+
+
+def test_wip_on_a_ready_pr_is_refused_as_a_review_push():
+    d = decide([ref("feat/x")], pr_probe=lambda br: {"state": "ready", "number": 1990, "why": "t"})
+    assert not d["allow"] and d["code"] == "REFUSED_READY_PR" and "#1990" in d["why"]
+
+
+@pytest.mark.parametrize("state,why", [("unknown", "gh offline"), ("unknown", "API failure"), ("none", "no PR")])
+def test_wip_requires_proven_draft_and_refuses_unknown_or_absent_pr(state, why):
+    d = decide([ref("feat/x")], pr_probe=lambda br: {"state": state, "number": None, "why": why})
+    assert not d["allow"] and d["code"] == "REFUSED_DRAFT_UNPROVEN"
+
+
+# ------------------------------------------------------------------------------------------------ protected, delete
+
+
+@pytest.mark.parametrize("cls", ["wip", "review"])
+@pytest.mark.parametrize("branch", ["main", "train/train-20261023-1800", "refs/tags/v9"])
+def test_agents_never_push_main_or_train(cls, branch):
+    d = decide([ref(branch)], push_class=cls)
+    assert not d["allow"] and d["code"] == "REFUSED_PROTECTED_REF"
+
+
+def test_deleting_a_remote_branch_is_operator_only():
+    assert decide([ref("feat/x", local=ZERO, remote=SHA_A)])["code"] == "REFUSED_DELETE"
+
+
+def test_unauthorized_is_refused_before_any_probe():
+    def boom(*a):
+        raise AssertionError("probe called")
+
+    d = decide([ref("feat/x")], authorized=False, claim_probe=boom, ff_probe=boom, pr_probe=boom)
+    assert d["code"] == "UNAUTHORIZED"
+
+
+def test_unknown_class_is_refused():
+    assert decide([ref("feat/x")], push_class="yolo")["code"] == "REFUSED_CLASS"
+
+
+# ------------------------------------------------------------------------------------------------ review
+
+
+def _review(**kw):
+    kw.setdefault("pr_probe", lambda br: {"state": "ready", "number": 9, "why": "t"})
+    return decide([ref("feat/x")], push_class="review", **kw)
+
+
+def test_review_push_costs_the_full_fleet_estimate():
+    d = _review()
+    assert d["allow"] and d["code"] == "REVIEW" and d["cost_min"] == B.REVIEW_COST_POLICY["est_minutes_per_push"]
+
+
+def test_review_on_a_draft_costs_the_quick_check_and_says_so():
+    d = _review(pr_probe=lambda br: {"state": "draft", "number": 9, "why": "t"})
+    assert d["allow"] and d["cost_min"] == B.WIP_COST_MIN and any("class wip" in n for n in d["notes"])
+
+
+def _spent(branch, minutes, cls="review"):
+    return {
+        "class": cls,
+        "branch": branch,
+        "branches": [branch],
+        "effective_allow": True,
+        "ts": NOW - 3600,
+        "cost_min": minutes,
+    }
+
+
+def test_review_branch_budget_in_runner_minutes():
+    cap = B.REVIEW_COST_POLICY["branch_daily_minutes"]
+    est = B.REVIEW_COST_POLICY["est_minutes_per_push"]
+    assert _review(events=[_spent("feat/x", cap - est)])["allow"]
+    d = _review(events=[_spent("feat/x", cap - est + 1)])
+    assert not d["allow"] and d["code"] == "BUDGET_EXCEEDED_COST" and "branch CI budget" in d["why"]
+    old = {**_spent("feat/x", cap), "ts": NOW - B.DAY_S - 1}
+    assert _review(events=[old])["allow"]  # rolling 24 h
+
+
+def test_review_global_budget_in_runner_minutes():
+    cap = B.REVIEW_COST_POLICY["global_daily_minutes"]
+    d = _review(events=[_spent(f"feat/o{i}", cap // 10) for i in range(10)])
+    assert not d["allow"] and d["code"] == "BUDGET_EXCEEDED_COST" and "repository CI budget" in d["why"]
+
+
+def test_env_override_lifts_nothing_under_v2_but_an_operator_override_grant_does():
+    spent = [_spent("feat/x", B.REVIEW_COST_POLICY["branch_daily_minutes"])]
+    d = _review(events=spent, env_override=True)
+    assert not d["allow"] and any("retired" in n for n in d["notes"])
+    g = _review(events=spent, guard_ok=True, guard_reason="override: CI flake on #1990, operator 10-23")
+    assert g["allow"] and g["code"] == "REVIEW_OVERRIDE_GRANT"
+    assert not _review(events=spent, guard_ok=True, guard_reason="push feat/x")["allow"]
+
+
+# ------------------------------------------------------------------------------------------------ train, operator
+
+
+def test_train_class_pushes_only_its_own_ref():
+    tid = "train-20261023-1800"
+    ok = decide(
+        [ref(f"train/{tid}")], push_class="train", reason=f"train:{tid}", release_train_id=tid, authorized=False
+    )
+    assert not ok["allow"] and ok["code"] == "TRAIN_AUTHORITY_UNPROVEN"
+    for refs, rid, reason in (
+        ([ref("main")], tid, f"train:{tid}"),
+        ([ref(f"train/{tid}"), ref("main")], tid, f"train:{tid}"),
+        ([ref("train/train-20261023-0000")], tid, f"train:{tid}"),
+        ([ref(f"train/{tid}")], tid, "train:train-20261023-0000"),
+        ([ref(f"train/{tid}")], "nope", "train:nope"),
+    ):
+        assert not decide(refs, push_class="train", reason=reason, release_train_id=rid)["allow"], refs
+
+
+@pytest.mark.parametrize("authorized", [False, True])
+@pytest.mark.parametrize("guard_ok", [False, True])
+def test_train_env_and_guard_override_never_prove_service_authority(authorized, guard_ok):
+    tid = "train-20261023-1800"
+    d = decide(
+        [ref(f"train/{tid}")],
+        push_class="train",
+        reason=f"train:{tid}",
