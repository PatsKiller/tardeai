      "id": "fda071ab-9621-5b3e-b5fe-a830f4283291",
      "name": "Validate due",
      "parameters": {
        "jsCode": "// Generated by scripts/build_cio_ask_lifecycle_workflow.py; the relay, not this workflow, chooses slot and mode.\nconst lane = $('Relay').first().json.lane_id;\nif (![\"cio-ask-lifecycle\", \"cio-ask-material-events\"].includes(lane)) throw new Error('due: unknown lane');\nconst r = $input.first().json || {};\nif (r.statusCode !== 200 || r.error) throw new Error('due: relay unavailable or refused');\nconst due = r.body;\nif (!due || due.schema !== \"DueResponse@v1\" || due.ok !== true || due.source !== 'schedule') {\n  throw new Error('due: invalid response');\n}\nif (!Array.isArray(due.items) || due.items.length > 1) throw new Error('due: invalid item count');\nreturn due.items.map(it => {\n  if (!it || it.lane_id !== lane || !['dry_run', 'live'].includes(it.mode)) throw new Error('due: wrong lane/mode');\n  const prefix = 'd:' + lane + ':' + it.mode + ':';\n  const key = it.idempotency_key;\n  if (typeof key !== 'string' || !key.startsWith(prefix) || !/^[0-9]{8}T[0-9]{4}(:a[2-9])?$/.test(key.slice(prefix.length))) {\n    throw new Error('due: not a bound server schedule key');\n  }\n  return { json: { lane_id: lane, mode: it.mode, idempotency_key: key,\n    max_attempts: 1, outcome_timeout_s: 720, process_id: \"tradeai-cio-ask-lifecycle-native\" } };\n});\n",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
