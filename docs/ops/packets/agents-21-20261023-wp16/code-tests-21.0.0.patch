+    assert s["suggested_notional_usd"] == "12500.00" and s["risk_at_stop_reference_usd"] == "1000.00"
+
+
+def test_sector_cap_binds_and_never_goes_negative(tmp_path):
+    root = _policy(tmp_path, ROW_21_ACTIVE)
+    s = SZ.advisory_size_suggestion(
+        policy_root=root, **dict(BASE_KW, max_position_pct="0.30", sector_exposure_usd=24_000)
+    )
+    assert s["caps"]["by_sector_limit"] == 4 and s["suggested_share_count"] == 4
+    assert s["binding_constraint"] == "sector_limit"
+    s = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, sector_exposure_usd=40_000))
+    assert s["suggested_share_count"] == 0 and s["caps"]["by_sector_limit"] == 0
+    s = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, existing_position_usd=12_000))
+    assert s["caps"]["by_position_limit"] == 0 and s["suggested_share_count"] == 0
+
+
+def test_deterministic_and_fully_shown(tmp_path):
+    root = _policy(tmp_path, ROW_21_ACTIVE)
+    a = SZ.advisory_size_suggestion(policy_root=root, **BASE_KW)
+    b = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, portfolio_value="100000.0"))
+    assert json.dumps(a, sort_keys=True) == json.dumps(
+        SZ.advisory_size_suggestion(policy_root=root, **BASE_KW), sort_keys=True
+    )
+    assert a["suggested_share_count"] == b["suggested_share_count"]
+    assert a["label"] == "ADVISORY" and a["not_actionable"] is True and a["source"] == "deterministic"
+    assert a["formula"] == SZ.FORMULA and a["as_of"] == BASE_KW["as_of"] and a["policy"] == "AGENTS.md 21.0.0 §29"
+    assert set(a["inputs"]) == {
+        "portfolio_value_usd",
+        "risk_budget_pct",
+        "reference_price",
+        "stop_reference_price",
+        "max_position_pct",
+        "max_sector_pct",
+        "existing_position_usd",
+        "sector_exposure_usd",
+    }
+    assert a["inputs"]["risk_budget_pct"] == "0.01"
+    assert "ADVISORY, not an order" in a["reasoning"] and "position limit binds" in a["reasoning"]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {"portfolio_value": None},
+        {"portfolio_value": 0},
+        {"reference_price": "x"},
+        {"stop_reference_price": 250},
+        {"stop_reference_price": 260},
+        {"stop_reference_price": 0},
+        {"risk_budget_pct": "0.06"},
+        {"risk_budget_pct": 0},
+        {"max_position_pct": None},
+        {"max_sector_pct": "1.5"},
+        {"sector_exposure_usd": None},
+        {"sector_exposure_usd": -1},
+        {"existing_position_usd": -5},
+        {"existing_position_usd": None},
+        {"as_of": ""},
+        {"symbol": ""},
+        {"portfolio_value": float("nan")},
+        {"reference_price": True},
+    ],
+)
+def test_missing_or_invalid_inputs_give_no_suggestion(tmp_path, bad):
+    root = _policy(tmp_path, ROW_21_ACTIVE)
+    assert SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, **bad)) is None
+
+
+def test_suggestion_carries_no_behaviour_field(tmp_path):
+    s = SZ.advisory_size_suggestion(policy_root=_policy(tmp_path, ROW_21_ACTIVE), **BASE_KW)
+    assert not [k for k in CIR._walk_keys(s) if k in CIR.BEHAVIOR_FIELDS]
+    assert SZ.BEHAVIOR_FIELDS == CIR.BEHAVIOR_FIELDS
+
+
+def test_model_quantities_are_stripped_and_recorded(tmp_path):
+    s = SZ.advisory_size_suggestion(policy_root=_policy(tmp_path, ROW_21_ACTIVE), **BASE_KW)
+    model = {
+        "answer": "text",
+        "size_suggestion": {"shares": 1000},
+        "options": [{"symbol": "TSLA", "qty": 100, "note": "n"}],
+        "plan": {"stop": 1, "order": {"x": 1}},
+    }
+    out = SZ.attach_size_suggestion(model, s)
+    assert out["size_suggestion"] == s and out["answer"] == "text"
+    assert sorted(out["stripped_model_quantities"]) == ["options[0].qty", "plan.order", "plan.stop", "size_suggestion"]
+    assert out["options"] == [{"symbol": "TSLA", "note": "n"}] and out["plan"] == {}
+    assert model["size_suggestion"] == {"shares": 1000}, "the model's dict is not mutated"
+    none = SZ.attach_size_suggestion({"size_suggestion": {"shares": 5}}, None)
+    assert none["size_suggestion"] is None and none["stripped_model_quantities"] == ["size_suggestion"]
+
+
+def test_module_imports_only_the_standard_library():
+    tree = ast.parse((ROOT / MODULE).read_text(encoding="utf-8"))
+    mods = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            mods.update(a.name.split(".")[0] for a in node.names)
+        elif isinstance(node, ast.ImportFrom):
+            assert node.level == 0, "no relative imports"
+            mods.add(node.module.split(".")[0])
+    assert mods <= {"__future__", "re", "decimal", "pathlib", "typing"}, mods
+
+
+def test_import_closure_holds_no_broker_order_stop_or_proposal_module():
+    code = (
+        "import sys; before = set(sys.modules); sys.path.insert(0, sys.argv[1]); "
+        "import scripts.lib.cio_advisory_sizing; print('\\n'.join(sorted(set(sys.modules) - before)))"
+    )
+    out = subprocess.run([sys.executable, "-I", "-c", code, str(ROOT)], capture_output=True, text=True, check=True)
+    new = [m for m in out.stdout.split() if m]
+    assert "scripts.lib.cio_advisory_sizing" in new
+    assert not [m for m in new if BROKERISH.search(m)], new
+    assert not [
+        m
+        for m in new
+        if m.startswith("scripts.") and m not in ("scripts", "scripts.lib", "scripts.lib.cio_advisory_sizing")
+    ], new
+
+
+def test_only_the_ask_contract_imports_the_module():
+    skip = {".git", ".venv", "venv", "node_modules", "tests", "__pycache__", ".cache"}
+    importers = []
+    for p in ROOT.rglob("*.py"):
+        rel = p.relative_to(ROOT)
+        if skip & set(rel.parts[:-1]) or rel.as_posix() == MODULE:
+            continue
+        try:
+            tree = ast.parse(p.read_text(encoding="utf-8", errors="ignore"))
+        except (OSError, SyntaxError):
+            continue
+        names = []
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                names.extend(a.name for a in node.names)
+            elif isinstance(node, ast.ImportFrom):
+                names.append(node.module or "")
+                names.extend((node.module or "") + "." + a.name for a in node.names)
+        if any(name.rsplit(".", 1)[-1] == "cio_advisory_sizing" for name in names):
+            importers.append(rel.as_posix())
+    assert set(importers) <= set(SZ.ALLOWED_IMPORTERS), importers
+
+
+@pytest.mark.parametrize("field", CIR.BEHAVIOR_FIELDS)
+def test_behaviour_rail_still_raises_for_every_behaviour_field(field):
+    with pytest.raises(CIR.BehaviorWriteRefused):
+        CIR.apply_cognition({}, next_research_question="q", **{field: 1})
+
+
+def test_behaviour_rail_is_unconditional():
+    assert CIR.BEHAVIOR_FIELDS == (
+        "recommended_delta_usd",
+        "size_usd",
+        "shares",
+        "qty",
+        "order",
+        "stop",
+        "limit",
+        "target_weight_pct",
+        "trade",
+        "execution",
+    )
+    src = inspect.getsource(CIR.apply_cognition)
+    body = src[src.index('"""', src.index('"""') + 3) + 3 :]
+    assert body.lstrip().startswith("if forbidden:"), "the rail must be the first statement"
+    assert "raise BehaviorWriteRefused(" in body.split("rec = dict(record)")[0]
+    assert "environ" not in body and "getenv" not in body
+
