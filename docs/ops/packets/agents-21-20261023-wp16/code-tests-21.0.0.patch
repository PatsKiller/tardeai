+def _flat(text: str) -> str:
+    return re.sub(r"\s+", " ", text)
+
+
+def _section(text: str, name: str) -> str:
+    start, end = BOUNDS[name]
+    s = re.search(rf"^{re.escape(start)}", text, re.M)
+    assert s, start
+    e = re.search(rf"^{re.escape(end)}", text[s.start() + 1 :], re.M)
+    assert e, end
+    block = text[s.start() : s.start() + 1 + e.start()]
+    return re.sub(
+        r"(<!-- SOURCE_OF_TRUTH_TABLE_START -->).*?(<!-- SOURCE_OF_TRUTH_TABLE_END -->)",
+        r"\1\n<generated>\n\2",
+        block,
+        flags=re.S,
+    )
+
+
+def _sub(text: str, num: str) -> str:
+    m = re.search(rf"^## {re.escape(num)} .*?(?=^## |^---$|^# |\Z)", text, re.M | re.S)
+    assert m, f"§{num} missing"
+    return m.group(0).rstrip("\n").rstrip("-").rstrip("\n")
+
+
+def _row() -> re.Match:
+    m = re.search(r"^\| 21\.0\.0 \| 2026-10-23 \| (PROPOSED|ACTIVE)[^|]* \| MAJOR \|(.*)$", AGENTS, re.M)
+    assert m, "no `| 21.0.0 | 2026-10-23 | PROPOSED|ACTIVE | MAJOR |` row: the 21.0.0 patch is not applied"
+    return m
+
+
+def _ratified() -> bool:
+    return _row().group(1) == "ACTIVE"
+
+
+def _s29() -> str:
+    m = re.search(r"^# 29 · Advisory size suggestions.*?(?=^# 30 · |^# Version history)", AGENTS, re.M | re.S)
+    assert m, "§29 missing: the 21.0.0 patch is not applied"
+    return m.group(0)
