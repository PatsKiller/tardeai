+def redo_21_0_0(text: str) -> str:
+    """The three clause edits applied (what the ratifying edit does to the body)."""
+    for old, new in EDITS:
+        assert text.count(old) == 1, old[:80]
+        text = text.replace(old, new, 1)
+    return text
+
+
+def undo_21_0_0(text: str) -> str:
+    """The text with the three 21.0.0 ratifying clause edits reversed (each must be present exactly once)."""
+    for old, new in reversed(EDITS):
+        assert text.count(new) == 1, new[:80]
+        text = text.replace(new, old, 1)
+    return text
+
+
+def pre_21_0_0(text: str) -> str:
+    """For the older policy tests' pins: the AGENTS.md text as it was before the 21.0.0 ratifying edit. Unchanged
+    while 21.0.0 is PROPOSED; once the 21.0.0 row is ACTIVE, the three clause edits are undone."""
+    if re.search(r"^\| 21\.0\.0 \| 2026-10-23 \| ACTIVE", text, re.M):
+        return undo_21_0_0(text)
+    return text
+
