+    (R1_ANCHOR + "2. **Broker code", R1_ANCHOR + R1_INS + "2. **Broker code"),
+    (R2_ANCHOR, R2_ANCHOR + R2_INS),
+    (R3_ANCHOR, R3_ANCHOR + R3_INS),
+)
