+def test_section_29_7_quotes_every_clause_verbatim():
+    s297 = _sub(_s29(), "29.7")
+    for key, digest in CLAUSE_SHA256.items():
+        clause = globals()[key]
+        assert h(clause) == digest, f"{key} digest"
+        if key.endswith("_ANCHOR"):
+            continue
+        body = clause.lstrip("\n") if key == "R3_INS" else clause
+        assert _quoted(body) in s297, f"{key} is not quoted verbatim in §29.7"
