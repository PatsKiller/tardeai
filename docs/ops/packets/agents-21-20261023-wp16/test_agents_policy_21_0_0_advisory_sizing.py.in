"""AGENTS.md 21.0.0 (PROPOSED, MAJOR) — §29 advisory size suggestions from the CIO.

Shipped as an OPERATOR-COMMITTED package (operator, 2026-10-23: "It can suggest sizes, or I can say sizes." and
option "B"; agents do not edit AGENTS.md or its pinning tests). Built on the 20.1.0-ACTIVE AGENTS.md.

What this pins:
  * one 21.0.0 history row, PROPOSED with PENDING and the §20 phrase until ratified; while PROPOSED the header block
    reads 21.0.0 PROPOSED, `Effective-Date` PENDING, `Supersedes` 20.1.0; the state checker passes;
  * the banner states the class and why, what does not change, the byte-identical list and the phrase;
  * §29 states every rule, and every §29 bullet cites its cause;
  * §2, §2A, §7, §7A, §13, §22, §23, §24 and §27 are byte-identical to 20.0.0;
  * §0, §17, §26 and the four adapters are byte-identical while PROPOSED; once ratified they differ by exactly the
    three clause edits §29.7 quotes, whose sha256 and post-ratification digests are pinned here;
  * `scripts/lib/cio_advisory_sizing.py`: inert below 21.0.0 ACTIVE, deterministic math with the position and sector
    caps, no `BEHAVIOR_FIELDS` key in its output, model quantities stripped and recorded, an import closure with no
    broker, order, stop or proposal module, and only `scripts/lib/cio_ask_contract.py` may import it;
  * the behaviour rail is unchanged: every `BEHAVIOR_FIELDS` write through `apply_cognition()` still raises;
  * `pre_21_0_0()` gives the older policy tests the text as it was before the 21.0.0 ratifying edit.

Read-only: reads repository files; writes AGENTS.md fixtures under pytest's tmp_path only. TRADE_AI_CI=1.
"""

from __future__ import annotations

import ast
import hashlib
import inspect
import json
import re
import subprocess
import sys
from decimal import Decimal
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[1]
for _p in (str(ROOT), str(ROOT / "scripts")):
    if _p not in sys.path:
        sys.path.insert(0, _p)

from scripts import check_agents_policy_state as STATE  # noqa: E402

AGENTS = (ROOT / "AGENTS.md").read_text(encoding="utf-8")
TOKEN = "APPROVE_AGENTS_POLICY_21_0_0"
ADAPTERS = ("CLAUDE.md", ".cursor/rules/00-tradeai-work-policy.mdc", ".github/copilot-instructions.md", ".goosehints")
MODULE = "scripts/lib/cio_advisory_sizing.py"


def h(t: str) -> str:
    return hashlib.sha256(t.encode("utf-8")).hexdigest()


# The three clause edits of the ratifying edit, byte for byte as build_ratify21.py makes them and §29.7 quotes them.
@CLAUSES@

CLAUSE_SHA256 = @CLAUSE_SHA@

# Section digests on the 20.0.0-ACTIVE base; while PROPOSED, and after the clause edits are undone, they are equal.
SECTION_SHA256 = @PRE@
# Post-ratification digests, pinned in advance (the clause edits carry no PR, SHA or date).
SECTION_RATIFIED_SHA256 = @POST@
ADAPTER_SHA256 = @ADAPTERS_PRE@
ADAPTER_RATIFIED_SHA256 = @ADAPTERS_POST@

BOUNDS = {
    "§0": ("# 0 · If you read nothing else", "# 1 · Identity and responsibilities"),
    "§2": ("# 2 · Authority rails", "# 2A ·"), "§2A": ("# 2A ·", "# 2B ·"),
    "§7": ("# 7 · ", "# 7A ·"), "§7A": ("# 7A ·", "# 8 ·"), "§13": ("# 13 · ", "# 14 · "),
    "§17": ("# 17 · Operator-only decisions", "# 17A ·"), "§22": ("# 22 · ", "# 23 · "),
    "§23": ("# 23 · ", "# 24 · "), "§24": ("# 24 · ", "# 25 · "), "§26": ("# 26 · ", "# 27 · "),
    "§27": ("# 27 · ", "# 28 · "),
}
CHANGING = ("§0", "§17", "§26")
FIXED = ("§2", "§2A", "§7", "§7A", "§13", "§22", "§23", "§24", "§27")


def _flat(text: str) -> str:
    return re.sub(r"\s+", " ", text)


def _section(text: str, name: str) -> str:
    start, end = BOUNDS[name]
    s = re.search(rf"^{re.escape(start)}", text, re.M)
    assert s, start
    e = re.search(rf"^{re.escape(end)}", text[s.start() + 1:], re.M)
    assert e, end
    block = text[s.start(): s.start() + 1 + e.start()]
    return re.sub(r"(<!-- SOURCE_OF_TRUTH_TABLE_START -->).*?(<!-- SOURCE_OF_TRUTH_TABLE_END -->)",
                  r"\1\n<generated>\n\2", block, flags=re.S)


def _sub(text: str, num: str) -> str:
    m = re.search(rf"^## {re.escape(num)} .*?(?=^## |^---$|^# |\Z)", text, re.M | re.S)
    assert m, f"§{num} missing"
    return m.group(0).rstrip("\n").rstrip("-").rstrip("\n")


def _row() -> re.Match:
    m = re.search(r"^\| 21\.0\.0 \| 2026-10-23 \| (PROPOSED|ACTIVE)[^|]* \| MAJOR \|(.*)$", AGENTS, re.M)
    assert m, "no `| 21.0.0 | 2026-10-23 | PROPOSED|ACTIVE | MAJOR |` row: the 21.0.0 patch is not applied"
    return m


def _ratified() -> bool:
    return _row().group(1) == "ACTIVE"


def _s29() -> str:
    m = re.search(r"^# 29 · Advisory size suggestions.*?(?=^# 30 · |^# Version history)", AGENTS, re.M | re.S)
    assert m, "§29 missing: the 21.0.0 patch is not applied"
    return m.group(0)


# Each edit as (text before the ratifying edit, text after it), in the order the ratifying edit applies them.
EDITS = (
    (R1_ANCHOR + "2. **Broker code", R1_ANCHOR + R1_INS + "2. **Broker code"),
    (R2_ANCHOR, R2_ANCHOR + R2_INS),
    (R3_ANCHOR, R3_ANCHOR + R3_INS),
)


def redo_21_0_0(text: str) -> str:
    """The three clause edits applied (what the ratifying edit does to the body)."""
    for old, new in EDITS:
        assert text.count(old) == 1, old[:80]
        text = text.replace(old, new, 1)
    return text


def undo_21_0_0(text: str) -> str:
    """The text with the three 21.0.0 ratifying clause edits reversed (each must be present exactly once)."""
    for old, new in reversed(EDITS):
        assert text.count(new) == 1, new[:80]
        text = text.replace(new, old, 1)
    return text


def pre_21_0_0(text: str) -> str:
    """For the older policy tests' pins: the AGENTS.md text as it was before the 21.0.0 ratifying edit. Unchanged
    while 21.0.0 is PROPOSED; once the 21.0.0 row is ACTIVE, the three clause edits are undone."""
    if re.search(r"^\| 21\.0\.0 \| 2026-10-23 \| ACTIVE", text, re.M):
        return undo_21_0_0(text)
    return text


def pre_21_0_0_adapter(text: str) -> str:
    """An adapter as it was before the 21.0.0 ratifying edit (the §0 rule 1 sentence removed when present)."""
    return text.replace(R1_ANCHOR + R1_INS, R1_ANCHOR, 1)


# ------------------------------------------------------------------------------------- header, row, banner


def test_one_row_and_state_checker_passes():
    _row()
    assert len(re.findall(r"^\| 21\.0\.0 \|", AGENTS, re.M)) == 1
    assert STATE.check(AGENTS, on_main=False) == []
    assert STATE.check(AGENTS, on_main=True) == []


def test_row_waits_for_the_operator_or_records_the_token():
    status, rest = _row().group(1), _row().group(2)
    if status == "PROPOSED":
        assert "PENDING" in rest and f"{TOKEN} <pr_number> <head_sha>" in rest
        assert re.search(r"^Policy-Version:\s+21\.0\.0$", AGENTS, re.M)
        assert re.search(r"^Status:\s+PROPOSED$", AGENTS, re.M) and re.search(r"^Effective-Date:\s+PENDING$", AGENTS, re.M)
        assert re.search(r"^Supersedes:\s+20\.1\.0$", AGENTS, re.M)
    else:
        assert re.search(rf"{TOKEN} \d+ [0-9a-f]{{40}}", rest), "ACTIVE 21.0.0 row must record token, PR and sha"


def test_banner_explains_class_scope_what_stays_and_decisions():
    start = AGENTS.index("**21.0.0 is ")
    banner = _flat(AGENTS[start: AGENTS.index("\n\n**", start + 10)])
    for frag in ("Why MAJOR:", "narrows §0 rule 1", "weakest guarantee", "It cannot be MINOR",
                 "It can suggest sizes, or I can say sizes.", "\"B\"", "`size_suggestion`", "ADVISORY",
                 "`scripts/lib/cio_advisory_sizing.py`", "What does not change:", "never orders, stops, arms, weights",
                 "`BehaviorWriteRefused`", "`BEHAVIOR_FIELDS` are unchanged", "`read_only`", "`live_submit`",
                 "a proposal still needs the operator", "Byte-identical:", "§29.7", "`Supersedes` 20.1.0",
                 f"{TOKEN} <pr_number> <head_sha>"):
        assert _flat(frag) in banner, frag


# --------------------------------------------------------------------------------------------------- §29


@pytest.mark.parametrize("sub,frags", [
    ("29.1", ("Only the \"Ask the CIO\" answer's `size_suggestion`", "No other answer, alert, page, prospect field",
              "labelled ADVISORY", "`not_actionable`", "formula, every input and its as_of", "states no size",
              "The operator may always name a size instead", "does not substitute its own")),
    ("29.2", ("One deterministic function", "`advisory_size_suggestion()`", "`scripts/lib/cio_advisory_sizing.py`",
              "long only", "default 1%, at most 5%", "floor(min(V·r / (E − S), (V·p − P) / E, (V·s − X) / E))",
              "binding constraint named", "nothing is defaulted except r", "Models may not invent sizes",
              "is stripped", "every stripped path is recorded")),
    ("29.3", ("No order, stop or proposal path reads it", "imports nothing from the broker, order, stop or",
              "only `scripts/lib/cio_ask_contract.py` may import it", "never auto-executed",
              "a proposal still needs the operator", "The rails stay as they are", "`BehaviorWriteRefused`",
              "`BEHAVIOR_FIELDS` are unchanged", "no key of the suggestion is a `BEHAVIOR_FIELDS` key",
              "`read_only`", "`live_submit`")),
    ("29.4", ("returns None unless", "21.0.0 history row begins with ACTIVE", "no flag or environment override")),
    ("29.5", ("written to CIO memory", "keyed by `security_guid`", "never as a prospect field")),
    ("29.6", ("operator settings (§17)", "never sets, raises or infers")),
    ("29.7", ("These clause edits", "(1) In §0 rule 1", "(2) In §26.1", "(3) In §17")),
])
def test_section_29_states_every_rule(sub, frags):
    text = _flat(_sub(_s29(), sub))
    for frag in frags:
        assert _flat(frag) in text, f"§{sub}: {frag!r}"


def test_every_section_29_bullet_cites_its_cause():
    bullets = re.split(r"\n(?=- \*\*)", _s29())[1:]
    assert len(bullets) >= 9, len(bullets)
    for b in bullets:
        assert "*Cause (§20):" in b, b[:120]


def _quoted(body: str) -> str:
    return "  ```\n" + "\n".join(("  " + line) if line else "" for line in body.rstrip("\n").split("\n")) + "\n  ```"


def test_section_29_7_quotes_every_clause_verbatim():
    s297 = _sub(_s29(), "29.7")
    for key, digest in CLAUSE_SHA256.items():
        clause = globals()[key]
        assert h(clause) == digest, f"{key} digest"
        if key.endswith("_ANCHOR"):
            continue
        body = clause.lstrip("\n") if key == "R3_INS" else clause
        assert _quoted(body) in s297, f"{key} is not quoted verbatim in §29.7"


# ---------------------------------------------------------------------------------- byte-identical rails


@pytest.mark.parametrize("name", FIXED)
def test_fixed_sections_are_byte_identical(name):
    assert h(_section(AGENTS, name)) == SECTION_SHA256[name], f"{name} changed"


def test_changing_sections_differ_only_by_the_quoted_clauses_and_only_at_ratification():
    if not _ratified():
        rest = AGENTS.replace(_s29(), "")
        for key in ("R1_INS", "R2_INS", "R3_INS"):
            assert globals()[key].strip("\n") not in rest, f"{key} in force before ratification"
        text = AGENTS
    else:
        text = undo_21_0_0(AGENTS)
    for name in CHANGING:
        assert h(_section(text, name)) == SECTION_SHA256[name], f"{name} changed beyond the quoted clauses"


def test_post_ratification_digests_are_pinned_in_advance():
    ratified = AGENTS if _ratified() else redo_21_0_0(AGENTS)
    for name in CHANGING:
        assert h(_section(ratified, name)) == SECTION_RATIFIED_SHA256[name], name
    assert undo_21_0_0(ratified) == pre_21_0_0(AGENTS)


@pytest.mark.parametrize("adapter", ADAPTERS)
def test_adapters_gain_the_rule_1_sentence_only_at_ratification(adapter):
    text = (ROOT / adapter).read_text(encoding="utf-8")
    assert text.count(R1_ANCHOR) == 1, f"{adapter} lost §0 rule 1"
    if not _ratified():
        assert R1_INS not in text and h(text) == ADAPTER_SHA256[adapter], f"{adapter} ahead of ratification"
    else:
        assert text.count(R1_ANCHOR + R1_INS) == 1, f"{adapter} paraphrases the 21.0.0 sentence"
        assert h(text) == ADAPTER_RATIFIED_SHA256[adapter]
        assert h(pre_21_0_0_adapter(text)) == ADAPTER_SHA256[adapter]


# ---------------------------------------------------------------------------------------- code agrees


from scripts.lib import cio_advisory_sizing as SZ  # noqa: E402
from scripts.lib import cio_instrument_record as CIR  # noqa: E402

ROW_21_ACTIVE = "| 21.0.0 | 2026-10-23 | ACTIVE | MAJOR | x | y |\n"
ROW_21_PROPOSED = "| 21.0.0 | 2026-10-23 | PROPOSED | MAJOR | x | y |\n"
ROW_20_ACTIVE = "| 20.0.0 | 2026-10-22 | ACTIVE | MAJOR | x | y |\n"
BROKERISH = re.compile(r"broker|order|schwab|alpaca|ibkr|trading_lock|kill_switch|proposal|execution|stop_|live_submit",
                       re.I)


def _policy(tmp_path: Path, *rows: str, anchor: bool = True) -> Path:
    body = ("# 29 · Advisory size suggestions (21.0.0, ACTIVE)\n\n" if anchor else "") + "# Version history\n\n"
    (tmp_path / "AGENTS.md").write_text(body + "| Version | Date | Status |\n|---|---|---|\n" + "".join(rows),
                                        encoding="utf-8")
    return tmp_path


BASE_KW = dict(symbol="TSLA", portfolio_value=100_000, reference_price=250, stop_reference_price=230,
               max_position_pct="0.10", max_sector_pct="0.25", sector_exposure_usd=5_000, existing_position_usd=0, as_of="2026-10-23T15:00:00Z")


def test_code_named_in_section_29_exists():
    s29 = _s29()
    for path in (MODULE, "scripts/lib/cio_instrument_record.py", "tests/test_agents_policy_21_0_0_advisory_sizing.py"):
        assert (ROOT / path).exists(), path
        assert path in s29 or path.rsplit("/", 1)[-1] in s29, path
    assert SZ.ALLOWED_IMPORTERS == ("scripts/lib/cio_ask_contract.py",)
    assert SZ.REQUIRED_POLICY == "21.0.0" and SZ.POLICY_ANCHOR in _s29()
    assert SZ.DEFAULT_RISK_BUDGET_PCT == Decimal("0.01") and SZ.MAX_RISK_BUDGET_PCT == Decimal("0.05")
    assert "floor(min(V·r / (E − S), (V·p − P) / E, (V·s − X) / E))" in _flat(_s29())
    assert SZ.FORMULA == "shares = floor(min(V*r / (E - S), (V*p - P) / E, (V*s - X) / E)), never below zero"


@pytest.mark.parametrize("rows,anchor", [
    ((ROW_20_ACTIVE,), True), ((ROW_21_PROPOSED, ROW_20_ACTIVE), True), ((ROW_21_ACTIVE,), False), ((), True),
])
def test_inert_below_21_0_0_active(tmp_path, rows, anchor):
    root = _policy(tmp_path, *rows, anchor=anchor)
    assert SZ.policy_active(root) is False
    assert SZ.advisory_size_suggestion(policy_root=root, **BASE_KW) is None


def test_inert_when_agents_md_is_unreadable(tmp_path):
    assert SZ.policy_active(tmp_path / "missing") is False
    assert SZ.advisory_size_suggestion(policy_root=tmp_path / "missing", **BASE_KW) is None


def test_repository_state_decides_and_nothing_else(monkeypatch):
    monkeypatch.setenv("MBI_BEHAVIOR", "1")
    monkeypatch.setenv("CIO_ADVISORY_SIZING", "1")
    got = SZ.advisory_size_suggestion(**BASE_KW)
    assert (got is not None) == _ratified()


def test_risk_budget_binds(tmp_path):
    s = SZ.advisory_size_suggestion(policy_root=_policy(tmp_path, ROW_21_ACTIVE), **BASE_KW)
    # V*r/(E-S) = 1000/20 = 50; position (10000-0)/250 = 40 ... the position cap binds below
    assert s["caps"] == {"by_risk_budget": 50, "by_position_limit": 40, "by_sector_limit": 80}
    assert s["suggested_share_count"] == 40 and s["binding_constraint"] == "position_limit"
    kw = dict(BASE_KW, max_position_pct="0.30")
    s = SZ.advisory_size_suggestion(policy_root=tmp_path, **kw)
    assert s["caps"] == {"by_risk_budget": 50, "by_position_limit": 120, "by_sector_limit": 80}
    assert s["suggested_share_count"] == 50 and s["binding_constraint"] == "risk_budget"
    assert s["suggested_notional_usd"] == "12500.00" and s["risk_at_stop_reference_usd"] == "1000.00"


def test_sector_cap_binds_and_never_goes_negative(tmp_path):
    root = _policy(tmp_path, ROW_21_ACTIVE)
    s = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, max_position_pct="0.30",
                                                             sector_exposure_usd=24_000))
    assert s["caps"]["by_sector_limit"] == 4 and s["suggested_share_count"] == 4
    assert s["binding_constraint"] == "sector_limit"
    s = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, sector_exposure_usd=40_000))
    assert s["suggested_share_count"] == 0 and s["caps"]["by_sector_limit"] == 0
    s = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, existing_position_usd=12_000))
    assert s["caps"]["by_position_limit"] == 0 and s["suggested_share_count"] == 0


def test_deterministic_and_fully_shown(tmp_path):
    root = _policy(tmp_path, ROW_21_ACTIVE)
    a = SZ.advisory_size_suggestion(policy_root=root, **BASE_KW)
    b = SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, portfolio_value="100000.0"))
    assert json.dumps(a, sort_keys=True) == json.dumps(SZ.advisory_size_suggestion(policy_root=root, **BASE_KW),
                                                       sort_keys=True)
    assert a["suggested_share_count"] == b["suggested_share_count"]
    assert a["label"] == "ADVISORY" and a["not_actionable"] is True and a["source"] == "deterministic"
    assert a["formula"] == SZ.FORMULA and a["as_of"] == BASE_KW["as_of"] and a["policy"] == "AGENTS.md 21.0.0 §29"
    assert set(a["inputs"]) == {"portfolio_value_usd", "risk_budget_pct", "reference_price", "stop_reference_price",
                                "max_position_pct", "max_sector_pct", "existing_position_usd", "sector_exposure_usd"}
    assert a["inputs"]["risk_budget_pct"] == "0.01"
    assert "ADVISORY, not an order" in a["reasoning"] and "position limit binds" in a["reasoning"]


@pytest.mark.parametrize("bad", [
    {"portfolio_value": None}, {"portfolio_value": 0}, {"reference_price": "x"}, {"stop_reference_price": 250},
    {"stop_reference_price": 260}, {"stop_reference_price": 0}, {"risk_budget_pct": "0.06"}, {"risk_budget_pct": 0},
    {"max_position_pct": None}, {"max_sector_pct": "1.5"}, {"sector_exposure_usd": None}, {"sector_exposure_usd": -1},
    {"existing_position_usd": -5}, {"existing_position_usd": None}, {"as_of": ""}, {"symbol": ""}, {"portfolio_value": float("nan")},
    {"reference_price": True},
])
def test_missing_or_invalid_inputs_give_no_suggestion(tmp_path, bad):
    root = _policy(tmp_path, ROW_21_ACTIVE)
    assert SZ.advisory_size_suggestion(policy_root=root, **dict(BASE_KW, **bad)) is None


def test_suggestion_carries_no_behaviour_field(tmp_path):
    s = SZ.advisory_size_suggestion(policy_root=_policy(tmp_path, ROW_21_ACTIVE), **BASE_KW)
    assert not [k for k in CIR._walk_keys(s) if k in CIR.BEHAVIOR_FIELDS]
    assert SZ.BEHAVIOR_FIELDS == CIR.BEHAVIOR_FIELDS


def test_model_quantities_are_stripped_and_recorded(tmp_path):
    s = SZ.advisory_size_suggestion(policy_root=_policy(tmp_path, ROW_21_ACTIVE), **BASE_KW)
    model = {"answer": "text", "size_suggestion": {"shares": 1000},
             "options": [{"symbol": "TSLA", "qty": 100, "note": "n"}], "plan": {"stop": 1, "order": {"x": 1}}}
    out = SZ.attach_size_suggestion(model, s)
    assert out["size_suggestion"] == s and out["answer"] == "text"
    assert sorted(out["stripped_model_quantities"]) == ["options[0].qty", "plan.order", "plan.stop", "size_suggestion"]
    assert out["options"] == [{"symbol": "TSLA", "note": "n"}] and out["plan"] == {}
    assert model["size_suggestion"] == {"shares": 1000}, "the model's dict is not mutated"
    none = SZ.attach_size_suggestion({"size_suggestion": {"shares": 5}}, None)
    assert none["size_suggestion"] is None and none["stripped_model_quantities"] == ["size_suggestion"]


def test_module_imports_only_the_standard_library():
    tree = ast.parse((ROOT / MODULE).read_text(encoding="utf-8"))
    mods = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            mods.update(a.name.split(".")[0] for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            assert node.level == 0, "no relative imports"
            mods.add(node.module.split(".")[0])
    assert mods <= {"__future__", "re", "decimal", "pathlib", "typing"}, mods


def test_import_closure_holds_no_broker_order_stop_or_proposal_module():
    code = ("import sys; before = set(sys.modules); sys.path.insert(0, sys.argv[1]); "
            "import scripts.lib.cio_advisory_sizing; print('\\n'.join(sorted(set(sys.modules) - before)))")
    out = subprocess.run([sys.executable, "-I", "-c", code, str(ROOT)], capture_output=True, text=True, check=True)
    new = [m for m in out.stdout.split() if m]
    assert "scripts.lib.cio_advisory_sizing" in new
    assert not [m for m in new if BROKERISH.search(m)], new
    assert not [m for m in new if m.startswith("scripts.") and m not in ("scripts", "scripts.lib",
                                                                         "scripts.lib.cio_advisory_sizing")], new


def test_only_the_ask_contract_imports_the_module():
    skip = {".git", ".venv", "venv", "node_modules", "tests", "__pycache__", ".cache"}
    importers = []
    for p in ROOT.rglob("*.py"):
        rel = p.relative_to(ROOT)
        if skip & set(rel.parts[:-1]) or rel.as_posix() == MODULE:
            continue
        try:
            tree = ast.parse(p.read_text(encoding="utf-8", errors="ignore"))
        except (OSError, SyntaxError):
            continue
        names = []
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                names.extend(a.name for a in node.names)
            elif isinstance(node, ast.ImportFrom):
                names.append(node.module or "")
                names.extend((node.module or "") + "." + a.name for a in node.names)
        if any(name.rsplit(".", 1)[-1] == "cio_advisory_sizing" for name in names):
            importers.append(rel.as_posix())
    assert set(importers) <= set(SZ.ALLOWED_IMPORTERS), importers


@pytest.mark.parametrize("field", CIR.BEHAVIOR_FIELDS)
def test_behaviour_rail_still_raises_for_every_behaviour_field(field):
    with pytest.raises(CIR.BehaviorWriteRefused):
        CIR.apply_cognition({}, next_research_question="q", **{field: 1})


def test_behaviour_rail_is_unconditional():
    assert CIR.BEHAVIOR_FIELDS == ("recommended_delta_usd", "size_usd", "shares", "qty", "order",
                                   "stop", "limit", "target_weight_pct", "trade", "execution")
    src = inspect.getsource(CIR.apply_cognition)
    body = src[src.index('"""', src.index('"""') + 3) + 3:]
    assert body.lstrip().startswith("if forbidden:"), "the rail must be the first statement"
    assert "raise BehaviorWriteRefused(" in body.split("rec = dict(record)")[0]
    assert "environ" not in body and "getenv" not in body
