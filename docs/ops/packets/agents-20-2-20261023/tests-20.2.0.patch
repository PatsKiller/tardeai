+"""20.2.0 operator-only package pins exact additions and preserves all prior authority rails."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+for p in (str(ROOT), str(ROOT / "scripts")):
+    if p not in sys.path:
+        sys.path.insert(0, p)
+from scripts import check_agents_policy_state as STATE  # noqa: E402
+
+C = {
+    "base_header": {
+        "Policy-Version": "20.1.0",
+        "Status": "ACTIVE",
+        "Effective-Date": "2026-10-23",
+        "Last-Reviewed": "2026-10-23T12:00:00-04:00",
+        "Supersedes": "20.0.0",
+    },
+    "base_masked_sha256": "1f21d879f75130d7e7ce9458bd610b92916d395b8c81292015645cfe2eab8f50",
+    "banner": "<!-- AGENTS_20_2_BANNER_START -->\n**20.2.0 is PROPOSED (MINOR) — the Work pipeline is an operator surface, never an agent authority.**\nThe operator may make the named Tier 2 acts with a fresh passkey assertion and typed phrase through the existing\nhost applier once this version is ACTIVE. Agents never call the Controls endpoints. Grant-binding package approval\nis not included; `approve_item_enabled` stays off. Ratification flips no runtime feature flag. Coordination\nclarifications cover shared-additive paths, evidence-only closure and the five task sections. Adapter headings say\neleven; their §0 bodies stay byte-identical. The existing §28.8 smoke flag is\n`TRADEAI_LIVE_SMOKE_AFTER_CLOSE=1` and remains unchanged. **Why MINOR:** it records an operator surface for acts the\noperator already owns and adds evidence requirements; it grants an agent no permission. **Byte-identical:** outside\nthe header, this banner, the four labelled insertions and this version's history row, policy text is unchanged;\nthe generated §7A table is renderer-owned and excluded from whole-document comparisons. Existing authority rails\nand broker restrictions are unchanged. Awaiting `APPROVE_AGENTS_POLICY_20_2_0 <pr_number> <head_sha>` (§20).\n<!-- AGENTS_20_2_BANNER_END -->\n\n",
+    "clauses": {
+        "27.2": '- **The Work pipeline\'s Tier 2 acts are Controls acts (20.2.0).** Binding only once AGENTS.md 20.2.0 is\n  ACTIVE. From Ops → Coordination → Work pipeline the operator may, each time with a fresh passkey assertion and\n  the typed phrase, through the one host applier: approve a design, phase or packet, and mark a DRAFT n8n health\n  contract reviewed. Each is an append-only record in the coordination store (`designs/approvals.jsonl`,\n  `contracts/reviews.jsonl`) carrying the operator\'s words and the assertion. Such a record is the operator\'s\n  approval in their own words for §28.3b and §23.19, and is not a relayed approval under §28.4. An agent that carries\n  it into the design or contract file cites the record. The operator may also merge a PR whose required checks are\n  all exactly `success` at the head the operator saw (`--match-head-commit`), and run the exact-main release\n  (prepare + promote) under an active `release-write` grant; the existing release gates and grant binding still\n  apply. Approving an approval package that binds a guard grant is issuing a grant (§17), is not covered by this\n  clause, and leaves `approve_item_enabled` off. Agents never call these endpoints (§27.2). Ratification does not\n  enable `merge_pr_enabled` or `release_now_enabled`; each flag change needs its own reviewed PR after ratification.\n  *Cause (§20): operator 2026-10-23, "nothing is actionable on there" and "both"; Handoff v3 WP-15.*\n',
+        "28.3": "- **Shared-additive paths never conflict (20.2.0).** Binding only once AGENTS.md 20.2.0 is ACTIVE.\n  A path declared shared-additive by `config/agent_claim_shared_paths.json` never conflicts with another session's\n  claim; its declared mechanical merge procedure still applies. Every other path is exclusive and the committer\n  still needs a live claim and current worklog. A missing or invalid shared-path config means all paths are\n  exclusive. *Cause (§20): operator 2026-10-23; PR #2029; `docs/ops/AGENT_CLAIM_BOARD.md` §15.*\n",
+        "28.3a": "- **Evidence-only closure of shipped free tasks (20.2.0).** Binding only once AGENTS.md 20.2.0 is ACTIVE.\n  A free task whose work already shipped is closed with `task done --evidence-only`, a summary and PR/release\n  evidence, without claiming its files again. It never closes a taken task or overrides another session's\n  ownership. *Cause (§20): operator 2026-10-23; PR #2029 and Handoff v3 WP-03/WP-15.*\n",
+        "28.3b": '- **Every task carries the full work package (20.2.0).** Binding only once AGENTS.md 20.2.0 is ACTIVE.\n  Every task carries problem, definition of done, agent prompt, operator commands and proof of completion; done\n  requires evidence. The Work pipeline, CLI and exported handoff read the same task record; a PR-open label is not\n  proof of a served change. *Cause (§20): operator 2026-10-23, "this is what should be done inside of the board\n  also"; Handoff v3 WP-41.*\n',
+    },
+    "adapter_sha256": {
+        "CLAUDE.md": "04df92d64e45d372d31963aa006c97d6b03770f1b081c60c69a211fdbaaa8880",
+        ".cursor/rules/00-tradeai-work-policy.mdc": "b7308162f626bdb78212c18112a94061cfc1a9afa25f675cc0413edba8214f7c",
+        ".github/copilot-instructions.md": "1cfaa8fba009e5a142328ecdd9d30fe3bf0cc2d4861b6c35271e4d084b902a48",
+        ".goosehints": "ad79ef5fa172d34eaafad36392734aac0d4d37d7513529bef335b7de0dbec8df",
+    },
+}
+TOKEN = "APPROVE_AGENTS_POLICY_20_2_0"
+AGENTS = (ROOT / "AGENTS.md").read_text()
+
+
+def h(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def blank(text):
+    return re.sub(
+        r"(<!-- SOURCE_OF_TRUTH_TABLE_START -->).*?(<!-- SOURCE_OF_TRUTH_TABLE_END -->)",
+        r"\1\n<generated>\n\2",
+        text,
+        flags=re.S,
+    )
+
+
+def pre_20_2_0(text):
+    if not re.search(r"^\| 20\.2\.0 \|", text, re.M):
+        return text
+    text = re.sub(
+        r"<!-- AGENTS_20_2_BANNER_START -->.*?<!-- AGENTS_20_2_BANNER_END -->\n\n", "", text, count=1, flags=re.S
+    )
+    for clause in C["clauses"].values():
+        text = text.replace("\n" + clause, "", 1)
+    text = re.sub(r"^\| 20\.2\.0 \|.*\n", "", text, count=1, flags=re.M)
+    for key, value in C["base_header"].items():
+        text = re.sub(rf"^({re.escape(key)}:\s+).*$", lambda m, v=value: m.group(1) + v, text, count=1, flags=re.M)
+    return text
+
+
+def pre_20_2_0_adapter(text):
+    return text.replace("## The eleven rules, verbatim", "## The ten rules, verbatim", 1)
+
+
+def test_header_row_and_state_agree():
+    assert STATE.check(AGENTS, on_main=True) == []
+    assert STATE.check(AGENTS, on_main=False) == []
+    rows = re.findall(r"^\| 20\.2\.0 \|.*$", AGENTS, re.M)
+    assert len(rows) == 1
+    cb = STATE.control_block(AGENTS)
+    assert cb["Policy-Version"] == "20.2.0"
+    assert cb["Supersedes"] == "20.1.0"
+    if cb["Status"] == "PROPOSED":
+        assert cb["Effective-Date"] == "PENDING"
+        assert "PENDING" in rows[0] and TOKEN + " <pr_number> <head_sha>" in rows[0]
+    else:
+        assert cb["Status"] == "ACTIVE"
+        assert re.search(TOKEN + r" \d+ [0-9a-f]{40}", rows[0])
+
+
+def test_only_declared_policy_insertions_changed():
+    assert h(blank(pre_20_2_0(AGENTS))) == C["base_masked_sha256"]
+    for clause in C["clauses"].values():
+        assert AGENTS.count(clause) == 1
+        assert "Binding only once AGENTS.md 20.2.0 is" in clause
+        assert "*Cause (§20):" in clause
+
+
+def test_pin_detects_unrelated_authority_mutation():
+    changed = AGENTS.replace("The agent never sizes", "The agent may size", 1)
+    assert changed != AGENTS
+    assert h(blank(pre_20_2_0(changed))) != C["base_masked_sha256"]
+
+
+def test_generated_table_is_not_a_false_policy_mutation():
+    changed = re.sub(
+        r"(<!-- SOURCE_OF_TRUTH_TABLE_START -->).*?(<!-- SOURCE_OF_TRUTH_TABLE_END -->)",
+        r"\1\nrenderer-owned fixture row\n\2",
+        AGENTS,
+        flags=re.S,
+    )
+    assert h(blank(pre_20_2_0(changed))) == C["base_masked_sha256"]
+
+
+def test_adapters_change_heading_only_and_keep_original_digests():
+    for path, expected in C["adapter_sha256"].items():
+        text = (ROOT / path).read_text()
+        assert "## The eleven rules, verbatim" in text
+        assert h(pre_20_2_0_adapter(text)) == expected
+
+
+def test_operator_controls_keep_their_authority_boundaries():
+    clause = C["clauses"]["27.2"]
+    for text in (
+        "fresh passkey assertion",
+        "typed phrase",
+        "one host applier",
+        "all exactly `success`",
+        "--match-head-commit",
+        "active `release-write`",
+        "Agents never call these endpoints",
+        "is not covered by this",
+        "approve_item_enabled",
+        "Ratification does not",
+    ):
+        assert text in clause
+    flags = json.loads((ROOT / "config/ops_controls.json").read_text())["work_pipeline"]
+    assert flags["approve_item_enabled"] is False
+    if STATE.control_block(AGENTS)["Status"] == "PROPOSED":
+        assert flags["merge_pr_enabled"] is False and flags["release_now_enabled"] is False
+
+
+def test_coordination_and_smoke_obligations_are_explicit():
+    assert "shared-additive" in C["clauses"]["28.3"]
+    assert "`task done --evidence-only`" in C["clauses"]["28.3a"]
+    assert "never closes a taken task" in C["clauses"]["28.3a"]
+    for text in (
+        "problem",
+        "definition of done",
+        "agent prompt",
+        "operator commands",
+        "proof of completion",
+        "requires evidence",
+    ):
+        assert text in C["clauses"]["28.3b"]
+    assert "`TRADEAI_LIVE_SMOKE_AFTER_CLOSE=1`" in AGENTS
+
+
+def test_registered_gate_is_canonical():
+    from scripts.lib import ci_gates
+
+    path = ROOT / "config/ci_gates/agents_policy_20_2_0_work_pipeline.json"
+    gate = json.loads(path.read_text())
+    assert gate["files"] == ["tests/test_agents_policy_20_2_0_work_pipeline.py"]
+    assert gate["anchor"] == "AGENTS_POLICY_20_2_0_WORK_PIPELINE"
+    assert path.read_text() == ci_gates.render(gate)
