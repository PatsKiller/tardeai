# PROPOSED, NOT INSTALLED (packet docs/ops/packets/release-train-host-trigger-20261023/). The PR census 20 minutes
# before the 06:00 ET window. Persistent=false: a missed census is not replayed.
[Unit]
Description=Trade AI release train: PR census at 05:40 America/New_York (window 0600)

[Timer]
OnCalendar=*-*-* 05:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@0600.service

[Install]
WantedBy=timers.target
