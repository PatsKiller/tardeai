# PROPOSED, NOT INSTALLED (packet docs/ops/packets/release-train-host-trigger-20261023/). The PR census 20 minutes
# before the 08:00 ET window. Persistent=false: a missed census is not replayed.
[Unit]
Description=Trade AI release train: PR census at 07:40 America/New_York (window 0800)

[Timer]
OnCalendar=*-*-* 07:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@0800.service

[Install]
WantedBy=timers.target
