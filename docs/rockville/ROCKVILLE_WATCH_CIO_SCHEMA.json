{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "watch_cio_digest.v1",
  "title": "watch_cio_digest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "market_date",
    "generated_at",
    "watchlist_material_hash",
    "changed_symbol_count",
    "unchanged_symbol_count",
    "held_position_change_count",
    "executive_stance",
    "operator_priority_queue",
    "provenance",
    "usage",
    "status"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "market_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated_at": { "type": "string" },
    "watchlist_material_hash": { "type": "string", "minLength": 16 },
    "previous_artifact_id": { "type": ["string", "null"] },
    "changed_symbol_count": { "type": "integer", "minimum": 0 },
    "unchanged_symbol_count": { "type": "integer", "minimum": 0 },
    "held_position_change_count": { "type": "integer", "minimum": 0 },
    "executive_stance": {
      "type": "object",
      "required": ["posture", "summary", "confidence"],
      "properties": {
        "posture": {
          "type": "string",
          "enum": ["RISK_ON", "SELECTIVE", "DEFENSIVE", "INSUFFICIENT_EVIDENCE"]
        },
        "summary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "operator_priority_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "state", "priority", "what_changed", "why_it_matters", "next_operator_action"],
        "properties": {
          "symbol": { "type": "string" },
          "state": { "type": "string" },
          "priority": { "type": "integer" },
          "what_changed": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "next_operator_action": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "ready_now": { "type": "array", "items": { "type": "string" } },
    "waiting_for_confirmation": { "type": "array", "items": { "type": "string" } },
    "blocked_or_avoid": { "type": "array", "items": { "type": "string" } },
    "held_position_attention": { "type": "array", "items": { "type": "string" } },
    "portfolio_level_conflicts": { "type": "array", "items": { "type": "string" } },
    "sector_and_factor_concentrations": { "type": "array", "items": { "type": "string" } },
    "next_7_day_events": { "type": "array", "items": { "type": "string" } },
    "material_catalysts": { "type": "array", "items": { "type": "string" } },
    "data_quality_and_freshness_risks": { "type": "array", "items": { "type": "string" } },
    "unresolved_contradictions": { "type": "array", "items": { "type": "string" } },
    "what_changed_since_prior_digest": { "type": "array", "items": { "type": "string" } },
    "what_did_not_change": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "policy",
        "thinking",
        "effort",
        "prompt_version",
        "input_hash",
        "output_hash"
      ],
      "properties": {
        "provider": { "const": "deepseek" },
        "model": { "const": "deepseek-v4-pro" },
        "policy": { "const": "CIO_DAILY_PRO" },
        "thinking": { "const": true },
        "effort": { "enum": ["high", "max"] },
        "prompt_version": { "type": "string" },
        "input_hash": { "type": "string" },
        "output_hash": { "type": "string" },
        "request_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "cache_hit_input_tokens": { "type": ["integer", "null"] },
        "cache_miss_input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "reasoning_tokens": { "type": ["integer", "null"] },
        "actual_cost_usd": { "type": ["number", "null"] },
        "latency_ms": { "type": ["integer", "null"] },
        "finish_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "NO_MATERIAL_CHANGE", "FAILED", "STALE"]
    },
    "failure_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "AUTH_MISSING",
        "AUTH_INVALID",
        "MODEL_NOT_FOUND",
        "HTTP_429",
        "TIMEOUT",
        "PROVIDER_5XX",
        "JSON_INVALID",
        "MODEL_OUTPUT_INVALID",
        "COST_CAP_BLOCKED"
      ]
    }
  }
}
