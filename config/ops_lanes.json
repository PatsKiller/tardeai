{
  "schema": "OpsLanesConfig@v1",
  "as_of": "2026-10-09",
  "_why": "Thresholds and paths for the three read-only ops lanes (storage-watch, backup-verify, trade-ai-restore-drill). Data, not code: the scripts read every threshold from here so a change is a reviewed config diff, never an edit to a literal. Paths starting with ~ expand to the running user's home; an env override named in *_env wins when set.",
  "storage_watch": {
    "filesystems": ["/"],
    "disk_warn_used_pct": 80,
    "disk_crit_used_pct": 90,
    "inode_warn_used_pct": 80,
    "inode_crit_used_pct": 90,
    "growers_top_n": 10,
    "relations_top_n": 10,
    "du_timeout_s": 180,
    "du_nice": 19,
    "heavy_roots": [
      "~/trade-ai-releases/archive",
      "~/trade-ai-releases/persistent-state",
      "~/trade-ai-releases/portfolio-server",
      "~/db_backups",
      "~/.hermes",
      "~/llama-cpp-vulkan",
      "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs",
      "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data",
      "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild/state",
      "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild/backups",
      "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.claude",
      "~/.cache",
      "~/.npm",
      "~/.codex",
      "~/.grok",
      "~/.openclaw",
      "~/.local/share",
      "~/.claude/projects",
      "/usr/share/ollama",
      "/var/log/postgresql"
    ],
    "pg_log_dir": "/var/log/postgresql",
    "pg_log_warn_bytes": 2147483648,
    "m2_container": "tradeai-m2-shadow-v2",
    "m2_container_user": "m2",
    "m2_test_db_regex": "^m2_shadow_test_",
    "m2_test_db_warn_count": 25,
    "worktree_main_repo": "~/trade-ai-v12-rebuild/trade-ai-v12-rebuild",
    "worktree_main_repo_env": "TRADEAI_DEV_TREE",
    "worktree_warn_count": 200,
    "grower_warn_bytes_per_day": 2147483648
  },
  "backup_verify": {
    "dump_dir": "~/db_backups",
    "dump_dir_env": "TRADEAI_DB_BACKUP_DIR",
    "dump_globs": ["trade_ai_*.sql.gz", "trade_ai_*.dump"],
    "backup_log": "backup.log",
    "max_age_hours": 26,
    "size_tolerance_pct": 30,
    "size_median_days": 7,
    "size_median_min_samples": 3,
    "table_count_floor": 600,
    "scan_timeout_s": 1800,
    "n8n_receipt_rel": "backups/n8n/n8n_lab_backup_last.json",
    "n8n_max_age_hours": 26,
    "drive_family_stamps_rel": [
      "data/runtime/last_secrets_data_backup.stamp",
      "data/runtime/last_db_offsite_backup.stamp",
      "data/runtime/last_apps_backup.stamp"
    ],
    "drive_family_max_age_days": 8
  },
  "restore_drill": {
    "db_name_prefix": "restore_drill_",
    "db_name_regex": "^restore_drill_\\d{8}$",
    "disk_multiplier": 2.0,
    "disk_headroom_pct": 15,
    "pg_data_fs_path": "/var/lib/postgresql",
    "excluded_data_schemas": ["intelligence", "memory_r10_m2"],
    "compare_top_n": 20,
    "row_tolerance_pct": 15,
    "row_tolerance_abs": 1000,
    "restore_timeout_s": 14400,
    "role_user_env": "TRADEAI_RESTORE_DRILL_DB_USER",
    "role_password_env": "TRADEAI_RESTORE_DRILL_DB_PASSWORD",
    "role_credentials_file": "~/.config/tradeai/restore_drill_db.env",
    "template_db": "restore_drill_template",
    "key_tables": [
      "public.paper_trade_proposals",
      "public.paper_trades",
      "public.trade_closed",
      "public.trade_transactions",
      "public.watchlist_items",
      "public.watch_directives",
      "public.broker_accounts",
      "public.cio_decisions"
    ],
    "prescan_timeout_s": 3600,
    "tolerated_error_regexes": [
      "ERROR:\\s+must be owner of extension [A-Za-z0-9_-]+$"
    ],
    "psql_restrict_min_versions": {"13": 22, "14": 19, "15": 14, "16": 10, "17": 6, "18": 0}
  }
}
