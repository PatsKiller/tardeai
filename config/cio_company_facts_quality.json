{
  "schema": "CIOCompanyFactsQuality@v1",
  "owner": "scripts/lib/cio_company_quality.py",
  "comment": [
    "C1 catalyst quality + display names (operator-approved 2026-10-24, coordinator batch 21).",
    "A catalyst is a DATED event: the next scheduled upcoming event first, then a recent material corporate event.",
    "Price predictions/forecasts, stock-to-buy lists, listicles/SEO, plain price moves and insider/holding trades are",
    "recent_news only, never the catalyst. Patterns are case-insensitive Python regular expressions."
  ],
  "catalyst": {
    "upcoming_horizon_days": 90,
    "material_window_days": 30,
    "scheduled_source_max_age_days": 45,
    "recent_news_max": 3,
    "upcoming_event_types": {
      "earnings": ["earnings", "earnings_date", "earnings_release", "earnings_call", "earnings_report_scheduled"],
      "ex_dividend": ["ex_dividend", "ex_dividend_date", "ex_div"],
      "fda_pdufa": ["pdufa", "fda_pdufa", "adcom", "advisory_committee"],
      "investor_day": ["investor_day", "analyst_day", "capital_markets_day"],
      "product_launch": ["product_launch", "product", "launch_event"],
      "deal_close": ["deal_close", "merger_close", "acquisition_close", "shareholder_vote"],
      "index_change": ["index_change", "index_inclusion", "index_addition", "index_deletion", "rebalance"],
      "lockup_expiry": ["lockup_expiry", "lockup", "lock_up_expiry"]
    },
    "material_event_types": {
      "sec_8k": ["regulatory_disclosure", "material_agreement", "filing_8k", "8k"],
      "results": ["earnings", "earnings_beat", "earnings_miss", "earnings_release", "earnings_report",
                  "earnings_beat|earnings_miss|guidance_raise|guidance_lower"],
      "guidance_change": ["guidance_raise", "guidance_lower", "guidance_change"],
      "m_and_a": ["merger_acquisition", "merger_terminated", "acquisition", "merger", "spinoff", "divestiture"],
      "fda_pdufa": ["fda_approval", "fda_rejection", "clinical_trial", "biotech_breakthrough"],
      "capital_return": ["buyback", "dividend_increase", "dividend_cut", "stock_split"],
      "financing": ["offering_dilution", "refinancing", "investor_financing", "stock_sale_agreement", "retail_placement"],
      "contract": ["contract_win", "contract"],
      "leadership_change": ["ceo_change", "executive_change", "board_change"],
      "product_launch": ["product_launch", "product"],
      "legal_regulatory": ["legal", "legal_risk", "lawsuit", "regulatory", "compliance_deadline", "restructuring"]
    },
    "news_only_types": ["other", "news_momentum", "analyst_upgrade", "analyst_downgrade", "analyst", "insider_buy",
                        "insider_sell", "geopolitical", "bearish", "bullish", "neutral", "short_squeeze",
                        "sector_rotation", "moving_average", "technical", "technical_level", "hedge_fund_buying",
                        "institutional_flows", "negative_news", "investment", "name_change", "none",
                        "no_clear_catalyst"],
    "excluded_headline_patterns": {
      "price_prediction": ["price prediction", "\\bforecasts?\\b", "price target", "\\bprediction\\b",
                           "where will .* be in", "could .* (?:hit|reach) \\$"],
      "stock_to_buy": ["stocks? to (?:buy|sell|watch|own|hold)", "should (?:i|you) buy", "\\bbuy now\\b",
                       "strong buy stocks", "portfolio-worthy", "\\bis it time to buy\\b", "\\btop picks?\\b",
                       "zacks .* bull and bear", "jim cramer", "how to play", "\\bmillionaire\\b"],
      "listicle": ["^\\s*\\d+\\s+(?:\\w+\\s+){0,4}stocks?\\b", "\\b\\d+\\s+(?:\\w+\\s+){0,3}stocks\\b",
                   "\\bvs\\.?\\s", "which (?:stock )?is the better", "\\bbetter (?:value|buy)\\b",
                   "^\\s*\\d+\\s+(?:reasons|things|ways|signs|charts)\\b"],
      "seo_commentary": ["\\?\\s*(?:-\\s*[^-]+)?$", "behavioral patterns", "liquidity pulse",
                         "institutional (?:flows|tactics)", "\\bplaybooks?\\b", "\\binflection\\b",
                         "\\bundervalued\\b", "\\bovervalued\\b", "fair value", "fully priced", "\\bcheap\\b",
                         "trades? at a .*discount", "what (?:comes next|to know|it means|that means)",
                         "here'?s why", "here’s why", "earnings call transcript", "said on its .* call",
                         "ahead of (?:next|its|the)", "expected to (?:grow|report|beat)", "will .* beat",
                         "\\brumou?rs?\\b", "\\bnarrative\\b", "growth filters", "quality stock passing",
                         "stock (?:alert|now rated)", "rated \"?moderate buy",
                         "\\b(?:may|could|might) (?:be|fall|rise|soar|crash|double|triple|outperform|underperform|still)\\b",
                         "\\byou(?:r)?\\b", "\\breportedly\\b"],
      "insider_or_holding_trade": ["\\b(?:ceo|cfo|coo|director|insider|officer|chair\\w*|president|founder)\\b.*\\b(?:sells?|sold|buys?|bought|gifts?)\\b",
                                   "\\bsells? \\$?[\\d.,]+\\s*(?:[mk]|million|thousand)?\\b.*\\bshares\\b",
                                   "\\bshares (?:in|of) .* (?:acquired|sold|bought|purchased) by\\b",
                                   "\\bstock (?:acquired|sold|bought|purchased) by\\b",
                                   "\\b(?:position|stake|holdings?) in .* (?:by|from)\\b",
                                   "\\b(?:raises|cuts|trims|boosts|lifts|lowers) (?:its )?(?:stake|position|holdings?)\\b",
                                   "form 4", "13f"],
      "market_wrap": ["\\bs&p 500\\b", "\\bnasdaq (?:gains?|falls?|rises?|drops?|closes?|slips?)\\b",
                      "\\bdow (?:jones )?(?:gains?|falls?|rises?|drops?|closes?)\\b", "\\bin focus\\b",
                      "stock market today", "\\b(?:top )?(?:stock )?movers\\b", "stocks? moving"],
      "foreign_listing": ["\\((?:LON|LSE|TSX|TSXV|ASX|HKG|HKEX|ETR|EPA|BIT|TYO|SWX|NSE|BSE|FRA|AMS|STO|CPH|HEL|OSL|KRX|SGX|JSE|BMV)\\s*:"]
    },
    "price_move_patterns": ["\\b(?:stock|shares?)\\b.*\\b(?:rises?|rose|falls?|fell|drops?|dropped|jumps?|jumped|climbs?|climbed|soars?|soared|surges?|surged|plunges?|plunged|slides?|slid|tumbles?|tumbled|rall(?:y|ies|ied)|pops?|popped|sinks?|sank|gains?|snaps?|notches)\\b",
                            "\\b(?:rises?|falls?|drops?|jumps?|climbs?|soars?|surges?|plunges?|slides?|tumbles?|gains?|pops?)\\s+[\\d.]+\\s*%",
                            "\\b(?:up|down)\\s+[\\d.]+\\s*%", "trading (?:higher|lower|up|down)", "52-week (?:high|low)s?",
                            "winning streak", "losing streak", "after [\\d.]+%? (?:decline|drop|surge|rally|gain)",
                            "\\bwhy (?:is|did|are) .* (?:stock|shares)\\b", "what is driving", "\\bjumped\\b", "\\bsurge in\\b"],
    "material_keyword_patterns": ["\\b8-k\\b", "\\bitem \\d\\.\\d\\d\\b", "\\bacquir(?:e|es|ed|ing|ition)\\b",
                                  "\\bmerger\\b", "\\bbuyout\\b", "\\btakeover\\b", "\\bto buy\\b .* for \\$",
                                  "\\b(?:raised|raises|lowers|lowered|cuts|reaffirms) (?:its )?(?:full-year |annual )?(?:guidance|outlook|forecast)\\b",
                                  "\\b(?:raised|lowered) (?:guidance|outlook)\\b", "\\bearnings (?:beat|miss)\\b",
                                  "\\bfda (?:approval|approves|clears|accepts)\\b", "\\bpdufa\\b",
                                  "\\b(?:wins|awarded|signs) .*\\bcontract\\b", "\\bdividend (?:increase|hike|cut)\\b",
                                  "\\bbuyback\\b", "\\bshare repurchase\\b", "\\bstock split\\b"],
    "excluded_publishers": ["Stock Traders Daily", "Intellectia AI", "ChartMill"],
    "generic_name_tokens": ["main", "first", "general", "american", "united", "national", "global", "new",
                            "international", "beta", "alpha", "the", "big", "great", "core", "digital",
                            "energy", "capital", "financial", "technologies", "systems", "group", "trust",
                            "street", "power", "solutions", "rocket", "planet", "next", "s"],
    "feed_labels": {
      "sec_edgar": "SEC EDGAR",
      "yahoo_rss": "Yahoo Finance",
      "yahoo_premarket": "Yahoo Finance",
      "benzinga_rss": "Benzinga",
      "seeking_alpha": "Seeking Alpha",
      "motley_fool": "Motley Fool",
      "finviz_news": "Finviz",
      "google_news_rss": "Google News",
      "symbol_profiles": "Earnings calendar",
      "trade_ai_scans": "Trade AI scanner",
      "hermes_momentum_catalysts": "Hermes research"
    }
  },
  "display_name": {
    "comment": "Common display name for cards. Source order: overrides, finviz company, the registered name that opens the stored profile description, then the stored registered name. Legal suffixes are trimmed from the END only, never to an empty name.",
    "overrides": {
      "FATN": "FatPipe"
    },
    "legal_suffixes": ["inc", "inc.", "incorporated", "corp", "corp.", "corporation", "co", "co.", "company", "ltd",
                       "ltd.", "limited", "plc", "llc", "l.p.", "lp", "n.v.", "nv", "s.a.", "sa", "ag", "se",
                       "holdings", "holding", "hldgs", "hldg", "ut", "pbc", "adr", "ads", "reit", "del",
                       "a", "b", "c", "cl", "cla", "class", "(publ)", "the"],
    "keep_upper_tokens": ["AI", "ADR", "ETF", "US", "USA", "S&P", "SPDR", "LM", "GE", "NRG", "BWX", "IBM", "KBR",
                          "AXT", "GCT", "CECO", "BETA", "JBT", "NYT", "AMD", "HP", "II", "III", "IV"],
    "fund_markers": ["etf", "fund", "trust shs", "index", "spdr", "ishares", "proshares"]
  }
}
