{
  "schema": "OscillatorRegistry@v1",
  "_comment": "One canonical name per oscillator, so a reading can always be traced to which oscillator and scope produced it. This is the source of truth for the Oscillator Affiliations panel, the alert prefixes, the Advisory Desk evidence, and the CIO wake tags. Do not hand-roll a second list.",
  "scopes": ["market", "style", "sector", "industry", "symbol"],
  "oscillators": [
    {
      "oscillator_id": "sector_momentum_rs",
      "display_name": "Sector Rotation",
      "scope": "sector",
      "formula": "RS(w) = sector w-day return - SPY w-day return",
      "windows": {"short": 5, "mid": 20, "long": 60, "slope_lookback_days": 5},
      "reading_name": "RS20",
      "states": ["LEADING", "WEAKENING", "LAGGING", "IMPROVING"],
      "state_rule": "LEADING: RS20>=0 & slope>=0; WEAKENING: RS20>=0 & slope<0; LAGGING: RS20<0 & slope<0; IMPROVING: RS20<0 & slope>=0",
      "producer": "scripts/sector_momentum_engine.py",
      "store": "sector_momentum_state",
      "snapshot": "data/runtime/sector_momentum_latest.json",
      "cadence": "25 17 * * 1-5",
      "alert_policy": {"enabled": true, "route": "IMMEDIATE", "debounce_days": 2, "max_per_day": 4}
    },
    {
      "oscillator_id": "style_spread",
      "display_name": "Style Rotation",
      "scope": "style",
      "formula": "RS(w) on pairs: growth/value (VUG-VTV), small/large (IWM-SPY), equal/cap (RSP-SPY)",
      "windows": {"short": 5, "mid": 20, "long": 60},
      "reading_name": "RS20",
      "states": ["LEADING", "WEAKENING", "LAGGING", "IMPROVING"],
      "state_rule": "same classify() as sector_momentum_rs, applied to STYLE:* rows",
      "producer": "scripts/sector_momentum_engine.py",
      "store": "sector_momentum_state (STYLE:* rows)",
      "snapshot": "data/runtime/sector_momentum_latest.json (market.styles)",
      "cadence": "25 17 * * 1-5",
      "alert_policy": {"enabled": true, "route": "IMMEDIATE", "debounce_days": 2, "max_per_day": 4}
    },
    {
      "oscillator_id": "sector_breadth_20dma",
      "display_name": "Sector Breadth",
      "scope": "sector",
      "formula": "percent of sector screener members with last close above 20-session average",
      "windows": {"dma": 20, "min_members": 8},
      "reading_name": "breadth_pct",
      "states": [],
      "state_rule": "no named states; numeric 0-100 surface",
      "producer": "scripts/sector_momentum_engine.py",
      "store": "sector_momentum_state.breadth_pct",
      "snapshot": "data/runtime/sector_momentum_latest.json",
      "cadence": "25 17 * * 1-5",
      "alert_policy": {"enabled": false, "route": "NONE", "note": "surfaces inside sector transition alert lines, never alerts standalone"}
    },
    {
      "oscillator_id": "sector_comovement",
      "display_name": "Sector Co-movement",
      "scope": "sector",
      "formula": "several tracked names in one sector moving materially the same day, each corroborated against an independent source",
      "windows": {"min_names": 3, "name_k": 4},
      "reading_name": "magnitude",
      "states": [],
      "state_rule": "numeric mean of per-name own-move ratios; K-times-own-move, never a fixed percent",
      "producer": "scripts/material_change_detector.py (sector_moves)",
      "store": "material_changes (kind=sector_move)",
      "snapshot": "material_changes",
      "cadence": "*/30 market hours (material_change_detector)",
      "alert_policy": {"enabled": true, "route": "IMMEDIATE", "note": "via notify_material_change; each name corroborated, NaN fires"}
    },
    {
      "oscillator_id": "industry_momentum_quadrant",
      "display_name": "Industry Momentum",
      "scope": "industry",
      "formula": "level = 1-month perf - SPY 21d; direction = 1-week perf - SPY 5d",
      "windows": {"level_days": 21, "direction_days": 5},
      "reading_name": "rel1m",
      "states": ["LEADING", "WEAKENING", "LAGGING", "IMPROVING"],
      "state_rule": "same classify() on level/direction",
      "producer": "scripts/finviz_industry_groups.py",
      "store": "industry_momentum_state",
      "snapshot": "data/runtime/industry_momentum_latest.json",
      "cadence": "30 12 * * 1-5 (refresh), 18 16 * * 1-5 (close+alerts)",
      "alert_policy": {"enabled": true, "route": "DIGEST", "debounce_days": 2, "max_per_day": 3}
    },
    {
      "oscillator_id": "small_cap_rotation",
      "display_name": "Small-Cap Rotation",
      "scope": "market",
      "formula": "IWM vs SPY relative strength; 1d >= 0.35% or 5d >= 1.2% or 20d >= 2.5%",
      "windows": {"short": 1, "mid": 5, "long": 20},
      "reading_name": "strength",
      "states": ["small_cap_outperform", "neutral"],
      "state_rule": "signal=small_cap_outperform when any threshold met, capped 0-1",
      "producer": "scripts/rotation_autopilot.py",
      "store": "data/runtime/rotation_autopilot_state.json",
      "snapshot": "data/runtime/rotation_autopilot_latest.json",
      "cadence": "*/15 4-16 * * 1-5",
      "alert_policy": {"enabled": true, "route": "IMMEDIATE", "note": "alerts on activate/fade transition only"}
    },
    {
      "oscillator_id": "rotation_ladders_rs",
      "display_name": "Sector RS Ladder",
      "scope": "sector",
      "formula": "weighted 21/63/126-day return, normalized to RS score 0-100",
      "windows": {"short": 21, "mid": 63, "long": 126},
      "reading_name": "rs_score",
      "states": [],
      "state_rule": "numeric 0-100; cio_sector_opportunity maps >=70 LEADING, >=55 IMPROVING",
      "producer": "scripts/lib/data_broker/rotation_ladders.py",
      "store": "state/data_broker/rotation_ladders.json",
      "snapshot": "state/data_broker/rotation_ladders.json",
      "cadence": "data-broker refresh (no dedicated cron line)",
      "alert_policy": {"enabled": false, "route": "NONE", "note": "evidence + Defense Desk rank only, never alerts standalone"}
    },
    {
      "oscillator_id": "confluence_v2",
      "display_name": "Indicator Confluence",
      "scope": "symbol",
      "formula": "family-capped weighted score of trend/momentum/volume indicators; momentum family = rsi, stochastic, macd, williams_r",
      "windows": {"rsi": 14, "stochastic_k": 14, "macd": [12, 26, 9], "williams_r": 14},
      "reading_name": "net_score",
      "states": ["BULLISH_STRONG", "BULLISH_CONDITIONAL", "BEARISH_STRONG", "BEARISH_CONDITIONAL", "MIXED", "NEUTRAL"],
      "state_rule": "STRONG requires >=3 independent families; CONDITIONAL requires 2; MIXED on family conflict",
      "producer": "scripts/indicator_engine.py (analyze_confluence_v2)",
      "store": "indicator_confluence_cache",
      "snapshot": "indicator_confluence_cache (full_result)",
      "cadence": "0 8 * * 1-5 (engine), 15 12 * * 1-5 (data broker refresh)",
      "alert_policy": {"enabled": true, "route": "DIGEST", "debounce": "alert_condition_state", "max_per_day": 5, "note": "fires only on a directional state transition requiring >=3 families; a single oscillator never alerts"}
    }
  ]
}
