{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeai:ReleaseDelegation@v1",
  "title": "ReleaseDelegation@v1",
  "description": "Operator-owned standing release delegation (Release Train v2, decision D1 2026-10-21). A policy record, not a credential. Loaded fail closed by scripts/lib/release_delegation.py, which also enforces the cross-field rules this schema cannot express (window id == start time, the forbidden-class words, the required-check floor). The real file lives on the host outside the repository; only config/release_train_delegation.example.json ships.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "delegation_id", "status", "repository", "environment", "revocation_epoch", "operator",
               "permitted_classes", "windows", "merge_freeze", "limits", "verification_policy"],
  "properties": {
    "schema": {"const": "ReleaseDelegation@v1"},
    "delegation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,63}$"},
    "status": {"enum": ["ACTIVE", "PAUSED", "REVOKED"]},
    "repository": {"const": "PatsKiller/tardeai"},
    "environment": {"enum": ["production"]},
    "revocation_epoch": {"type": "integer", "minimum": 1},
    "operator": {
      "type": "object",
      "required": ["github_login", "approved_at", "approved_via"],
      "properties": {
        "github_login": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "approved_via": {"enum": ["host_cli", "telegram"]}
      }
    },
    "permitted_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"}
    },
    "windows": {
      "type": "object",
      "required": ["timezone", "catch_up", "slots"],
      "properties": {
        "timezone": {"const": "America/New_York"},
        "catch_up": {"const": false},
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["window_id", "start_et", "duration_min", "enabled"],
            "properties": {
              "window_id": {"enum": ["0000", "0600", "0800", "1800"]},
              "start_et": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
              "duration_min": {"type": "integer", "minimum": 5, "maximum": 240},
              "enabled": {"type": "boolean"},
              "role": {"type": "string"},
              "latest_start_et": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
              "skip_on_macro_days": {"type": "boolean"}
            }
          }
        }
      }
    },
    "merge_freeze": {
      "type": "object",
      "required": ["starts_min_before_window", "ends", "applies_to"],
      "properties": {
        "starts_min_before_window": {"type": "integer", "minimum": 0, "maximum": 120},
        "ends": {"const": "train_terminal"},
        "applies_to": {"const": "all_non_train_merges_to_main"}
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_prs_per_train", "max_trains_per_window", "max_changed_files_per_train", "capability_ttl_s",
                   "max_attempts_per_capability", "named_services"],
      "properties": {
        "max_prs_per_train": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_trains_per_window": {"const": 1},
        "max_changed_files_per_train": {"type": "integer", "minimum": 1, "maximum": 5000},
        "capability_ttl_s": {"type": "integer", "minimum": 60, "maximum": 3600},
        "max_attempts_per_capability": {"type": "integer", "minimum": 1, "maximum": 3},
        "named_services": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\.service$"}}
      }
    },
    "verification_policy": {
      "type": "object",
      "required": ["required_checks", "batch_qualifier", "conclusion_required", "exact_sha",
                   "tree_equivalence_fallback", "post_promote", "rollback_on_failure", "latch_stop_on_rollback"],
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"},
                            "allOf": [{"contains": {"const": "cio-hardening"}},
                                      {"contains": {"const": "agent-governance"}},
                                      {"contains": {"const": "release-readiness"}}]},
        "batch_qualifier": {"const": "ci-gate"},
        "conclusion_required": {"const": "success"},
        "exact_sha": {"const": true},
        "tree_equivalence_fallback": {"const": false},
        "post_promote": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rollback_on_failure": {"const": true},
        "latch_stop_on_rollback": {"const": true}
      }
    },
    "notes": {"type": "string"},
    "phase": {"enum": ["shadow", "canary", "expand"],
              "description": "Optional rollout phase (arming finding 8). Only 'canary' admits an operator-forced off-window run, and only with the controller policy's canary flag; absent means no phase-gated behaviour."}
  }
}
