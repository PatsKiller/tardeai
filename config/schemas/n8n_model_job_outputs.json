{
 "schema": "N8nModelJobOutputSchemas@v1",
 "as_of": "2026-10-09",
 "note": "Output contracts for governed model jobs coordinated through n8n. Validated by scripts/lib/n8n_model_job.py with a built-in structural check (required keys, types, enums, max lengths); no jsonschema dependency on this host. A model answer that fails validation is a typed refusal, never a fallback.",
 "schemas": {
  "material_change_digest_draft/v1": {
   "description": "Nonfinancial digest DRAFT of already-detected material changes. The detector and eligibility stay in code; this text is never a send.",
   "required": [
    "headline",
    "items",
    "sources_cited",
    "confidence_note"
   ],
   "properties": {
    "headline": {
     "type": "string",
     "max_length": 160
    },
    "items": {
     "type": "array",
     "max_items": 12,
     "items": {
      "required": [
       "symbol",
       "change_guid",
       "summary"
      ],
      "properties": {
       "symbol": {
        "type": "string",
        "max_length": 12
       },
       "change_guid": {
        "type": "string",
        "max_length": 64
       },
       "summary": {
        "type": "string",
        "max_length": 400
       },
       "why_it_matters": {
        "type": "string",
        "max_length": 400
       }
      }
     }
    },
    "sources_cited": {
     "type": "array",
     "max_items": 40,
     "items": {
      "type": "string",
      "max_length": 200
     }
    },
    "confidence_note": {
     "type": "string",
     "max_length": 300
    },
    "recommendation": {
     "type": "string",
     "enum": [
      "NONE"
     ]
    }
   },
   "forbidden_keys": [
    "buy",
    "sell",
    "size",
    "order",
    "price_target",
    "position"
   ]
  },
  "ops_summary_draft/v1": {
   "description": "Weekly ops summary DRAFT from the lane governance packet receipt (LaneGovernancePacket@v1). Facts stay in the packet; this text is for a human reviewer and is never a send. Phase 2 PR-E 2026-10-08.",
   "required": [
    "headline",
    "sections",
    "open_items",
    "sources_cited",
    "confidence_note"
   ],
   "properties": {
    "headline": {
     "type": "string",
     "max_length": 160
    },
    "sections": {
     "type": "array",
     "max_items": 8,
     "items": {
      "required": [
       "area",
       "summary"
      ],
      "properties": {
       "area": {
        "type": "string",
        "max_length": 40
       },
       "summary": {
        "type": "string",
        "max_length": 600
       },
       "evidence_ids": {
        "type": "array",
        "max_items": 20,
        "items": {
         "type": "string",
         "max_length": 120
        }
       }
      }
     }
    },
    "open_items": {
     "type": "array",
     "max_items": 20,
     "items": {
      "type": "string",
      "max_length": 240
     }
    },
    "sources_cited": {
     "type": "array",
     "max_items": 40,
     "items": {
      "type": "string",
      "max_length": 200
     }
    },
    "confidence_note": {
     "type": "string",
     "max_length": 300
    },
    "recommendation": {
     "type": "string",
     "enum": [
      "NONE"
     ]
    }
   },
   "forbidden_keys": [
    "buy",
    "sell",
    "size",
    "order",
    "price_target",
    "position"
   ]
  },
  "lane_failure_explainer/v1": {
   "description": "Read-only explanation of why one lane failed. evidence cites receipt fields. recommendation is always NONE. authority is always READ_ONLY_ADVISORY.",
   "required": [
    "lane_id",
    "likely_cause",
    "evidence",
    "next_check",
    "confidence",
    "recommendation",
    "authority"
   ],
   "properties": {
    "lane_id": {
     "type": "string",
     "max_length": 80
    },
    "likely_cause": {
     "type": "string",
     "max_length": 600
    },
    "evidence": {
     "type": "array",
     "max_items": 10,
     "items": {
      "required": [
       "receipt_field"
      ],
      "properties": {
       "receipt_field": {
        "type": "string",
        "enum": [
         "state",
         "exit_code",
         "duration_s",
         "stderr_tail",
         "output_signal_age_s"
        ]
       },
       "detail": {
        "type": "string",
        "max_length": 400
       }
      }
     }
    },
    "next_check": {
     "type": "string",
     "max_length": 300
    },
    "confidence": {
     "type": "string",
     "max_length": 32
    },
    "recommendation": {
     "type": "string",
     "enum": [
      "NONE"
     ]
    },
    "authority": {
     "type": "string",
     "enum": [
      "READ_ONLY_ADVISORY"
     ]
    }
   },
   "forbidden_keys": [
    "size",
    "qty",
    "order",
    "stop",
    "limit",
    "weight",
    "trade"
   ]
  }
 }
}
