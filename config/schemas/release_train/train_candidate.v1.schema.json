{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradeai:release-train/TrainCandidate.schema.json",
  "title": "TrainCandidate@v1",
  "description": "A frozen train: base main SHA, full PR heads in dependency order, policy and classifier versions and the required-check manifest (enhanced design section 4 'Selected and frozen'). New PR commits supersede the selection. Program rules: unique members; order is 1..n; every dependency names a member and the graph is acyclic and respects order; a needs_operator member carries ride_approval_ref; held/blocked never ride.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "train_id",
    "window_id",
    "repo",
    "base_sha",
    "members",
    "dependency_graph",
    "policy_version",
    "classifier_version",
    "check_manifest",
    "frozen_at",
    "candidate_sha"
  ],
  "properties": {
    "schema": {
      "const": "TrainCandidate@v1"
    },
    "train_id": {
      "type": "string",
      "pattern": "^rt-[0-9]{8}-[0-9]{4}-[a-z0-9]{4,12}$"
    },
    "window_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(00|06|08|18):00[+-][0-9]{2}:[0-9]{2}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "uniqueItems": true,
        "maxItems": 200
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "classifier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "check_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "candidate_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr_number",
        "head_sha",
        "risk_class",
        "order"
      ],
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "risk_class": {
          "enum": [
            "eligible",
            "needs_operator"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "ride_approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    }
  }
}
