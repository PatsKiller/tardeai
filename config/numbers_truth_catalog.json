{
  "schema": "NumbersTruthCatalog@v1",
  "as_of": "2026-11-09",
  "_why": "DSN-20261109-numbers-truth-audit.md \u00a71 (rev 1) aligned by REV 2 (truth sources, current nav pages, no duplicates) and REV 3 (the authority family G1-G3). One row per displayed figure: the surface it is served from (API path + JSON pointer, or runtime artifact + key) and the truth it must agree with. scripts/numbers_truth_audit.py grades each row read-only and emits the findings list M in its LaneRunReceipt@v2 (LQ-1702 consumes M for strikes/heal/ticket/escalation). A row for a route that is not in lib/navConfig.ts fails the CI gate tests/test_numbers_truth_audit_20261109.py.",
  "nav_config": "apps/command-center-v3/src/lib/navConfig.ts",
  "codes": [
    "NT_QTY_MISMATCH",
    "NT_VALUE_MISMATCH",
    "NT_PRICE_MISMATCH",
    "NT_TOTAL_MISMATCH",
    "NT_ACCOUNT_TOTAL_MISMATCH",
    "NT_DAY_PNL_SPLIT",
    "NT_STOP_PRICE_MISMATCH",
    "NT_STOP_QTY_MISMATCH",
    "NT_STOP_STATE_MISMATCH",
    "NT_STOP_CROSS_CHECK",
    "NT_UNPROTECTED",
    "NT_SESSION_LABEL",
    "NT_QUOTE_SOURCE",
    "NT_AUTHORITY_WRITE",
    "NT_AUTHORITY_STATIC",
    "NT_NOT_MEASURED"
  ],
  "_codes_note": "The closed code set. Every emitted code is validated against this list by the tests; NT_NOT_MEASURED is the only status-bearing code and always means an unreadable side.",
  "policy": {
    "session_et": {
      "start": "09:30",
      "end": "16:15",
      "_note": "the in-session gate for freshness bounds; identical to desk_truth_monitor's display-truth window"
    },
    "sources": {
      "quotes": {
        "allowed": [
          "alpaca",
          "finviz"
        ],
        "allowed_prefixes": [
          "refresh:schwab"
        ],
        "never": [
          "yfinance"
        ],
        "_note": "REV 2 A: market_quotes WHERE source IN ('alpaca','finviz') OR source LIKE 'refresh:%schwab%'; never yfinance. ticker_prices is NOT a truth source (LQ-1695)."
      }
    },
    "brief": {
      "artifact": "data/runtime/cio_overnight_brief/latest.json",
      "_note": "the CIO overnight brief the pages read; last_close.session_date is the authoritative session day"
    },
    "coverage": {
      "working_lifecycles": [
        "working",
        "near_trigger"
      ],
      "snapshot_stale_after_h": 0.25,
      "min_position_value_usd": 1000.0,
      "exclude_asset_types": [
        "option"
      ],
      "paper_accounts": [],
      "exempt": [],
      "account_aliases": {
        "schwab_roth": "schwab_roth_ira"
      },
      "_note": "Handed verbatim to desk_truth_monitor.held_exit_coverage (REV 2 C: reuse, do not write new coverage SQL). snapshot_stale_after_h 0.25 = broker_stops freshness_sla 10 min with slack; a stale snapshot is NOT_MEASURED, never 'unprotected'."
    },
    "domains": {
      "quote_price": {
        "table": "market_quotes",
        "writer": "scripts/lib/writers/market_quotes.py",
        "producer_lane": "market-quotes",
        "allowed_sources": [
          "alpaca",
          "finviz",
          "finviz_elite",
          "refresh:schwab",
          "schwab"
        ],
        "never_sources": [
          "yfinance",
          "yahoo",
          "ticker_prices"
        ],
        "_note": "REV 2 A. finviz_elite is the label the CIO brief stamps on a Finviz-sourced mark; it is the same provider, not a second source."
      },
      "positions_store": {
        "table": "positions_current",
        "writer": "scripts/positions_sync.py",
        "producer_lane": "positions-sync",
        "allowed_sources": [
          "schwab",
          "schwab_api",
          "moomoo",
          "alpaca"
        ],
        "never_sources": []
      },
      "broker_stops": {
        "table": "stop_lifecycle",
        "writer": "scripts/stop_lifecycle_monitor.py",
        "producer_lane": "stop-health-check",
        "_note": "REV 2 A: the latest stop_lifecycle snapshot is canonical; stop_last_known is a retiring copy and is cross-checked, never truth."
      }
    },
    "write_watch": {
      "quote_price": {
        "table": "market_quotes",
        "time_col": "fetched_at",
        "provider_col": "source",
        "declared_sources": [
          "alpaca",
          "finviz",
          "refresh:schwab",
          "schwab"
        ],
        "never_sources": [
          "yfinance",
          "yahoo"
        ],
        "producer_lane": "market-quotes",
        "_note": "G2. First measured instance (REV 2 A): 625 market_quotes rows written by the retired yfinance provider in 6 h."
      },
      "positions_store": {
        "table": "positions_current",
        "time_col": "as_of",
        "provider_col": "source",
        "declared_sources": [
          "schwab",
          "schwab_api",
          "moomoo",
          "alpaca",
          "schwab_positions"
        ],
        "never_sources": [],
        "producer_lane": "positions-sync",
        "_note": "G2 for the positions writer. Empty result is a pass; a provider outside the list is a finding.",
        "declared_prefixes": [
          "schwab",
          "moomoo",
          "alpaca"
        ]
      }
    },
    "authority": {
      "gate": "scripts/check_data_source_authority.py",
      "file": "config/data_source_authority.json",
      "_note": "G1 runs the gate with --json at this code root (the live release's HEAD) each hour; its findings are M entries with fingerprint authority|rule|file."
    },
    "http": {
      "window_start_et": "04:00",
      "window_end_et": "16:15",
      "_note": "AGENTS.md \u00a728.8: no HTTP to :7777 on a weekday inside this window. Inside it the audit reads the served artifacts the API reads; an api-only row is NOT_MEASURED with reason in_window_artifact_only."
    },
    "max_findings": 200
  },
  "rows": [
    {
      "page": "/",
      "figure_id": "overview.portfolio_value",
      "label": "Portfolio total (Home header)",
      "domain": "positions_store",
      "producer_lane": "positions-sync",
      "severity": "P1",
      "check": "book_total",
      "served_from": {
        "kind": "api",
        "path": "/api/v2/overview",
        "value": [
          "/portfolio_value",
          "/derived_total_value"
        ]
      },
      "truth": {
        "provider": "positions_current",
        "fresh_min_in_session": 35
      },
      "tolerance": {
        "kind": "abs",
        "value": 1.0,
        "unit": " USD"
      },
      "_note": "REV 2 A: positions_current as_of <= 35 min in session, else NOT_MEASURED. Sum = non-cash broker_market_value + cash rows' dollar balance."
    },
    {
      "page": "/",
      "figure_id": "overview.account_total",
      "label": "Account totals (Home accounts rows)",
      "domain": "positions_store",
      "producer_lane": "positions-sync",
      "severity": "P1",
      "check": "account_total",
      "served_from": {
        "kind": "api",
        "path": "/api/v2/overview",
        "rows": "/portfolio_aggregate/accounts",
        "key": [
          "/account",
          "/account_id"
        ],
        "value": [
          "/display_value",
          "/total_value"
