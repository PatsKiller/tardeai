FROM gemma3:27b

# gemma3-overnight — conservative batch classification model
# Phase 1B: BATCH_OVERNIGHT process type only
# Created: 2026-05-11
#
# Note: keep_alive=0 is passed at request time by the lifecycle wrapper
# (cooldown function), not set here. Modelfile parameters are model defaults.

# Conservative context — 4096 is sufficient for classification prompts
PARAMETER num_ctx 4096

# Classification-focused generation limits
PARAMETER num_predict 500
PARAMETER temperature 0.2
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1

SYSTEM """You are a concise financial classification assistant. Respond with structured data only. Do not include preamble, caveats, or disclaimers. Be direct and factual."""
