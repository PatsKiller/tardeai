{
  "version": "2.0",
  "description": "Machine-readable staleness recovery runbook — all failure types with signatures, diagnostics, remediation, and circuit breakers.",
  "runbooks": {
    "cio_decisions_stale": {
      "signature": "cio_decisions.max(created_at) > 48h AND is_weekday",
      "severity": "P2",
      "causes": ["upstream_signal_empty", "env_symlink_race", "db_connection_failure", "empty_signal_flow_audit"],
      "diagnostics": ["tail -50 logs/cio_decisions.log", "SELECT COUNT(*) FROM signal_flow_audit WHERE created_at > now() - interval '7 days'"],
      "remediation": {
        "script": "cio_decision_engine.py --run",
        "env": "source $TRADEAI_ENV",
        "timeout_s": 300,
        "risk": "LOW",
        "idempotent": true
      },
      "validation": "cio_decisions has row with created_at > now() - 1h",
      "circuit_breaker": {"max_failures": 3, "cooldown_min": 60}
    },
    "trade_closed_stale": {
      "signature": "trade_closed.max(close_date) > 7d",
      "severity": "P2",
      "causes": ["schwab_journal_builder_stalled", "schwab_transaction_ingest_stalled", "schwab_api_rate_limit"],
      "diagnostics": ["tail -50 logs/schwab_ingest.log", "check if schwab_journal_builder cron is firing"],
      "remediation": {
        "script": "schwab_journal_builder.py --apply && schwab_transaction_ingest.py --apply",
        "env": "source $TRADEAI_ENV",
        "timeout_s": 300,
        "risk": "LOW",
        "idempotent": true
      },
      "validation": "trade_closed has max(close_date) within last 24h",
      "circuit_breaker": {"max_failures": 3, "cooldown_min": 60}
    },
    "orchestrator_setups_stale": {
      "signature": "screener_pm.log age > 24h",
      "severity": "P2",
      "causes": ["safe_flock_killed_it", "OOM", "ollama_stuck", "underfilled_run"],
      "diagnostics": ["tail -100 logs/screener_pm.log | grep -i 'Terminated\\|OOM\\|killed'", "check orchestrator cron"],
      "remediation": {
        "script": "trade_ai_orchestrator.py --run-label AUTOHEAL --no-llm --allow-underfilled",
        "env": "source $TRADEAI_ENV",
        "timeout_s": 600,
        "risk": "LOW",
        "idempotent": true
      },
      "validation": "screener_pm.log updated within last 6h",
      "circuit_breaker": {"max_failures": 3, "cooldown_min": 120}
    },
    "shadow_batch_stale": {
