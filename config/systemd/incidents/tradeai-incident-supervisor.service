# Incident supervisor every 10 minutes: governed triage (<= $1/day), allowlisted runbook actions, section 28.14 fixer dispatch (PR only), one P1 per incident. Never merges or promotes.
# Host timer, not n8n (AGENTS.md §28.14 item 1, §23.14). Install: docs/ops/INCIDENT_LEDGER.md §Install.

[Unit]
Description=Trade AI incident supervisor (governed triage, allowlisted actions)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
Environment=PYTHONPATH=%h/trade-ai-releases/portfolio-server/CURRENT:%h/trade-ai-releases/portfolio-server/CURRENT/scripts
EnvironmentFile=-/run/user/%U/tradeai/env
Environment=PROJ=%h/trade-ai-releases/portfolio-server/CURRENT
Environment=TRADEAI_STATE_ROOT=%h/trade-ai-releases/persistent-state
Environment=TMPDIR=%h/.cache/agent-tmp/incident-units
ExecStartPre=/usr/bin/mkdir -p %h/.cache/agent-tmp/incident-units
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python %h/trade-ai-releases/portfolio-server/CURRENT/scripts/incident_supervisor.py --apply
Nice=10
# 8100s = the fixer dispatch timeout (7500s, config/incident_runbook_actions.json) + 600s margin.
# The old 3900s killed the supervisor, and its fixer child, before a legitimate long fix returned --
# so no attempt row was written and the next cycle could re-dispatch (2026-11-03).
TimeoutStartSec=8100

[Install]
WantedBy=default.target
