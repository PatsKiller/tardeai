ACTIVE_TRADER_MOTION_JOURNAL=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader/motion_journal.jsonl
ACTIVE_TRADER_MOTION_STATE=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader/motion_runtime_state.json
ACTIVE_TRADER_MOTION_HEARTBEAT=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader/motion_runtime_heartbeat.json
ACTIVE_TRADER_MOTION_LOCK=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader/motion_runtime.lock
ACTIVE_TRADER_MOTION_MAX_JOURNAL_LINES=5000
ACTIVE_TRADER_MOTION_ACTIVE_CADENCE_S=5
ACTIVE_TRADER_MOTION_NEAR_FIRE_CADENCE_S=10
