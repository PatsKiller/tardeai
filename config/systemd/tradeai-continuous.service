[Unit]
Description=TradeAI Continuous Scanner
# Boot hardening (2026-07-04): the Persistent=true timer catch-up fired at boot
# (Jul 3 12:31) and the launcher died in 19ms with no output — /home not fully
# ready. Gate on the mount and retry on failure instead of silently missing a day.
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/johnclaw/trade-ai-releases
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=johnclaw
# 2026-09-28: run from the served release like every cron lane (audit C-02); logs to persistent-state.
WorkingDirectory=/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/linux_launchers/run_continuous.sh
StandardOutput=append:/home/johnclaw/trade-ai-releases/persistent-state/logs/tradeai-continuous.log
StandardError=inherit
# Normal end-of-day shutdown exits 0 (never restarted); early crashes retry.
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
