[Unit]
Description=TradeAI Active Trader motion observation producer
After=network.target portfolio-server.service
# Default-disabled safety gate. Enabling the unit alone is insufficient; an operator
# must deliberately create this marker after completing the data-only host proof.
# 2026-10-19 (operator): the marker is root-owned under /etc/tradeai, beside agent_runtime_enabled, so only the
# operator (sudo) can arm the producer; AGENTS.md §24.10 item 4 keeps an /etc flag operator-only. The installed copy
# (2026-10-10) still named a misspelt /etc directory that never existed (r and a transposed), so the unit could not
# start after its clean stop on 2026-10-10 21:43 ET. The env file stays the user-owned %h/.config/tradeai/active-trader-motion.env:
# it exists on the host and sets the heartbeat/journal paths (config/lane_registry.json motion row evidence_ref).
# Supervised from n8n by lane active-trader-motion-watchdog (scripts/check_active_trader_motion_heartbeat.py),
# which never restarts anything. Install: docs/ops/packets/active-trader-motion-n8n-20261019/cutover.sh.
ConditionPathExists=/etc/tradeai/enable-active-trader-motion

[Service]
Type=simple
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=HOME=/home/johnclaw
Environment=PYTHONPATH=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/scripts
EnvironmentFile=-%h/.config/tradeai/active-trader-motion.env
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python -m active_trader.motion_runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader /home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs
StandardOutput=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/active_trader_motion.log
StandardError=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/active_trader_motion.log

[Install]
WantedBy=default.target
