[Unit]
Description=TradeAI Active Trader motion observation producer
After=network.target portfolio-server.service
# Default-disabled safety gate. Enabling the unit alone is insufficient; an operator
# must deliberately create this marker after completing the data-only host proof.
ConditionPathExists=/etc/tardeai/enable-active-trader-motion

[Service]
Type=simple
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=HOME=/home/johnclaw
Environment=PYTHONPATH=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/scripts
EnvironmentFile=-/etc/tardeai/active-trader-motion.env
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python -m active_trader.motion_runtime
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/data/active_trader /home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs
StandardOutput=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/active_trader_motion.log
StandardError=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/active_trader_motion.log

[Install]
WantedBy=default.target
