[Unit]
Description=TradeAI dedicated Moomoo L2 gateway (read-only, single OpenD owner)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/tradeai/ENABLE_MOOMOO_L2_GATEWAY

[Service]
Type=simple
User=johnclaw
Group=johnclaw
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=PYTHONUNBUFFERED=1
Environment=MOOMOO_L2_GATEWAY_CONFIG=/etc/tradeai/moomoo_l2_gateway.yaml
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/moomoo/gateway_service.py --config /etc/tradeai/moomoo_l2_gateway.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/johnclaw/.tradeai/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
