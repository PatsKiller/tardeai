[Unit]
Description=Trade AI organic stance observe early — 06:35 ET Mon–Fri
Documentation=file:///home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/scripts/report_organic_stance_hold.py

[Timer]
# After social_scalp_scanner 06:00/06:30 fires; before market open.
# Host local time is America/New_York.
OnCalendar=Mon..Fri *-*-* 06:35:00
AccuracySec=1min
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
