[Unit]
Description=Trade AI LIVE-cio-stance-governance observe early — 06:35 ET daily (24/7)
Documentation=file:///home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/scripts/report_organic_stance_hold.py
Documentation=file:///home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/docs/ops/LIVE_CIO_STANCE_GOVERNANCE_2026-09-21.md

[Timer]
# Daily (Mon–Sun). After social_scalp early window on weekdays; remasures any
# overnight/weekend organic holds under 24/7 definition.
# Host local time is America/New_York.
# Explicit Unit= — basename ends in -early, so default would miss the service.
Unit=tradeai-stance-organic-observe.service
OnCalendar=*-*-* 06:35:00
AccuracySec=1min
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
