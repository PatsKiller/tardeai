[Unit]
Description=Trade AI end-of-day consolidated close sync — weekday evening
Documentation=file:///home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/scripts/eod_consolidated_close_sync.py

[Timer]
# 17:15 ET weekdays: after the 16:00 close, the 16:10 repricer and the last
# intraday quote cycle; before the overnight jobs build RSI / SMA / levels, and
# well before the 07:45 litmus that checks the session.
OnCalendar=Mon..Fri *-*-* 17:15:00
AccuracySec=1min
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
