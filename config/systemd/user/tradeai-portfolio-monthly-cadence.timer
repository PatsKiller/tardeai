[Unit]
# Measured 2026-10-08 (systemctl --user cat / show): OnCalendar=*-*-01 07:35:00, Persistent=true, no RandomizedDelaySec,
# enabled, next elapse Sun 2026-11-01 07:35 EST. The schedule is preserved exactly; only the service it starts moves from
# the dev tree to the served CURRENT tree. Installed by the operator under a config-write grant (install -m 0600
# copy, daemon-reload, restart of this timer); this file installs nothing.
Description=TradeAI portfolio MONTHLY report cadence schedule (day-1 07:35 — after legacy 07:05, parallel observation)

[Timer]
OnCalendar=*-*-01 07:35:00
Persistent=true

[Install]
WantedBy=timers.target
