# PROPOSAL ONLY. Not installed. Do not systemctl enable without a production
# service grant (plan tranche B, 2026-10-07). The HMAC key is NOT in this file.
# 2026-10-07 roadmap Phase 1: the key is created in Bitwarden SM (project
# trade-ai-prod) as TRADEAI_N8N_GATEWAY_HMAC_KEY (and _PREVIOUS for rotation);
# scripts/secrets/render_env.py already delivers every shell-exportable SM key
# to %t/tradeai/env (0600, tmpfs, re-rendered every 4h), so no second render
# path and no hand-written env file. The optional ~/.config/tradeai/n8n-gateway.env
# stays as an override for a lab-only key. Without a key the gateway refuses to bind.
#
# Loopback only; port 18091 is outside the gateway's blocked set and no other
# Trade AI, DOF, Postgres or n8n service listens there.

[Unit]
Description=Trade AI n8n coordination gateway on 127.0.0.1:18091 (proposal only, not installed)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
EnvironmentFile=-%t/tradeai/env
EnvironmentFile=-%h/.config/tradeai/n8n-gateway.env
Environment=TRADEAI_STATE_ROOT=%h/trade-ai-releases/persistent-state
Environment=TRADEAI_N8N_GATEWAY_EXTRA_LANES=incident-fanin
ExecStart=/bin/bash %h/trade-ai-releases/portfolio-server/CURRENT/scripts/n8n_coordination_gateway_run.sh
Restart=on-failure
RestartSec=10
Nice=10
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=default.target
