[Unit]
Description=Enqueue risk_agent/tax_agent jobs for holdings (advisory desk evidence)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=PATH=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin:/usr/bin
Environment=HOME=/home/johnclaw
# Paid Flash narratives require a configured global cap (validate_paid_cap_config).
Environment=LLM_GLOBAL_DAILY_USD_CAP=0.25
EnvironmentFile=-%t/tradeai/env
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/enqueue_holdings_agent_opinions.py --apply
Nice=10
StandardOutput=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/holdings_agent_enqueue.log
StandardError=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/holdings_agent_enqueue.log

[Install]
WantedBy=default.target
