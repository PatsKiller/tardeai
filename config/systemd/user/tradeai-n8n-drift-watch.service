# Lane n8n-workflow-drift-check (config/lane_registry.json). Promoted 2026-10-27 from the reviewed packet copy
# docs/ops/packets/n8n-platform-hardening-20261022/units/tradeai-n8n-drift-watch.service.proposed (step FW-P3); the
# directives are identical (tests/test_n8n_drift_check_schedule_20261027.py pins it). Install is a host step after
# merge and deploy; the cron freeze (operator 2026-10-09) means no crontab line. The registry row stays PAUSED until
# `systemctl --user list-timers` shows this timer, then flips to ACTIVE in a registry PR.
# AGENTS §23.23 governance (2) / §23.24 Logging (5): the n8n workflow-drift check runs on a host schedule, outside
# n8n, and pages P1 on drift through the host SYSTEM ops transport (send_system), never through n8n or the fan-in.
# Writes data/runtime/n8n_workflow_drift_last.json (N8nWorkflowDriftReceipt@v1, the lane's output_signal) and
# n8n_drift_watch_last.json (N8nDriftWatch@v1). One SELECT on the n8n DB; no n8n write. Dry run first:
# python3 scripts/n8n_drift_watch.py (no --live).
[Unit]
Description=Trade AI n8n workflow drift watch (host schedule, P1 on drift) - FW-P3
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
# The ops bot name/chat for send_system (SYSTEM ops family) only: TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID, mode 0600.
# Not the full .env or the secrets render: this unit needs no broker, database or provider credential.
EnvironmentFile=-%h/.config/tradeai/n8n/host-alert.env
Environment=TRADEAI_STATE_ROOT=%h/trade-ai-releases/persistent-state
Environment=SYSTEM_TELEGRAM_ENABLED=1
Environment=CIO_TELEGRAM_INTERDICT=1
ExecStart=/usr/bin/flock -n /tmp/tradeai-n8n-drift-watch.lock %h/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python %h/trade-ai-releases/portfolio-server/CURRENT/scripts/n8n_drift_watch.py --live
# exit 1 = drift found and paged (the page is the alert); exit 2 = cannot run (unit fails; receipt says CANNOT_RUN)
SuccessExitStatus=1
Nice=10
MemoryMax=256M
CPUQuota=25%
TimeoutStartSec=120
