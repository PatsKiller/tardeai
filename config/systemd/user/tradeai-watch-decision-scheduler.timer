[Unit]
Description=Trade AI watch decision scheduler (weekday RTH + weekend operator desks)

[Timer]
# Weekday RTH — primary decision cadence
OnCalendar=Mon..Fri *-*-* 09:35:00
OnCalendar=Mon..Fri *-*-* 11:00:00
OnCalendar=Mon..Fri *-*-* 13:30:00
OnCalendar=Mon..Fri *-*-* 15:45:00
# Weekend — operators review MAIN / Re-Entry; rebuild NOT RUN tickets + free critics
OnCalendar=Sat,Sun *-*-* 09:00:00
OnCalendar=Sat,Sun *-*-* 14:00:00
Persistent=true
Unit=tradeai-watch-decision-scheduler.service

[Install]
WantedBy=timers.target
