[Unit]
Description=Hermes Autonomous Research Loop — DeepSeek official off-peak cadence

[Timer]
# Official DeepSeek off-peak ∩ US night/pre-market (America/New_York):
#   00:00-02:00 and 06:00-09:00 ET.
# Do NOT fire 21:00 ET or 02:30 ET — those are official peak
# (01:00-04:00 and 06:00-10:00 UTC).
OnCalendar=*-*-* 00,01,06,07,08:10:00 America/New_York
Persistent=true
RandomizedDelaySec=60
AccuracySec=1min

[Install]
WantedBy=timers.target
