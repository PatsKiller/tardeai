[Unit]
Description=Hermes Autonomous Research Loop — DeepSeek China-night off-peak

[Timer]
# Cheapest DeepSeek = China night (official off-peak).
# Peak is Beijing 09:00-12:00 and 14:00-18:00.
# China night 18:00-09:00 Asia/Shanghai = 10:00-01:00 UTC (half price).
# Do not fire Beijing 09-12 or 14-18.
OnCalendar=*-*-* 18,19,20,21,22,23,00,01,02,03,04,05,06,07,08:10:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=60
AccuracySec=1min

[Install]
WantedBy=timers.target
