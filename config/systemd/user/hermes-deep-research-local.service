[Unit]
Description=Hermes Deep Research — governed cloud lane (advisory, staging-only)
After=network-online.target cio-governed-bridge.service

[Service]
Type=oneshot
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/hermes_deep_research_local.py --apply --max-rows 3 --model chatgpt
TimeoutStartSec=3600
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_BRIDGE_URL=http://127.0.0.1:8766
Environment=HERMES_BRIDGE_MODEL=deepseek-v4-flash
