[Unit]
Description=Trade AI Hermes CIO research worker (bounded drain, READ_ONLY_ADVISORY)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT
Environment=PYTHONPATH=/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/scripts
Environment=PATH=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin:/usr/bin
Environment=HOME=/home/johnclaw
Environment=HERMES_BACKEND=catalyst
# Bound: at most 2 jobs per tick. Circuit breaker refuses calls when OPEN.
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/hermes_cio_worker.py --drain --max 2 --json
Nice=10
TimeoutStartSec=240
StandardOutput=append:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/logs/hermes_cio_worker.log
StandardError=append:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/logs/hermes_cio_worker.log

[Install]
WantedBy=default.target
