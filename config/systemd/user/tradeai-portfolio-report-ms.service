[Unit]
Description=Trade AI Morgan Stanley-style portfolio report (PDF + email + Telegram, READ_ONLY)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild
Environment=PATH=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin:/usr/bin
Environment=HOME=/home/johnclaw
EnvironmentFile=-%t/tradeai/env
EnvironmentFile=-%h/.config/tradeai/advisory-shadow.env
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/portfolio_report_ms.py
Nice=10
StandardOutput=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/portfolio_report_ms.log
StandardError=append:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/logs/portfolio_report_ms.log

[Install]
WantedBy=default.target
