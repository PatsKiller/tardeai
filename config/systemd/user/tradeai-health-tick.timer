# PROPOSAL ONLY. Not installed. Do not systemctl enable without a production
# scheduler (config-write) grant. Fires every 5 minutes on the wall-clock grid
# (*:0/5) so the step table's minute phases (:00 :15 :20 :25 :30 …) line up with
# the crontab lines it replaces. AccuracySec is tight for the same reason.

[Unit]
Description=Trade AI health tick every 5 minutes (proposal only, not installed)

[Timer]
OnCalendar=*:0/5
AccuracySec=15s
Persistent=false
Unit=tradeai-health-tick.service

[Install]
WantedBy=timers.target
