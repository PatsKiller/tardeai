[Unit]
Description=Trade AI Global Intelligence Record projector (incremental; zero authority)
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
Environment=PYTHONPATH=%h/trade-ai-releases/portfolio-server/CURRENT:%h/trade-ai-releases/portfolio-server/CURRENT/scripts
Environment=MEMORY_BEHAVIOR_INFLUENCE=0
Environment=TRADEAI_GIR_DB_SOURCES=1
EnvironmentFile=-/run/user/%U/tradeai/env
EnvironmentFile=-%h/.config/tradeai/cio-operator-live.env
ExecStart=%h/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/gir_projector.py --incremental --apply --state %h/trade-ai-releases/persistent-state/data/runtime/gir_projector_state.json
Nice=15
TimeoutStartSec=20min
# READ_ONLY_ADVISORY — writes only the intelligence.* projection tables (needs the migration + roles);
# exits 3 when the schema is absent. Canonical stores are never written.
# Approval: pkg-20260927-cogx-w1-d9e1 items 3 and 6.

[Install]
WantedBy=default.target
