[Unit]
Description=Trade AI CIO Governed Model Bridge (DeepSeek caps on :8766)
Documentation=docs/architecture/GOVERNED_MODEL_BRIDGE.md
After=network-online.target tradeai-sm-render.service
Wants=network-online.target tradeai-sm-render.service

[Service]
Type=simple
# Resolve against the served release, not the hub checkout. Promote restarts this
# unit (TRADEAI_CURRENT_BOUND_UNITS) so the process re-resolves CURRENT after the
# symlink moves. Without that restart, WorkingDirectory=CURRENT still freezes on
# the pre-promote concrete path (observed 2026-09-18: bridge on 0162d0f19 while
# portfolio-server served 71535687d).
WorkingDirectory=/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT
# Secrets from Bitwarden SM tmpfs render — never hardcode keys here.
EnvironmentFile=-%t/tradeai/env
Environment=CIO_BRIDGE_MODE=canary
Environment=CIO_BRIDGE_PORT=8766
Environment=CIO_BRIDGE_HOST=127.0.0.1
Environment=PYTHONPATH=/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/scripts
Environment=PATH=/home/johnclaw/.local/bin:/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin:/usr/bin
Environment=HOME=/home/johnclaw
Environment=XDG_RUNTIME_DIR=%t
# Global daily cap — host drop-in 99-llm-global-cap.conf overrides to the ratified
# $2.00/day actual-spend ceiling (AGENTS.md §12). Keep a non-zero fallback here.
Environment=LLM_GLOBAL_DAILY_USD_CAP=0.50
ExecStart=/home/johnclaw/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/lib/cio_governed_model_bridge.py
Restart=on-failure
RestartSec=5
# Localhost-only server. 2026-09-14: threaded bridge hit 256M 40,579 times in its
# first hour; host drop-in 90-memory.conf applied the same value live.
MemoryMax=768M
StandardOutput=append:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/logs/cio_governed_bridge.log
StandardError=append:/home/johnclaw/trade-ai-releases/portfolio-server/CURRENT/logs/cio_governed_bridge.log

[Install]
WantedBy=default.target
