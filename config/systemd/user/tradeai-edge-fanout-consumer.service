[Unit]
Description=Trade AI edge fan-out consumer (memory.delta / thesis.changed → graph traversal → work items; zero authority)
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
Environment=PYTHONPATH=%h/trade-ai-releases/portfolio-server/CURRENT:%h/trade-ai-releases/portfolio-server/CURRENT/scripts
Environment=MEMORY_BEHAVIOR_INFLUENCE=0
EnvironmentFile=-/run/user/%U/tradeai/env
EnvironmentFile=-%h/.config/tradeai/cio-operator-live.env
ExecStart=%h/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python scripts/edge_fanout_consumer.py --apply
Nice=15
TimeoutStartSec=10min
# READ_ONLY_ADVISORY — reads intelligence.gir_edge, appends data/cio/edge_fanout_work_items.jsonl and the
# projector dirty file, advances its own bus cursor. Canonical stores are never written.
# Approval: pkg-20260928-wave-2-enforcement-35c4 items 3 and 4.

[Install]
WantedBy=default.target
