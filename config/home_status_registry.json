{
  "schema": "HomeStatusRegistry@v1",
  "version": "2026-11-11.1",
  "task": "LQ-20261107-2149 / LQ-20261107-2150",
  "comment": [
    "Cause / Source / Owner registry for Home v010 (LQ-20261107-2149). source -> owner -> cause category.",
    "An owner is taken from config/lane_registry.json when owner_lane is set (an explicit owner must agree); otherwise it is stated here.",
    "A source whose probe.kind is none has no production source yet: its widgets read UNKNOWN with needs_backend, never 0 and never OK."
  ],
  "causes": {
    "DATA_STALENESS": "The source has not been written within its threshold.",
    "STOP_MONITORING": "The stop store has not been refreshed within its threshold.",
    "NO_SOURCE": "No production source exists for this widget yet (engineering work is filed).",
    "READ_FAILURE": "The source exists but the read failed; the last good value and its age are shown.",
    "READ_TIMEOUT": "The source did not answer within the probe timeout.",
    "SESSION_CLOSED": "The source is not expected to update in this market session.",
    "COLLECTOR_STALE": "The diagnostics collector itself has not run within its limit, so no row can be graded."
  },
  "owners": {
    "defense": "defense desk (stop-health-check)",
    "portfolio": "portfolio desk (positions-sync)",
    "platform": "platform (quote and deploy lanes)",
    "comms": "comms (alerting)",
    "cio": "cio (since-close, trade-ready)",
    "os": "os (operating system / scheduler program)"
  },
  "sessions": {
    "rth": "regular trading hours, NYSE trading day, 09:30-16:00 ET (early closes honoured)",
    "extended": "trading day, 04:00-09:30 and 16:00-20:00 ET",
    "closed": "overnight, weekend or market holiday"
  },
  "sources": [
    {
      "source_id": "stop_store",
      "label": "stop store",
      "owner_lane": "stop-health-check",
      "cause_category": "STOP_MONITORING",
      "probe": {
        "kind": "db_max",
        "table": "stop_last_known",
        "column": "captured_at"
      }
    },
    {
      "source_id": "approval_queue",
      "label": "approval queues",
      "owner": "platform",
      "owner_lane": null,
      "cause_category": "READ_FAILURE",
      "probe": {
        "kind": "db_live",
        "table": "trade_approvals",
        "last_event_column": "requested_at"
      }
    },
    {
      "source_id": "alert_events",
      "label": "alert events",
      "owner": "comms",
      "owner_lane": null,
      "cause_category": "READ_FAILURE",
      "probe": {
        "kind": "db_live",
        "table": "alert_events",
        "last_event_column": "created_at"
      }
    },
    {
      "source_id": "gate_store",
      "label": "gate store",
      "owner": "os",
      "owner_lane": null,
      "cause_category": "NO_SOURCE",
      "probe": {
        "kind": "none",
        "reason": "no validation_gates store exists (LQ-20261107-2141)"
