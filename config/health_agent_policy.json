{
  "_comment": "Centralized Health Agent policy. DB-overridable via config_documents key 'health_agent_policy'. See docs/HEALTH_AGENT.md. No hardcoded values in code \u2014 weights/penalties/thresholds/mode all live here.",
  "mode": "advisory",
  "_mode_help": "advisory = score + alert + enqueue escalations (handler/coder act on them). safe = also allow the existing escalation handler's allowlisted retries. Code-level auto-fix is always gated by coder_dispatch's own CODER_DISPATCH_MODE.",
  "daemon": {
    "_comment": "Continuous health_agent_daemon.py (systemd tradeai-health-agent.service) adaptive sleep. Cron */15 still OK — same flock /tmp/health_agent.lock.",
    "cadence_seconds": {
      "healthy": 1800,
      "degraded": 300,
      "unhealthy": 90,
      "unknown": 300
    }
  },
  "weights": {
    "data_quality": 0.20,
    "execution_health": 0.20,
    "intelligence_quality": 0.20,
    "risk_protection": 0.15,
    "retirement_planning": 0.10,
    "pipeline_freshness": 0.15
  },
  "penalties": {
    "critical": 40,
    "warning": 15,
    "info": 5
  },
  "score_thresholds": {
    "healthy": 85,
    "degraded": 65
  },
  "trend": {
    "lookback_runs": 3,
    "drop_alert_points": 10
  },
  "enqueue": {
    "escalations": true,
    "code_fixes": true
  },
  "alert": {
    "_comment": "Repeat-alert throttle (2026-07-04): identical DEGRADED alerts every 30-min run were noise. Re-alert only on status change, score drop >= realert_on_score_drop, or every min_realert_minutes heartbeat. flap_suppress_minutes: a status flip BACK to one alerted within this window at a similar score is a flap, not news.",
    "telegram_on_status": [
      "unhealthy",
      "degraded"
    ],
    "telegram_on_trend_drop": true,
    "min_realert_minutes": 360,
    "realert_on_score_drop": 5,
    "flap_suppress_minutes": 360,
    "escalation_budget": {
      "_comment": "Per-finding-type daily caps to prevent storm loops (F4-7). Caps Telegram alerts and retry attempts independently — a silent retry loop still burns resources even without alerts.",
      "max_alerts_per_type_per_day": 6,
      "max_retries_per_type_per_day": 12
    }
  },
  "history": {
    "retention_days": 90,
    "api_limit": 500
  },
  "strategy_output": {
    "_comment": "Catch silent-zero strategy failures (FIB-style). Gated to avoid morning false-positives.",
    "enabled": true,
    "check_after_hour": 11,
    "tilt_min": 1.0
  },
  "proposal_trade_plan": {
    "_comment": "Broker queue proposals blocked because entry/stop/target are pure R:R math without support/resistance/confluence anchor.",
    "enabled": true,
    "blocked_warn": 1,
    "blocked_critical": 3
  },
  "proposal_maturity": {
    "_comment": "Monitor proposal volume/quality across Options, Trades, Watchlist, Rotation.",
    "enabled": true,
    "options_min_count": 1,
    "options_stale_hours": 4,
    "check_after_hour": 10,
    "trade_pending_warn": 25,
    "watchlist_stale_warn": 15,
    "broker_unrouted_warn": 3,
    "broker_unrouted_critical": 8,
    "link_rate_warn_pct": 5
  },
  "execution_hardening": {
    "_comment": "Operator-approved automated trading hardening layer monitors (incl. P1-6 extensions).",
    "enabled": true,
    "stale_order_minutes": 30,
    "expired_pending_warn": 1,
    "stale_operator_approved_minutes": 60,
    "ledger_release_mode": "review",
    "chain_snapshot_warn_min": 1440,
    "critique_min_sample": 20,
    "critique_stale_warn_pct": 25,
    "replay_degraded_warn_pct": 20
  },
  "options_desk": {
    "_comment": "Enterprise options desk infra: chain-snapshot retention + approval-queue backlog.",
    "enabled": true,
    "approval_backlog_warn": 15,
    "blocked_pileup_warn": 30,
    "expired_pending_warn": 1,
    "snapshot_grace_days": 7,
    "snapshot_row_warn": 50000
  },
  "pullback_macd_screener": {
    "_comment": "Freshness of the daily S&P 500 pullback/approaching-MACD-cross screener.",
    "enabled": true,
    "scan_stale_hours": 30,
    "check_after_hour": 18,
    "min_universe": 400
  },
  "broker_token_health": {
    "_comment": "Schwab OAuth token liveness (collect_broker_token_health). Detects server-side REVOCATION that the TTL-based token health misses: broker_oauth_tokens.degraded/last_error + invalid_grant/no-login-token in schwab_ingest.log. Emits critical schwab_token_revoked. Deliberately NOT in remediation_map \u2014 a revoked token needs a manual reauth (GATE A), not an auto-retry; the finding carries the reauth command for the operator.",
    "enabled": true,
    "tail_lines": 200
  },
  "trade_in_view": {
    "_comment": "TradeInView journal: Schwab ingest heartbeat, annotation coverage, MFE backfill.",
    "enabled": true,
    "schwab_ingest_stale_hours": 0.5,
    "annotation_warn_pct": 40,
    "annotation_critical_pct": 20,
    "mfe_coverage_warn_pct": 50,
    "trade_closed_stale_days": 3,
    "check_after_hour_et": 19
  },
  "proposal_oversight_load": {
    "_comment": "Catch bursts of new PENDING proposals that each trigger LLM oversight (load guard).",
    "enabled": true,
    "burst_window_min": 20,
    "burst_warn": 15,
    "burst_critical": 30
  },
  "watchlist_news_guard": {
    "_comment": "Yahoo RSS mis-tags headlines to wrong tickers \u2014 affects all CIO tiers (BUY/HOLD/AVOID/pullback).",
    "enabled": true,
    "sample_limit": 120,
    "mismatch_warn": 1,
    "mismatch_critical": 5
  },
  "proposal_pipeline": {
    "_comment": "Dual-lane (paper_atm + live_2fa) enrichment/readiness + paper-lane lifecycle stuck states.",
    "enabled": true,
    "enrichment_failure_window_hours": 3,
    "enrichment_failure_warn": 3,
    "enrichment_pending_fail_warn": 5,
    "approved_paper_stuck_hours": 2,
    "approved_paper_stuck_warn": 1,
    "approved_paper_stuck_critical": 3,
    "in_progress_stale_minutes": 30,
    "in_progress_stale_warn": 3
  },
  "portfolio_price_freshness": {
    "_comment": "During market hours ET: Finviz repricer + cache are authoritative for portfolio P/L. SnapTrade sync must NOT mask staleness via holdings.json mtime.",
    "enabled": true,
    "max_age_minutes": 25,
    "market_quotes_max_age_minutes": 25,
    "totals_drift_min_dollars": 5000,
    "totals_drift_min_pct": 0.5,
    "snaptrade_cash_gap_min_dollars": 5000,
    "snaptrade_accounts": [
      "fidelity_rollover_ira"
    ]
  },
  "never_auto_remediate": [
    "unprotected_positions",
    "siem_p0p1",
    "schwab_token_revoked",
    "finviz_cookie_expired",
    "data_source_auth_failed",
    "audit_ledger_coverage_warn",
    "audit_ledger_coverage_fail",
    "audit_ledger_chain_break",
    "kill_switch_active",
    "backup_cadence_stale",
    "db_dump_stale",
    "db_dump_missing",
    "backup_local_count_exceeded",
    "backup_local_bytes_exceeded",
    "backup_storm_suspected"
  ],
  "auto_remediate": {
    "_comment": "Health agent runs these allowlisted scripts immediately when matching findings fire (no 15m escalation-handler wait). Cooldown prevents repricer loops. Python path rewritten to DEV venv (live stamp has no .venv). never_auto_remediate is hard denylist for risk/credential/ledger.",
    "enabled": true,
    "cooldown_minutes": 10,
    "max_ineffective_attempts": 3,
    "ineffective_window_minutes": 60,
    "finding_types": [
      "portfolio_totals_drift",
      "account_summary_drift",
      "snaptrade_cash_stale",
      "portfolio_repricer_stale",
      "finviz_quote_cache_stale",
      "market_quotes_stale",
      "momentum_scalp_finviz_scan_stale",
      "momentum_scalp_early_lane_error",
      "sec_form4_context_stale",
      "agent_jobs_processing_stuck",
      "agent_jobs_stuck",
      "agent_jobs_stale",
      "pipeline_failures",
      "synthesis_processing_stuck",
      "proposal_trade_plan_blocked",
      "hermes_scope_governor_stale",
      "hermes_scope_governor_heartbeat_missing",
      "hermes_scope_governor_last_run_failed",
      "strategy_registry_null_ids",
      "scalp_catalyst_verification_dead",
      "enrichment_pipeline_failure",
      "enrichment_failures_high",
      "approved_paper_test_stuck",
      "enrichment_status_in_progress_stale",
      "news_symbol_mismatch",
      "cio_advisory_cases_stale",
      "trade_closed_stale",
      "orchestrator_setups_stale",
      "shadow_batch_stale",
      "finviz_screener_stale",
      "news_ingestion_stale",
      "indicator_snapshot_stale",
      "indicator_snapshots_stale",
      "symbol_profiles_stale",
      "analyst_rollup_stale",
      "sector_momentum_stale",
      "rotation_summary_stale",
      "holdings_stale",
      "stops_stale",
      "fred_data_stale",
      "sec_data_stale",
      "social_data_stale",
      "snaptrade_stale",
      "youtube_stale",
      "data_source_stale",
      "options_proposals_stale",
      "options_zero_proposals",
      "news_stale",
      "data_gaps_open",
      "never_submitted_stale",
      "stale_paper_trade_stats",
      "paper_trade_stats_stale",
      "trade_ai_session_stale",
      "trade_ai_session_missing",
      "orchestrator_setups_stale"
    ]
  },
  "scalp_catalyst_health": {
    "_comment": "URGENT monitor for the real-time momentum-scalp GO/WAIT Telegram lane (collect_scalp_catalyst_health). Fires critical scalp_catalyst_verification_dead when the scanner is active but 0 setups reach GO across window_days (catalyst verification silently producing nothing \u2192 all capped to WAIT \u2192 suppressed). Auto-remediated by re-running the scanner; circuit-breaker escalates if futile. Caught the 2026-07-01 week-long silent outage.",
    "enabled": true,
    "window_days": 3,
    "min_rows": 40
  },
  "data_sources": {
    "_comment": "Consume data_source_health rows (per-source ingestion liveness). finviz_cookie_check live-validates the cookie when finviz is stale so cookie expiry surfaces as a distinct critical finding (operator must refresh FINVIZ_COOKIE).",
    "enabled": true,
    "weekend_stale_factor": 3.0,
    "finviz_cookie_check": true
  },
  "systemd_units": {
    "_comment": "Detect failed trade-stack systemd units (missed scheduled runs). Detection-only: restart needs sudo.",
    "enabled": true,
    "unit_prefixes": [
      "tradeai-",
      "portfolio-",
      "grok-oauth",
      "chatgpt-oauth",
      "hermes-",
      "mcporter-"
    ]
  },
  "db_connections": {
    "_comment": "Count Postgres idle-in-transaction kills (script holding a txn through slow non-DB work; killed at the 120s session timeout). Caught the 2026-07-04 scope-governor outage class. slots_*: connection-slot saturation guard (2026-07-17 scanner incident: portfolio_server leaked idle conns to 97/100, warm_caches wrote an empty cache).",
    "enabled": true,
    "window_hours": 3,
    "idle_txn_kills_warn": 10,
    "pg_log_glob": "/var/log/postgresql/postgresql-*-main.log",
    "slots_per_app_warn": 40,
    "slots_total_crit": 70
  },
  "remediation_map": {
    "_comment": "finding type -> allowlisted retry_cmd enqueued for claude_escalation_handler tier-1. Only verified, side-effect-safe scripts. LLM-heavy processor retries are flock-guarded on the SAME lock as the cron so they SINGLE-FLIGHT \u2014 multiple queued retries (or a retry racing the cron) can no longer stack concurrent processors and saturate the local LLM (the 2026-06-25 Ollama thundering-herd: 6+ --limit 15 processes \u2192 503/timeout cascade).",
    "news_stale": ".venv/bin/python scripts/news_ingestion.py --priority",
    "scalp_catalyst_verification_dead": ".venv/bin/python scripts/remediate_scalp_go_dark.py",
    "hermes_scope_governor_stale": "bash scripts/safe_flock.sh /tmp/hermes_scope_governor.lock .venv/bin/python scripts/hermes_scope_governor.py --apply >> logs/hermes_scope_governor.log 2>&1",
    "hermes_scope_governor_heartbeat_missing": "bash scripts/safe_flock.sh /tmp/hermes_scope_governor.lock .venv/bin/python scripts/hermes_scope_governor.py --apply >> logs/hermes_scope_governor.log 2>&1",
    "hermes_scope_governor_last_run_failed": "bash scripts/safe_flock.sh /tmp/hermes_scope_governor.lock .venv/bin/python scripts/hermes_scope_governor.py --apply >> logs/hermes_scope_governor.log 2>&1",
    "data_gaps_open": ".venv/bin/python scripts/data_gap_resolver.py",
    "agent_jobs_stuck": ".venv/bin/python scripts/process_watchlist_agent_jobs.py --limit 40",
    "agent_jobs_stale": ".venv/bin/python scripts/process_watchlist_agent_jobs.py --limit 25",
    "pipeline_failures": ".venv/bin/python scripts/remediate_pipeline_failures.py",
    "_p0_agent_jobs_note": "While AGENT_JOBS_P0_CONTAINED flag/env is active, health_agent.guard_remediation_command blocks these worker invocations and reports CONTAINED (issue #283). Worker entry also exits 78 when contained.",
    "research_stale": ".venv/bin/python scripts/hermes_coordinator.py",
    "hermes_rag_gap": ".venv/bin/python scripts/hermes_embedding_enqueue.py --backfill --limit 500",
    "hermes_embed_backlog": "flock -n /tmp/tradeai_hermes_embedding_worker.lock .venv/bin/python scripts/hermes_embedding_worker.py --apply --limit 10",
    "hermes_embed_failures": "flock -n /tmp/tradeai_hermes_embedding_worker.lock .venv/bin/python scripts/hermes_embedding_worker.py --apply --limit 10",
    "hermes_coordinator_stale": ".venv/bin/python scripts/hermes_coordinator.py",
    "options_zero_proposals": ".venv/bin/python scripts/run_options_monitor.py",
    "options_proposals_stale": ".venv/bin/python scripts/run_options_monitor.py",
    "finviz_quote_cache_stale": ".venv/bin/python scripts/portfolio_repricer.py",
    "portfolio_repricer_stale": ".venv/bin/python scripts/portfolio_repricer.py",
    "portfolio_totals_drift": ".venv/bin/python scripts/portfolio_repricer.py",
    "account_summary_drift": ".venv/bin/python scripts/portfolio_repricer.py",
    "snaptrade_cash_stale": ".venv/bin/python scripts/snaptrade_sync.py --apply",
    "market_quotes_stale": ".venv/bin/python scripts/external_market_data_ingest.py --quotes",
    "stale_strategy_backtest_results": "flock -n /tmp/bt_aggregator.lock .venv/bin/python scripts/backtest_results_aggregator.py",
    "stale_proposal_backtest_snapshots": "flock -n /tmp/proposal_backtest.lock .venv/bin/python scripts/proposal_backtest_engine.py --all-pending --apply",
    "schwab_journal_ingest_stale": "flock -n /tmp/schwab_ingest.lock bash -c '.venv/bin/python scripts/schwab_transaction_ingest.py --apply && .venv/bin/python scripts/schwab_journal_builder.py --apply && .venv/bin/python scripts/replay_backfill.py --apply'",
    "journal_review_stale": "flock -n /tmp/journal_review.lock .venv/bin/python scripts/journal_review_builder.py",
    "momentum_scalp_finviz_scan_stale": "flock -n /tmp/tradeai_finviz_momentum_scalp.lock .venv/bin/python scripts/run_finviz_momentum_scalp_scan.py --window early --apply --skip-finviz-refresh --sync-signals --generate-proposals --run-validation-fast-path --submit-validation --ignore-window >> logs/finviz_momentum_scalp_scan.log 2>&1",
    "momentum_scalp_early_lane_error": "flock -n /tmp/tradeai_finviz_momentum_scalp.lock .venv/bin/python scripts/run_finviz_momentum_scalp_scan.py --window early --apply --skip-finviz-refresh --sync-signals --generate-proposals --run-validation-fast-path --submit-validation --ignore-window >> logs/finviz_momentum_scalp_scan.log 2>&1",
    "sec_form4_context_stale": "flock -n /tmp/tradeai_sec_form4_ctx.lock .venv/bin/python scripts/run_sec_form4_momentum_context.py --apply >> logs/sec_form4_momentum_context.log 2>&1",
    "agent_jobs_processing_stuck": ".venv/bin/python scripts/reset_stuck_agent_jobs.py --apply >> logs/reset_stuck_agent_jobs.log 2>&1",
    "synthesis_processing_stuck": ".venv/bin/python scripts/reset_stuck_agent_jobs.py --apply >> logs/reset_stuck_agent_jobs.log 2>&1",
    "proposal_trade_plan_blocked": ".venv/bin/python scripts/remediate_proposal_trade_plans.py",
    "proposal_technicals_stale": ".venv/bin/python scripts/enrich_proposal_technicals.py",
    "strategy_registry_null_ids": ".venv/bin/python scripts/fix_strategy_registry_null_ids.py",
    "enrichment_pipeline_failure": "flock -n /tmp/auto_enrichment.lock .venv/bin/python scripts/auto_enrichment_runner.py --force-all --limit 10 >> logs/auto_enrichment.log 2>&1",
    "enrichment_failures_high": "flock -n /tmp/auto_enrichment.lock .venv/bin/python scripts/auto_enrichment_runner.py --force-all --limit 15 >> logs/auto_enrichment.log 2>&1",
    "approved_paper_test_stuck": ".venv/bin/python scripts/cleanup_stale_proposals.py --pipeline-sweep --apply",
    "enrichment_status_in_progress_stale": ".venv/bin/python scripts/cleanup_stale_proposals.py --pipeline-sweep --apply",
    "never_submitted_stale": ".venv/bin/python scripts/paper_trade_monitor.py",
    "stale_paper_trade_stats": ".venv/bin/python scripts/paper_trade_statistics.py",
    "paper_trade_stats_stale": ".venv/bin/python scripts/paper_trade_statistics.py",
    "news_symbol_mismatch": "flock -n /tmp/watchlist_news_guard.lock .venv/bin/python scripts/remediate_watchlist_news_guard.py --apply >> logs/remediate_watchlist_news_guard.log 2>&1",

    "trade_closed_stale": "bash -c '.venv/bin/python scripts/schwab_journal_builder.py --apply && .venv/bin/python scripts/schwab_transaction_ingest.py --apply'",
    "orchestrator_setups_stale": ".venv/bin/python scripts/heal_trade_ai_session_cache.py",
    "trade_ai_session_stale": ".venv/bin/python scripts/heal_trade_ai_session_cache.py",
    "trade_ai_session_missing": ".venv/bin/python scripts/heal_trade_ai_session_cache.py",
    "shadow_batch_stale": ".venv/bin/python scripts/shadow_batch_generator.py --run --top 300",
    "finviz_screener_stale": ".venv/bin/python scripts/finviz_screener_runner.py --run",
    "news_ingestion_stale": ".venv/bin/python scripts/news_ingestion.py --priority",
    "indicator_snapshot_stale": ".venv/bin/python scripts/indicator_cache_refresh.py",
    "indicator_snapshots_stale": ".venv/bin/python scripts/indicator_cache_refresh.py",
    "symbol_profiles_stale": ".venv/bin/python scripts/build_symbol_profiles.py",
    "analyst_rollup_stale": ".venv/bin/python scripts/pro_analyst_fetch.py",
    "sector_momentum_stale": ".venv/bin/python scripts/sector_momentum_engine.py",
    "rotation_summary_stale": ".venv/bin/python scripts/rotation_autopilot.py",
    "holdings_stale": ".venv/bin/python scripts/portfolio_repricer.py",
    "stops_stale": ".venv/bin/python scripts/unified_stop_supervisor.py --apply",
    "fred_data_stale": ".venv/bin/python scripts/fred_data_ingest.py --ingest",
    "sec_data_stale": ".venv/bin/python scripts/sec_data_ingest.py --all",
    "social_data_stale": ".venv/bin/python scripts/social_ingest.py --source all",
    "snaptrade_stale": ".venv/bin/python scripts/snaptrade_sync.py --apply",
    "youtube_stale": ".venv/bin/python scripts/youtube_transcript_ingest.py --all-channels",
    "backup_cadence_stale": "bash linux_launchers/run_pg_backup.sh",
    "db_dump_stale": "bash linux_launchers/run_pg_backup.sh",
    "db_dump_missing": "bash linux_launchers/run_pg_backup.sh",
    "log_errors": ".venv/bin/python scripts/unified_stop_supervisor.py --apply >> logs/unified_stop_supervisor.log 2>&1",
    "execution_log_errors": ".venv/bin/python scripts/unified_stop_supervisor.py --apply >> logs/unified_stop_supervisor.log 2>&1",
    "data_source_stale": ".venv/bin/python scripts/external_market_data_ingest.py --quotes"
  },
  "data_source_remediation": {
    "_comment": "source_key -> producer command for the generic data_source_stale finding. The default remediation_map['data_source_stale'] runs external_market_data_ingest.py --quotes, which only refreshes QUOTE sources (yahoo_finance/finviz/alpaca). Non-quote sources (finnhub news, sec_edgar, youtube_api, …) must be listed here or they are NOT auto-retried — the finding escalates instead of looping a producer that can never clear it. finnhub is intentionally unmapped: a 401 routes to data_source_auth_failed (operator action), and a non-401 stall is the orchestrator/enrichment lane already covered by pipeline_failures.",
    "sec_edgar": ".venv/bin/python scripts/sec_data_ingest.py --all",
    "youtube_api": ".venv/bin/python scripts/youtube_transcript_ingest.py --all-channels"
  },
  "log_errors": {
    "_comment": "Scan recently-active component logs for ERROR/Traceback spikes (content, not staleness).",
    "enabled": true,
    "window_hours": 3,
    "error_threshold": 5,
    "tail_lines": 400,
    "watch": [
      "auto_proposal.log",
      "screener_pm.log",
      "news_ingestion.log",
      "paper_execution.log",
      "unified_stop_supervisor.log",
      "pipeline_watchdog.log",
      "atm.log",
      "cio_decisions.log",
      "data_gap_resolver.log",
      "rag_indexer.log",
      "hermes_coordinator.log",
      "health_agent_cron.log",
      "coder_dispatch_cron.log",
      "portfolio_repricer_intraday.log",
      "portfolio_repricer_postclose.log",
      "snaptrade_sync.log",
      "schwab_ingest.log",
      "journal_review.log",
      "journal_annotation_reminder.log",
      "journal_tilt_hook.log",
      "entry_planner.log",
      "options_monitor.log",
      "options_iv_snapshot.log",
      "options_strategy_scanner.log",
      "alert_dispatcher.log",
      "telegram_callback_poller.log",
      "auto_enrichment.log",
      "watchlist_sweep.log",
      "hermes_analyst_coverage.log"
    ]
  }
}
