{
  "schema": "CronMigrationTrackerConfig@v1",
  "note": "Thresholds and the wave plan for scripts/report_cron_migration_tracker.py (read-only tracker of the cron -> n8n migration). Waves follow ~/n8n-maturity-program/packets/w0-w1-dispatch.md (W0/W1) and the rationalization roadmap R0-R5 in docs/implementation/n8n-maturity/data/F_rationalization.json + F_rationalization.md section 9 (16 pipelines P01-P16 + standalone MIGRATE_N8N / EVENT lanes). Durations are the roadmap's UPPER bounds (conservative).",
  "validated_min_live_fires": 3,
  "dry_run_min_natural_fires": 1,
  "live_with_cron_market_days": 1,
  "scalp_class_live_with_cron_market_days": 3,
  "scalp_class_tokens": ["scalp"],
  "cutover_days": 1,
  "fire_wait_cap_days": 7,
  "natural_requested_by_prefix": "n8n:workflow:",
  "natural_requested_by_exclude": ["n8n:workflow:agentA-smoke"],
  "dispatcher_kinds": ["n8n", "dispatcher"],
  "scheduled_kinds": ["cron", "systemd", "n8n", "dispatcher", "event"],
  "in_scope_states": ["ACTIVE", "PAUSED", "RETIRED"],
  "waves_sequential": true,
  "waves": [
    {"id": "RETIRED", "title": "Registry state RETIRED (nothing to move)", "source": "lane_registry state",
     "select": {"stages": ["RETIRED"]}, "build_days": 0, "ladder": "done"},
    {"id": "N1", "title": "N1 per-lane pilot (already cut over)", "source": "AGENTS 4.0.0 N1; CutoverReceipt@v1",
     "select": {"lane_ids": ["n8n-pilot-dispatch", "n8n-incident-fanin", "n8n-research-intake-consumer", "crontab-snapshot-for-health-agent"]},
     "build_days": 0, "ladder": "dispatch"},
    {"id": "W0", "title": "Six generic n8n workflows imported + published (no lane moves)", "source": "packets/w0-w1-dispatch.md section 3",
     "select": {"lane_ids": []}, "build_days": 3, "ladder": "none"},
    {"id": "W1", "title": "First dispatcher wave (10 read-only monitor/report lanes)", "source": "packets/w0-w1-dispatch.md section 4",
     "select": {"lane_ids": ["catalyst-calibration-monitor", "source-attribution-monitor", "watch-directives-monitor", "generate-analyst-daily-digest", "job-coverage-monitor", "desk-suggestions-digest", "cio-lineage-completion-report", "agent-number-grounding-slo", "refresh-operator-product", "iris-taxonomy-agent-gaps"]},
     "build_days": 1, "ladder": "dispatch"},
    {"id": "R0", "title": "Eliminate (no-output / never-fired / dead)", "source": "F_rationalization section 4 / roadmap R0",
     "select": {"recommendations": ["R0_ELIMINATE"]}, "build_days": 2, "ladder": "retire"},
    {"id": "R1", "title": "Health + notification plane (P11, P12)", "source": "roadmap R1",
     "select": {"pipelines": ["P11", "P12"]}, "build_days": 7, "ladder": "dispatch"},
    {"id": "W1b", "title": "Standalone MIGRATE_N8N lanes (persona runtimes, iris, db retention)", "source": "F_rationalization MIGRATE_N8N",
     "select": {"recommendations": ["MIGRATE_N8N"]}, "build_days": 7, "ladder": "dispatch"},
    {"id": "R3", "title": "Pipelines flip dry-run -> apply, members retire (P04, P05, P06, P16)", "source": "roadmap R3",
     "select": {"pipelines": ["P04", "P05", "P06", "P16"]}, "build_days": 21, "ladder": "dispatch"},
    {"id": "R4", "title": "Domain consolidation (P00-P03, P07-P10, P13-P15 + other merges)", "source": "roadmap R4 (AGENTS rule R1 needed for LLM/ingest lanes)",
     "select": {"pipelines": ["P00", "P01", "P02", "P03", "P07", "P08", "P09", "P10", "P13", "P14", "P15"], "merge_other": true}, "build_days": 28, "ladder": "dispatch"},
    {"id": "R5", "title": "Event-driven pollers (EVENT_DRIVEN_CANDIDATE)", "source": "roadmap R5",
     "select": {"recommendations": ["EVENT_DRIVEN_CANDIDATE"]}, "build_days": 14, "ladder": "dispatch"},
    {"id": "W5", "title": "Steady state: stays on cron/systemd, watched by the heartbeat watcher", "source": "waves.json W5 / KEEP_ON_CRON",
     "select": {"recommendations": ["KEEP_ON_CRON"]}, "build_days": 0, "ladder": "keep"},
    {"id": "UNPLANNED", "title": "No recommendation yet (needs a rationalization decision)", "source": "registry rows without recommendation; unregistered crontab lines",
     "select": {"fallback": true}, "build_days": 0, "ladder": "unplanned"}
  ]
}
