      "deepseek_default_policy": "FAST",
      "deepseek_allowed_policies": [
        "FAST",
        "FAST_THINK"
      ]
    },
    {
      "id": "strategy_planner",
      "name": "Strategy Planner",
      "category": "Strategy",
      "lane_policy": "either",
      "description": "What-if planning \u2014 Grok default, ChatGPT ok",
      "deepseek_default_policy": "PRO_THINK",
      "deepseek_allowed_policies": [
        "FAST_THINK",
        "PRO_THINK",
        "PRO_MAX"
      ],
      "requires_operator_cost_confirmation_for": [
