{
  "version": 4,
  "default_mode": "manual",
  "lane_policies": {
    "grok_only": "Grok only \u2014 single lane",
    "chatgpt_only": "ChatGPT only",
    "either": "Operator picks Grok OR ChatGPT (one is enough)",
    "both_preferred": "Best with both lanes; either alone still useful",
    "ensemble": "Designed to run both and reconcile",
    "deepseek_only": "DeepSeek metered only (exact policy allowlist)"
  },
  "processes": [
    {
      "id": "holding_protection_advisor",
      "name": "Holding Protection Advisor",
      "category": "Portfolio",
      "lane_policy": "grok_only",
      "default_mode": "manual",
      "description": "Per-holding stop/trail via Grok \u2014 use batch for periodic top-N runs"
    },
    {
      "id": "holding_protection_advisor_batch",
      "name": "Stop Advisory Batch (top N)",
      "category": "Portfolio",
      "lane_policy": "grok_only",
      "default_mode": "manual",
      "description": "Manual/cron batch: advise up to 6 priority holdings per run"
    },
    {
      "id": "broker_cloud_oversight",
      "name": "Broker Proposal Cloud Oversight",
      "category": "Trading",
      "lane_policy": "both_preferred",
      "description": "Per-proposal second opinion \u2014 pick Grok, ChatGPT, or both via card buttons"
    },
    {
      "id": "cloud_review",
      "name": "Cloud Review (ensemble)",
      "category": "Hermes",
      "lane_policy": "both_preferred",
      "default_mode": "automated",
      "description": "Reviews local LLM output \u2014 auto uses both when available"
    },
    {
      "id": "oauth_lane_keepalive",
      "name": "OAuth Lane Keepalive",
      "category": "System",
      "lane_policy": "either",
      "default_mode": "automated",
      "description": "Token roll pings (Grok + ChatGPT cron)"
    },
    {
      "id": "deepseek_flash_operator_smoke",
      "name": "DeepSeek Flash Operator Smoke",
      "category": "System",
      "lane_policy": "deepseek_only",
      "default_mode": "manual",
      "description": "Manual-only Consumption smoke for DeepSeek V4 Flash. Advisory only. No tools. No fallback.",
      "allowed_lanes": [
        "deepseek-flash",
        "deepseek-v4-flash",
        "fast"
      ],
      "deepseek_default_policy": "FAST",
      "deepseek_allowed_policies": [
        "FAST"
      ],
      "max_input_tokens": 64,
      "max_output_tokens": 32,
      "daily_soft_cap": 20,
      "daily_cost_cap_usd": 0.05,
      "tools_allowed": false,
      "fallback_allowed": false,
      "advisory_only": true
    },
    {
      "id": "rotation_grok_review",
      "name": "Rotation Grok Review",
      "category": "Rotation",
      "lane_policy": "grok_only",
      "description": "Inline Grok second opinion on rotation questions"
    },
    {
      "id": "rotation_oversight",
      "name": "Rotation Independent Oversight",
      "category": "Rotation",
      "lane_policy": "ensemble",
      "description": "Grok + ChatGPT oversight on rotation engine \u2014 run both for full picture"
    },
    {
      "id": "watchlist_cio_synthesis",
      "name": "Watchlist CIO Synthesis",
      "category": "Watch",
      "lane_policy": "ensemble",
      "default_mode": "manual",
      "description": "CIO view \u2014 Grok primary + ChatGPT reconcile when both run",
      "deepseek_default_policy": "PRO_THINK",
      "deepseek_allowed_policies": [
        "FAST_THINK",
        "PRO_THINK",
        "PRO_MAX"
      ],
      "requires_operator_cost_confirmation_for": [
        "PRO_MAX"
      ],
      "output_schema": "cio_synthesis.v1"
    },
    {
      "id": "watchlist_maria_priority",
      "name": "Maria Priority OAuth",
      "category": "Watch",
      "lane_policy": "either",
      "default_mode": "automated",
      "daily_soft_cap": 80,
      "description": "OAuth Maria narratives for portfolio holdings, top WAIT setups, and manual refresh \u2014 ~30-80 calls/day",
      "deepseek_default_policy": "FAST",
      "deepseek_allowed_policies": [
        "FAST",
        "FAST_THINK"
      ],
      "daily_cost_cap_usd": 5.0,
      "output_schema": "watch_narrative.v1"
    },
    {
      "id": "paper_trade_advisory",
      "name": "Paper Trade Post-Mortem",
      "category": "Trading",
      "lane_policy": "both_preferred",
      "description": "Post-mortem on closed paper trades"
    },
    {
      "id": "hermes_external_research",
      "name": "Hermes External Research",
      "category": "Hermes",
      "lane_policy": "either",
      "description": "Escalation \u2014 first available OAuth lane"
    },
    {
      "id": "multi_tier_trade_reviewer",
      "name": "Multi-Tier Trade Reviewer",
      "category": "Journal",
      "lane_policy": "both_preferred",
      "description": "Cloud review of local trade reviews",
      "deepseek_default_policy": "FAST_THINK",
      "deepseek_allowed_policies": [
        "FAST_THINK",
        "PRO_THINK"
      ],
      "deepseek_escalate_to": "PRO_THINK",
      "escalation_conditions": [
        "reviewer_disagreement",
        "material_risk",
        "unresolved_contradictions"
      ]
    },
    {
      "id": "reporting_grok_editorial",
      "name": "Report Grok Editorial",
      "category": "Reports",
      "lane_policy": "grok_only",
      "description": "Optional Grok polish on exports"
    },
    {
      "id": "portfolio_weekly_report",
      "name": "Portfolio Weekly Report",
      "category": "Reports",
      "lane_policy": "either",
      "default_mode": "automated",
      "description": "Weekly portfolio narratives (6 sections) via OAuth LLM"
    },
    {
      "id": "portfolio_monthly_report",
      "name": "Portfolio Monthly Report",
      "category": "Reports",
      "lane_policy": "either",
      "default_mode": "automated",
      "daily_soft_cap": 24,
      "description": "Monthly portfolio narratives (8 sections) via OAuth LLM"
    },
    {
      "id": "directive_keyword_enhancer",
      "name": "Directive Keyword Enhancer",
      "category": "Intel",
      "lane_policy": "ensemble",
      "description": "Merges keywords from grok + chatgpt + local"
    },
    {
      "id": "think_tank_signal_miner",
      "name": "Think Tank Signal Miner",
      "category": "Intel",
      "lane_policy": "either",
      "description": "Tries lanes in order"
    },
    {
      "id": "hermes_scalp_review",
      "name": "Hermes Scalp Post-Trade Review",
      "category": "Trading",
      "lane_policy": "either",
