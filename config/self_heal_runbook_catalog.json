  "_ordering": "Entries are selected by explicit integer priority (lowest wins); ids break ties, and a shared priority is reported as ambiguous by plan_runbook. The only entry with no match patterns is the K04 catch-all, which must stay last.",
  "_safety": "Every action is one primitive from ACTION_WHITELIST in scripts/lib/self_heal_runbooks.py. No DB write, no kill, no crontab/systemd/env edit, no broker/order/stop, no credential read, no push. Mutating actions are refused on execution lanes before the catalog is consulted.",
  "runbooks": [
    {
      "id": "A01-flock-held",
      "category": "A",
      "title": "flock held: the lock is doing its job; wait and recheck",
      "tier": "auto_notify",
      "priority": 100,
      "match": {
        "failure_class": [
          "lock_skip",
          "flock_held"
        ],
        "reason_regex": [
          "\\bflock[_ -]?held\\b",
          "\\bRUN_SKIPPED_LOCK\\b",
          "(?i)another scheduler holds"
        ],
        "exception_regex": [
          "\\bBlockingIOError\\b"
        ]
      },
      "preconditions": [
        "lane_present"
      ],
      "action": "noop_wait_recheck",
      "params": {
        "wait_s": 300
      },
      "max_attempts": 3,
      "cooldown_min": 60,
      "verify": {
        "kind": "run_appears",
        "window_s": 900
      },
      "on_fail": {
        "title": "flock held across {max_attempts} rechecks on {lane}"
      },
      "human_steps": [
        "compare the lock holder with the lane's schedule: ps -o pid,lstart,cmd -p <owner-pid>",
        "never delete a flock file; a holder-less flock file blocks nothing (scripts/cleanup_stale_locks.sh)"
      ],
      "tests": [
        "fx-flock-held-match",
        "fx-flock-held-refuse",
        "fx-flock-held-repeat"
      ]
    },
    {
      "id": "A02-stale-existence-lock",
      "category": "A",
      "title": "stale existence lock (pidfile) whose recorded owner is dead and whose age exceeds the lane timeout",
      "tier": "auto_notify",
      "priority": 110,
      "match": {
        "failure_class": [
          "stale_lock"
        ],
        "reason_regex": [
          "\\bstale[_ -]?lock\\b",
          "\\bstale[_ -]?pidfile\\b"
        ],
        "exception_regex": []
      },
      "preconditions": [
        "lane_present",
        "not_execution_lane",
        "lock_path_recorded",
        "owner_pid_recorded",
        "owner_pid_dead",
        "lock_age_recorded",
        "lock_age_gt_lane_timeout",
        "lock_kind_existence"
      ],
      "action": "release_stale_flock",
      "params": {},
      "max_attempts": 2,
      "cooldown_min": 60,
      "verify": {
        "kind": "lock_absent_or_free",
        "window_s": 300
      },
      "on_fail": {
        "title": "stale lock on {lane} did not pass its sanity checks"
      },
      "human_steps": [
        "the lock is archived (renamed .stale-<utc>), never deleted; a kernel flock is never touched because the kernel releases it when the holder exits"
      ],
      "tests": [
        "fx-stale-lock-match",
        "fx-stale-lock-refuse-live-pid",
        "fx-stale-lock-repeat"
      ]
    },
