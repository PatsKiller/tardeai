      "needs_backend": true,
      "needs_backend_note": "per-lane late count (LQ-20261107-2148)",
      "rules": [
        {
          "sessions": [
            "rth",
            "extended",
            "closed"
          ],
          "threshold_s": 300
        }
      ]
    },
    {
      "widget_id": "status_alerts",
      "widget": "Status \u00b7 Alerts",
      "source_id": "incident_store",
      "refresh_rate": "on event",
      "refresh_s": 0,
      "failure_mode": "UNKNOWN drawn as a risk",
      "needs_backend": true,
      "needs_backend_note": "no Home read over alert_incidents (LQ-20261107-2147)",
      "rules": [
        {
          "sessions": [
            "rth",
            "extended",
            "closed"
          ],
          "threshold_s": null
