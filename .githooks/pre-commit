#!/usr/bin/env bash
# Trade AI tracked pre-commit: secrets, then existing hygiene if present.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
python3 "$ROOT/scripts/check_no_secrets.py"
if [[ -x "$ROOT/scripts/githooks/pre-commit" ]]; then
  exec "$ROOT/scripts/githooks/pre-commit"
fi
exit 0
