#!/usr/bin/env bash
# Trade AI tracked pre-push: auth + per-branch push budget, then the AGENTS.md policy freshness gate (every pushed
# commit's AGENTS.md matches origin/main's or sits on top of it with a version not lower; STALE refuses, 2026-10-28),
# then the secrets tree scan, and only then the guard grant use and the budget count (2026-10-21).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
export PYTHONPATH="${repo_root}${PYTHONPATH:+:$PYTHONPATH}"

# git hands the hook one "<local ref> <local sha> <remote ref> <remote sha>" line per pushed ref.
# The budget is charged to the PUSHED branch(es), not to HEAD; HEAD is only the fallback when the
# hook is run by hand with no refs on stdin.
push_refs=""
if [[ ! -t 0 ]]; then
  push_refs="$(timeout 10 cat || true)"
fi
export PUSH_REFS="$push_refs"

echo
echo "Trade AI Remote Sync Gate"
echo "========================="
echo

authorized=0
[[ "${TRADEAI_REMOTE_PUSH_AUTHORIZED:-0}" == "1" ]] && authorized=1
env_override=0
[[ "${TRADEAI_REMOTE_PUSH_OVERRIDE:-0}" == "1" ]] && env_override=1

push_head_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
push_head="$(git rev-parse HEAD 2>/dev/null || echo "")"
guard_meta="$(PUSH_BRANCH="$push_head_branch" PUSH_HEAD="$push_head" python3 - <<'PY'
import json, os, sys
sys.path.insert(0, os.environ.get("PYTHONPATH", "").split(":")[0] or ".")
try:
    from scripts.lib.guard_push_auth import push_authorized_by_guard_scoped
    from scripts.lib.tradeai_push_budget import parse_push_refs, ZERO_SHA
    refs = [r for r in parse_push_refs(os.environ.get("PUSH_REFS", ""))]
    targets = [(r["branch"], "" if r["local_sha"] == ZERO_SHA else r["local_sha"]) for r in refs] or \
              [(os.environ.get("PUSH_BRANCH", ""), os.environ.get("PUSH_HEAD", ""))]
    # The grant must cover EVERY ref this push writes; one uncovered ref and the grant authorizes nothing.
    verdicts = [push_authorized_by_guard_scoped(branch=b, head_sha=s) for b, s in targets]
    v = dict(verdicts[0])
    v["ok"] = all(x["ok"] for x in verdicts)
    v["scoped"] = all(x["scoped"] for x in verdicts)
    v["uncovered"] = [b for (b, _), x in zip(targets, verdicts) if not x["scoped"]]
    print(json.dumps(v))
except Exception:
    print(json.dumps({"ok": False, "reason": "", "scoped": False, "why": "", "enforced": False,
                      "grant_id": "", "uncovered": []}))
PY
)"
jget() { python3 -c 'import json,sys; v=json.loads(sys.argv[1]).get(sys.argv[2]); print("" if v is None else v)' "$1" "$2"; }
guard_scoped="$(python3 -c 'import json,sys; print("1" if json.loads(sys.argv[1]).get("scoped") else "0")' "$guard_meta")"
guard_has="$(python3 -c 'import json,sys; print("1" if json.loads(sys.argv[1]).get("reason") else "0")' "$guard_meta")"
if [[ "$guard_has" == "1" && "$guard_scoped" != "1" ]]; then
  uncovered="$(python3 -c 'import json,sys; print(" ".join(json.loads(sys.argv[1]).get("uncovered") or []))' "$guard_meta")"
  echo "WARNING: the active guard git-push grant does not name branch '${uncovered:-$push_head_branch}' or head ${push_head:0:9}."
  echo "         A grant is permission for one operation; unscoped grants are refused and not consumed (TRADEAI_GUARD_PUSH_SCOPE_ENFORCE=0 to warn only)."
fi
guard_ok="$(python3 -c 'import json,sys; print("1" if json.loads(sys.argv[1])["ok"] else "0")' "$guard_meta")"
guard_reason="$(jget "$guard_meta" reason)"
guard_grant_id="$(jget "$guard_meta" grant_id)"
[[ "$guard_ok" == "1" ]] && authorized=1

# Budget decision per pushed branch, counted per (git common dir, branch) so a new worktree or a
# branch switch cannot reset it. A guard grant no longer lifts the cap by itself (2026-10-21): only
# a grant whose reason says "override", or the operator's TRADEAI_REMOTE_PUSH_OVERRIDE=1, does.
# Hands-off delivery (AGENTS.md 20.4.0, read from origin/main:AGENTS.md; inert until ACTIVE): budget 5,
# the coordinator's override with an Operator-approval: reference, every used override logged, and no
# override ever authorizes a force push (scripts/lib/tradeai_push_budget.py hook_decision).
decision="$(AUTHORIZED="$authorized" ENV_OVERRIDE="$env_override" GUARD_OK="$guard_ok" GUARD_REASON="$guard_reason" python3 - <<'PY'
import os, json, sys
sys.path.insert(0, os.environ.get("PYTHONPATH", "").split(":")[0] or ".")
from scripts.lib.tradeai_push_budget import hook_decision
d = hook_decision(
    os.environ.get("PUSH_REFS", ""),
    authorized=os.environ.get("AUTHORIZED") == "1",
    env_override=os.environ.get("ENV_OVERRIDE") == "1",
    grant_reason=os.environ.get("GUARD_REASON") if os.environ.get("GUARD_OK") == "1" else None,
)
print(json.dumps({**d, "guard_grant": os.environ.get("GUARD_OK") == "1"}, default=str))
PY
)"
export PUSH_DECISION="$decision"

reason="$(jget "$decision" reason)"
allow="$(jget "$decision" allow)"
count="$(jget "$decision" state_count)"
budget="$(jget "$decision" budget)"
blocked_branch="$(jget "$decision" branch)"
hands_off="$(jget "$decision" hands_off)"
coord_why="$(python3 -c 'import json,sys; c=json.loads(sys.argv[1]).get("coordinator") or {}; print(c.get("why") or "")' "$decision")"

if [[ "$allow" != "True" ]]; then
  if [[ "$reason" == "FORCE_PUSH_REFUSED" ]]; then
    force_lines="$(python3 -c 'import json,sys; print("\n".join("  - " + f["branch"] + ": " + f["why"] for f in json.loads(sys.argv[1]).get("force") or []))' "$decision")"
    cat >&2 <<EOF
REMOTE PUSH BLOCKED (force push refused).

${force_lines}

No override -- the operator's, a grant's or the coordinator's -- authorizes rewriting or deleting a
remote branch (AI_WORK_POLICY.md; AGENTS.md 20.4.0 hands-off delivery). Fetch, then push a fast-forward:
add a commit on top of the remote tip instead of rewriting it.
EOF
  elif [[ "$reason" == "BUDGET_EXCEEDED" ]]; then
    cat >&2 <<EOF
REMOTE PUSH BLOCKED (push budget).

This tranche (branch '${blocked_branch}') already used ${count} authorized remote push(es).
Effective budget for this branch is ${budget}.
Default budget is 2 (4 for n8nmat/* until 2026-10-12T23:59:59-04:00, AGENTS.md §23.13).
Hands-off delivery (AGENTS.md 20.4.0 ACTIVE on origin/main: ${hands_off}) raises it to 5.
The count is per branch across every worktree of this repository; a guard git-push grant
lifts it only when the grant's reason says "override".
Any push beyond the effective budget requires explicit operator approval:

    TRADEAI_REMOTE_PUSH_OVERRIDE=1 TRADEAI_REMOTE_PUSH_AUTHORIZED=1 git push ...

Under AGENTS.md 20.4.0 the COORDINATOR may set that override without a fresh interactive approval
only with TRADEAI_COORDINATOR_SESSION naming its live coordinator claim and an "Operator-approval:"
reference in the PR body or its claim plan.${coord_why:+ Coordinator check: ${coord_why}}

See AI_WORK_POLICY.md §3 and §17. Renaming a branch to gain budget is routing around a denial. Do not use the override as the normal path.
EOF
  else
    cat >&2 <<'EOF'
REMOTE PUSH BLOCKED.

Trade AI uses LOCAL-FIRST development. See AI_WORK_POLICY.md.

A local checkpoint is:
    git commit

not:
    git push

Complete local acceptance first, then authorize ONE synchronization:

    bin/guard grant git-push --for 30m --uses 10 --reason "..."
    git push ...

Or, for a single push without a grant window:

    TRADEAI_REMOTE_PUSH_AUTHORIZED=1 git push ...

Do not set that flag merely to bypass this policy.
EOF
  fi
  exit 1
fi

echo "Remote synchronization explicitly authorized for this command (reason=$reason count=$count budget=$budget hands_off=$hands_off)."
if [[ "$reason" == "OVERRIDE" ]]; then
  echo "Push budget override used (source=$(jget "$decision" override_source)); it is logged.${coord_why:+ Coordinator check: ${coord_why}}"
fi
if [[ "$guard_ok" == "1" ]]; then
  echo "Cursor git-push grant active: $guard_reason"
fi

# Policy freshness (operator 2026-10-28; scripts/lib/policy_freshness.py): every pushed commit's AGENTS.md must match
# origin/main's, or sit on top of it (a branch that bumps AGENTS.md). STALE refuses before any grant use or budget
# count; UNKNOWN is printed as a warning and the push continues. One short fetch; offline uses the last fetch.
if [[ -f "$repo_root/scripts/lib/policy_freshness.py" ]]; then
  fresh_revs=()
  while read -r _lref lsha _rref _rsha; do
    [[ -n "${lsha:-}" && "$lsha" != "0000000000000000000000000000000000000000" ]] && fresh_revs+=(--rev "$lsha")
  done <<< "$PUSH_REFS"
  [[ ${#fresh_revs[@]} -eq 0 ]] && fresh_revs=(--rev HEAD)
  fresh_rc=0
  python3 "$repo_root/scripts/lib/policy_freshness.py" --repo "$repo_root" --gate pre-push "${fresh_revs[@]}" \
    >/dev/null || fresh_rc=$?
  if [[ $fresh_rc -eq 1 ]]; then
    echo "REMOTE PUSH BLOCKED (stale policy): rebase onto fresh origin/main and re-read AGENTS.md §0." >&2
    exit 1
  elif [[ $fresh_rc -ne 0 && $fresh_rc -ne 3 ]]; then
    echo "WARNING: policy freshness check could not run (rc=$fresh_rc); AGENTS.md freshness NOT verified." >&2
  fi
else
  echo "WARNING: scripts/lib/policy_freshness.py missing; AGENTS.md freshness NOT verified." >&2
fi

if [[ "${TRADEAI_SKIP_SECRETS_SCAN:-0}" != "1" ]]; then
  if [[ -f "$repo_root/scripts/check_no_secrets.py" ]]; then
    echo "Running secrets tree scan..."
    python3 "$repo_root/scripts/check_no_secrets.py" --tree
  fi
fi

# Consume AFTER the gates (2026-10-21): a push refused by the budget or the secrets scan above has
# already exited and cost no grant use. C-10 (2026-09-26): only the Cursor shell guard consumed a
# use per push; a Claude Code (or plain shell) push authorized by the same grant consumed nothing.
# Consume one use here, from the exact grant that authorized the push, unless the shell guard
# already did (it exports TRADEAI_GUARD_CONSUMED_BY_SHELL=1). When the grant was the ONLY
# authorization and the use cannot be taken (the grant was exhausted, revoked or replaced since the
# check), the push is refused; otherwise accounting stays fail-soft.
if [[ "$guard_ok" == "1" && "${TRADEAI_GUARD_CONSUMED_BY_SHELL:-0}" != "1" && "${TRADEAI_GUARD_CONSUME:-1}" != "0" ]]; then
  if [[ -f ".cursor/hooks/guard_ledger.py" ]]; then
    gid_arg=()
    [[ -n "$guard_grant_id" ]] && gid_arg=(--grant-id "$guard_grant_id")
    consume_rc=0
    consume_out="$(python3 .cursor/hooks/guard_ledger.py consume --tier git-push "${gid_arg[@]}" 2>/dev/null | tail -1)" || consume_rc=$?
    if [[ $consume_rc -eq 0 ]]; then
      echo "guard: consumed one git-push use (${consume_out:0:120})"
    elif [[ "${TRADEAI_REMOTE_PUSH_AUTHORIZED:-0}" != "1" ]]; then
      echo "REMOTE PUSH BLOCKED: the git-push grant ${guard_grant_id:0:8} could not be consumed (${consume_out:0:160})." >&2
      exit 1
    else
      echo "guard: no git-push use consumed (${consume_out:0:120}); push authorized by TRADEAI_REMOTE_PUSH_AUTHORIZED"
    fi
  fi
fi

python3 - <<'PY'
import os, sys
sys.path.insert(0, os.environ.get("PYTHONPATH", "").split(":")[0] or ".")
import json
from scripts.lib.tradeai_push_budget import record_authorized_push, parse_push_refs, pushed_branches, log_override
shas = {r["branch"]: r["local_sha"] for r in parse_push_refs(os.environ.get("PUSH_REFS", ""))}
for branch in pushed_branches(os.environ.get("PUSH_REFS", "")):
    record_authorized_push(branch, sha=shas.get(branch))
# Every USED override is logged (AGENTS.md 20.4.0 hands-off delivery): who, which source, which approval ref.
d = json.loads(os.environ.get("PUSH_DECISION") or "{}")
if d.get("override_used"):
    coord = d.get("coordinator") or {}
    log_override({
        "branches": [{"branch": b["branch"], "count_before": b["state_count"], "budget": b["budget"],
                      "sha": shas.get(b["branch"])} for b in d.get("branches") or [] if b.get("reason") == "OVERRIDE"],
        "source": d.get("override_source"),
        "hands_off": bool(d.get("hands_off")),
        "coordinator_session": coord.get("session"),
        "coordinator_claim": coord.get("coordinator_claim"),
        "coordinator_ok": bool(coord.get("ok")),
        "coordinator_why": coord.get("why"),
        "approvals": coord.get("approvals") or {},
        "agent_claim_session": os.environ.get("AGENT_CLAIM_SESSION") or None,
        # AGENTS.md 21.0.0 §28.15 item 1: the override is logged with its approval reference.
        "override_ref": os.environ.get("TRADEAI_REMOTE_PUSH_OVERRIDE_REF") or None,
        "guard_grant": bool(d.get("guard_grant")),
    })
PY

exit 0
