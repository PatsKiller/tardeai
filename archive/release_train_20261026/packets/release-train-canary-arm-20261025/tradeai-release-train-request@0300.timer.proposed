# PROPOSED (release-train schedule, 2026-10-25; packet docs/ops/packets/release-train-canary-arm-20261025/).
# host-timer request, 03:00 America/New_York window (Sunday only: the last Saturday-night overnight window). A missed window is never replayed late (Persistent=false).
[Unit]
Description=Trade AI release train: host-timer request, 03:00 America/New_York window (Sunday only)

[Timer]
OnCalendar=Sun *-*-* 03:00:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-release-train-request@0300.service

[Install]
WantedBy=timers.target
