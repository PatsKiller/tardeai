# PROPOSED (release-train schedule, 2026-10-25; packet docs/ops/packets/release-train-canary-arm-20261025/).
# PR census at 08:40 America/New_York (window 0900, weekends only). A missed window is never replayed late (Persistent=false).
[Unit]
Description=Trade AI release train: PR census at 08:40 America/New_York (window 0900, weekends only).

[Timer]
OnCalendar=Sat,Sun *-*-* 08:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@0900.service

[Install]
WantedBy=timers.target
