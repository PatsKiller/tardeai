# PROPOSED (release-train schedule, 2026-10-25; packet docs/ops/packets/release-train-canary-arm-20261025/).
# PR census at 02:40 America/New_York (window 0300, Sunday only). A missed window is never replayed late (Persistent=false).
[Unit]
Description=Trade AI release train: PR census at 02:40 America/New_York (window 0300, Sunday only)

[Timer]
OnCalendar=Sun *-*-* 02:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@0300.service

[Install]
WantedBy=timers.target
