# PROPOSED (release-train schedule, 2026-10-25; packet docs/ops/packets/release-train-canary-arm-20261025/).
# PR census at 20:40 America/New_York (window 2100, weekends only). A missed window is never replayed late (Persistent=false).
[Unit]
Description=Trade AI release train: PR census at 20:40 America/New_York (window 2100, weekends only).

[Timer]
OnCalendar=Sat,Sun *-*-* 20:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@2100.service

[Install]
WantedBy=timers.target
