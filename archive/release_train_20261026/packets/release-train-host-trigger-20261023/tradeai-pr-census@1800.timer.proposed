# PROPOSED, NOT INSTALLED (packet docs/ops/packets/release-train-host-trigger-20261023/). The PR census 20 minutes
# before the 18:00 ET window. Persistent=false: a missed census is not replayed.
[Unit]
Description=Trade AI release train: PR census at 17:40 America/New_York (window 1800)

[Timer]
OnCalendar=*-*-* 17:40:00 America/New_York
Persistent=false
AccuracySec=30s
Unit=tradeai-pr-census@1800.service

[Install]
WantedBy=timers.target
