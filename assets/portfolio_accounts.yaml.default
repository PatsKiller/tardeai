# ── Portfolio-wide Targets ────────────────────────────────────────────────────
portfolio_targets:
  max_single_stock_pct: 15.0      # Flag if any stock > 15% of total portfolio
  max_single_sector_pct: 30.0     # Flag if any sector > 30%
  min_cash_pct: 2.0               # Minimum cash across all accounts
  concentration_warning_pct: 10.0  # Single stock warning threshold

