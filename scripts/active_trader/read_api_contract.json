{
  "contract": "active-trader-read",
  "contract_version": "stage4-v1.0",
  "api_version": "v3",
  "route_prefix": "/api/v3/active-trader",
  "transport": "stdlib http.server (repo-existing framework); transport-independent core App.request",
  "environments_allowed": ["SHADOW", "SIMULATION"],
  "environments_forbidden": ["LIVE", "production"],
  "methods_allowed": ["GET"],
  "non_get_behavior": {"status": 405, "code": "METHOD_NOT_ALLOWED"},
  "auth": {"mode": "factory-registered test identity via x-at-test-identity header; identities are injected by create-app only — a bare header value not registered in the factory is rejected 401"},
  "cors": {"default": "disabled", "test_profile": "single explicit localhost origin only; wildcard refused at factory"},
  "pagination": {"style": "opaque cursor (urlsafe base64)", "default_limit": 50, "max_limit": 200, "ordering": "deterministic (documented per route)"},
  "rate_limits": {"general_per_minute": 120, "heavy_per_minute": 30, "heavy_routes": ["journal", "rejections", "parity", "symbol"]},
  "bounds": {"max_response_bytes": 1500000, "max_warnings": 20, "max_sources": 10, "max_date_range_days": 92, "db_statement_timeout": "5s (role-level)"},
  "success_envelope": ["api_version", "service", "environment", "request_id", "generated_at", "data_as_of", "source_sha", "sources", "freshness (per-source)", "warnings", "data"],
  "source_metadata": ["source_name", "source_type", "observed_at", "expires_at", "freshness_state FRESH|AGING|STALE|UNAVAILABLE", "evidence_ref"],
  "warning_categories": ["STALE", "UNAVAILABLE", "PARTIAL", "CONFLICT", "NOT_INSTALLED", "NOT_CONFIGURED", "UNVERIFIED", "REDACTED"],
  "error_envelope": ["api_version", "service", "request_id", "generated_at", "error{code,message,retryable,operator_action}", "warnings"],
  "error_statuses": {"400": "invalid query/symbol", "401": "unauthenticated dev request", "403": "environment/source not permitted", "404": "not found", "405": "non-GET", "409": "unresolvable data conflict", "422": "invalid filter/pagination", "429": "read-rate limit", "500": "internal (no leakage)", "503": "required test source unavailable"},
  "redaction": "no DSN/token/account-number/authorization-header/stack-trace/SQL in any response; account ids masked; rejections stored+served redacted; journal serves replay REFERENCES only",
  "routes": [
    {"path": "/health", "query": [], "class": "general"},
    {"path": "/version", "query": [], "class": "general"},
    {"path": "/session", "query": [], "class": "general", "empty_state": "explicit NO_SESSION (not 404)"},
    {"path": "/candidates", "query": ["state", "symbol", "broker", "account", "freshness", "limit", "cursor", "sort(symbol|state|rvol)"], "class": "general", "source": "SYNTHETIC fixture until Stage 5"},
    {"path": "/symbol/<symbol>", "query": [], "class": "heavy", "validation": "^[A-Z][A-Z0-9.\\-]{0,9}$ after conservative normalization; no broker call triggered"},
    {"path": "/accounts", "query": [], "class": "general", "source": "Stage 2 discovery snapshot (masked)"},
    {"path": "/brokers", "query": [], "class": "general"},
    {"path": "/brokers/capabilities", "query": ["broker", "account", "capability", "state", "freshness", "limit", "cursor"], "class": "general", "expiry_rule": "expired SUPPORTED -> effective UNKNOWN"},
    {"path": "/rejections", "query": ["broker", "account", "symbol", "normalized_code", "requires_operator", "requires_broker_call", "from", "to", "limit", "cursor"], "class": "heavy"},
    {"path": "/notifications", "query": ["status", "severity", "broker", "symbol", "from", "to", "limit", "cursor"], "class": "general", "read_only": "cannot send/ack/resolve/escalate"},
    {"path": "/orders", "query": ["account", "broker", "symbol", "state", "environment", "from", "to", "limit", "cursor"], "class": "general", "note": "test/shadow projections; LIVE rows never served; no live refresh"},
    {"path": "/positions", "query": ["limit", "cursor"], "class": "general", "note": "marks/P&L UNAVAILABLE before market-data stages"},
    {"path": "/journal", "query": ["session", "symbol", "account", "event_type", "from", "to", "limit", "cursor"], "class": "heavy", "note": "replay references only"},
    {"path": "/features", "query": [], "class": "general", "note": "production effective modes always OFF; endpoint cannot mutate"},
    {"path": "/parity", "query": [], "class": "heavy", "states": ["NOT_APPLICABLE", "NOT_STARTED", "BASELINE_ONLY"]}
  ]
}
