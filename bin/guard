#!/usr/bin/env bash
# guard — operator approval ledger for Cursor agent sessions.
#
#   guard show                          list active grants
#   guard scopes                        list every scope and what it covers
#   guard grant <tier> [opts]           approve a whole scope (displays it first)
#   guard request <tier> [opts]         ask the operator by TELEGRAM (agent-callable;
#                                       grants nothing — they reply /approve <CODE>)
#   guard plan <file.md> [opts]         approve a plan: display it, grant its scopes
#   guard revoke <tier> | --all         cancel
#   guard log [n]                       what ran under auto-accept
#
# Options: --for 30m|2h   --uses N (default 10, -1 = unlimited)   --reason "..."
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null || dirname "$HERE")"
# shellcheck source=/dev/null
source "$ROOT/.cursor/hooks/guard-lib.sh"
mkdir -p "$GUARD_DIR"
# Never echo-redirect onto grants.json. Init only if MISSING. Doctor/show
# must still run when the ledger is corrupt.
_ls=$(_ledger state 2>/dev/null | jq -r '.state // empty')
if [[ "$_ls" == "MISSING" ]]; then
  _ledger init >/dev/null || true
fi
_ledger_require_valid() {
  local st
  st=$(_ledger state 2>/dev/null | jq -r '.state // "UNREADABLE"')
  case "$st" in
    ZERO_BYTE|MALFORMED|UNREADABLE)
      echo "${RED}APPROVAL_LEDGER_CORRUPT${OFF}  state=$st  path=$GRANTS"
      echo "Refuse to mutate a corrupt ledger. Run: bin/guard doctor"
      exit 2 ;;
  esac
}

# Every tier classify_cmd/classify_path can return, except the never-grantable
# ones. A tier missing here is unreachable: guarded paths now deny without a
# grant, so an ungrantable tier would be a permanent lockout.
ALL_TIERS="db-write cron git-push maintree service deps sudo state-write release-write openclaw telegram llm destructive config-write frozen-v2 guard-config file-delete"
BOLD=$'\e[1m'; RED=$'\e[31m'; YEL=$'\e[33m'; GRN=$'\e[32m'; OFF=$'\e[0m'

# Accepts 30m / 2h / 45s / a bare number of seconds. An unparseable duration
# EXITS rather than echoing itself through: "1800s" used to fall to the default
# branch and be returned verbatim, so cmd_grant printed the whole "APPROVING A
# WHOLE SCOPE" banner and only then died on `value too great for base` at the
# expiry arithmetic. A duration that cannot be read must stop before anything is
# shown — never display an approval and then fail computing its window.
parse_dur() {
  local v
  case "$1" in
    *m) v=$(( ${1%m} * 60 ));;
    *h) v=$(( ${1%h} * 3600 ));;
    *s) v="${1%s}";;
    *)  v="$1";;
  esac
  if [[ ! "$v" =~ ^[0-9]+$ ]]; then
    echo "unparseable duration: '$1' (use 30m, 2h, 45s, or a number of seconds)" >&2
    exit 1
  fi
  echo "$v"
}

cmd_scopes() {
  echo "${BOLD}Scopes that can be granted${OFF}"
  for t in $ALL_TIERS; do printf '  %-14s %s\n' "$t" "$(tier_scope "$t")"; done
  echo
  echo "${RED}Never grantable:${OFF}"
  echo "  secret         .env, keys, credential files — read or write. Bitwarden is the only store."
  echo "  gate           the four live-trading gates and the Schwab interlock."
}

cmd_show() {
  local n=$(now) any=0
  echo "${BOLD}Active grants${OFF}"
  for t in $ALL_TIERS; do
    local e u r; e=$(grant_expires "$t"); u=$(grant_left "$t"); r=$(grant_reason "$t")
    if [[ "$e" -gt "$n" && ( "$u" -lt 0 || "$u" -gt 0 ) ]]; then
      any=1
      printf '  %s%-14s%s %4s uses  %5dm left  — %s\n' "$YEL" "$t" "$OFF" \
        "$([[ $u -lt 0 ]] && echo '∞' || echo "$u")" $(( (e - n) / 60 )) "$r"
    fi
  done
  [[ $any -eq 0 ]] && echo "  ${GRN}none — every consequential action will prompt${OFF}"
}

cmd_grant() {
  _ledger_require_valid
  local tier="$1"; shift
  local dur=1800 uses=10 reason="(no reason given)" yes=0
  while [[ $# -gt 0 ]]; do case "$1" in
    --for)    dur=$(parse_dur "$2"); shift 2;;
    --uses)   uses="$2"; shift 2;;
    --reason) reason="$2"; shift 2;;
    --yes)    yes=1; shift;;
    *) echo "unknown option: $1"; exit 1;;
  esac; done

  case " $ALL_TIERS " in *" $tier "*) ;; *)
    echo "${RED}'$tier' is not grantable.${OFF} Run: guard scopes"; exit 1;; esac

  echo
  echo "${BOLD}${YEL}══ APPROVING A WHOLE SCOPE ══${OFF}"
  echo "${BOLD}Scope:${OFF}   $tier"
  echo "${BOLD}Covers:${OFF}  $(tier_scope "$tier")"
  echo "${BOLD}Window:${OFF}  $(( dur / 60 )) minutes"
  echo "${BOLD}Uses:${OFF}    $([[ $uses -lt 0 ]] && echo 'unlimited' || echo "$uses")"
  echo "${BOLD}Reason:${OFF}  $reason"
  echo
  echo "Every command in this scope will run ${BOLD}without prompting${OFF} until it expires."
  echo "Each one is still logged; review with: guard log"
  echo
  if [[ $yes -eq 0 ]]; then
    read -r -p "Type ${BOLD}APPROVE${OFF} to confirm: " ans
    ans="$(printf '%s' "$ans" | tr '[:lower:]' '[:upper:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [[ "$ans" != "APPROVE" ]]; then
      if [[ "$ans" == "APPPROVE" || "$ans" == "APROVE" ]]; then
        echo "${YEL}Typo — type exactly APPROVE (not APPPROVE).${OFF}"
      fi
      echo "cancelled"
      exit 1
    fi
  fi

  local exp=$(( $(now) + dur ))
  if ! _ledger grant --tier "$tier" --expires "$exp" --uses "$uses" --reason "$reason" >/dev/null; then
    echo "${RED}grant failed (ledger corrupt or write error).${OFF}  bin/guard doctor"; exit 2
  fi
  audit_line "$(jq -nc --arg ts "$(date -Is)" --arg t "$tier" --arg r "$reason" --argjson d "$dur" \
    '{ts:$ts, event:"grant-issued", tier:$t, reason:$r, seconds:$d}')"
  echo "${GRN}granted.${OFF}  revoke with: guard revoke $tier"
  if [[ "$tier" == "git-push" ]]; then
    echo "Agents may git push (or bin/agent-push) until this grant expires or uses run out."
    echo "Each push consumes one use from the Cursor shell guard and one from this grant window."
  fi
}

cmd_plan() {
  _ledger_require_valid
  local file="$1"; shift
  [[ -f "$file" ]] || { echo "no such plan file: $file"; exit 1; }
  local dur=3600 uses=25 tiers=""
  while [[ $# -gt 0 ]]; do case "$1" in
    --for)  dur=$(parse_dur "$2"); shift 2;;
    --uses) uses="$2"; shift 2;;
    --scopes) tiers="$2"; shift 2;;
    *) shift;;
  esac; done

  echo
  echo "${BOLD}${YEL}══ PLAN UNDER REVIEW ══${OFF}"
  echo "──────────────────────────────────────────────────────────"
  cat "$file"
  echo "──────────────────────────────────────────────────────────"
  echo

  if [[ -z "$tiers" ]]; then
    echo "Which scopes does this plan need? (space separated, or empty to cancel)"
    for t in $ALL_TIERS; do printf '  %-14s %s\n' "$t" "$(tier_scope "$t")"; done
    read -r -p "scopes: " tiers
  fi
  [[ -n "$tiers" ]] || { echo "cancelled"; exit 1; }

  echo
  echo "${BOLD}Auto-accept will be enabled for:${OFF}"
  for t in $tiers; do printf '  %s%-14s%s %s\n' "$YEL" "$t" "$OFF" "$(tier_scope "$t")"; done
  echo
  echo "Window: $(( dur / 60 )) minutes    Uses: $uses per scope"
  echo "${RED}Not included, and never auto-accepted: secret, gate.${OFF}"
  echo
  read -r -p "Type ${BOLD}APPROVE PLAN${OFF} to confirm: " ans
  [[ "$ans" == "APPROVE PLAN" ]] || { echo "cancelled"; exit 1; }

  for t in $tiers; do
    cmd_grant "$t" --for "$dur" --uses "$uses" --reason "plan: $(basename "$file")" --yes >/dev/null
    echo "  ${GRN}✓${OFF} $t"
  done
  echo "${GRN}plan approved.${OFF}  status: guard show   |   stop everything: guard revoke --all"
}

cmd_revoke() {
  _ledger_require_valid
  if [[ "${1:-}" == "--all" ]]; then
    _ledger revoke-all >/dev/null || { echo "${RED}APPROVAL_LEDGER_CORRUPT${OFF}"; exit 2; }
    audit_line "$(jq -nc --arg ts "$(date -Is)" '{ts:$ts, event:"revoke-all"}')"
    echo "${GRN}all grants revoked${OFF}"
    return
  fi
  _ledger revoke --tier "$1" >/dev/null || { echo "${RED}APPROVAL_LEDGER_CORRUPT${OFF}"; exit 2; }
  audit_line "$(jq -nc --arg ts "$(date -Is)" --arg t "$1" '{ts:$ts, event:"revoke", tier:$t}')"
  echo "${GRN}revoked: $1${OFF}"
}

cmd_doctor() {
  _ledger doctor
}

cmd_log() {
  local n="${1:-20}"
  [[ -f "$AUDIT" ]] || { echo "no audit log yet"; return; }
  # Read line-at-a-time and skip torn records: concurrent hook appends leave the
  # occasional unparseable line, and one of those must not blind the whole log.
  jq -R -r 'fromjson? // empty
         | select(.event=="auto-accepted" or .event=="grant-issued")
         | "\(.ts)  \(.event)  [\(.tier)]  \(.command // .reason)"' "$AUDIT" | tail -"$n"
}

case "${1:-show}" in
  show)   cmd_show ;;
  scopes) cmd_scopes ;;
  grant)  shift; cmd_grant "$@" ;;
  # Ask the operator by Telegram instead of at this terminal. Mints a PENDING
  # request and notifies; grants nothing. The reply is handled by the live
  # callback poller — see scripts/lib/guard_remote_approval.py.
  request) shift
    _py="$(command -v python3 || true)"
    for _c in "$HOME/trade-ai-v12-rebuild/trade-ai-v12-rebuild/.venv/bin/python" ; do
      [[ -x "$_c" ]] && _py="$_c" && break
    done
    exec "$_py" "$ROOT/scripts/guard_request_approval.py" "$@" ;;
  plan)   shift; cmd_plan  "$@" ;;
  revoke) shift; cmd_revoke "$@" ;;
  log)    shift; cmd_log   "$@" ;;
  doctor) cmd_doctor ;;
  *) sed -n '2,12p' "$0" ;;
esac
