    "  {light.--text-2}",
    "  {light.--text-3}",
    "",
    "  {light.--success-color}",
    "  {light.--success-bg}",
    "  {light.--success-border}",
    "  {light.--warning-color}",
    "  {light.--warning-bg}",
    "  {light.--warning-border}",
    "  {light.--danger-color}",
    "  {light.--danger-bg}",
    "  {light.--danger-border}",
    "  {light.--info-color}",
    "  {light.--info-bg}",
    "  {light.--info-border}",
    "  {light.--ai-color}",
    "  {light.--ai-bg}",
    "  {light.--ai-border}",
    "  {light.--neutral-color}",
    "  {light.--neutral-bg}",
    "  {light.--neutral-border}",
    "",
    "  {light.--primary-color}",
    "  {light.--secondary-color}",
    "  {light.--focus-ring}",
    "",
    "  {light.--chart-1}",
    "  {light.--chart-2}",
    "  {light.--chart-3}",
    "  {light.--chart-4}",
    "  {light.--chart-5}",
    "  {light.--chart-6}",
    "}",
    "",
    "@media (prefers-color-scheme: light) {",
    "  :root:not([data-theme]) {",
    "    {light.color-scheme}",
    "    {light.--bg-0} {light.--bg-1} {light.--bg-2} {light.--bg-3}",
    "    {light.--border-color} {light.--border-subtle}",
    "    {light.--text-0} {light.--text-1} {light.--text-2} {light.--text-3}",
    "    {light.--success-color} {light.--success-bg} {light.--success-border}",
    "    {light.--warning-color} {light.--warning-bg} {light.--warning-border}",
    "    {light.--danger-color} {light.--danger-bg} {light.--danger-border}",
    "    {light.--info-color} {light.--info-bg} {light.--info-border}",
    "    {light.--ai-color} {light.--ai-bg} {light.--ai-border}",
    "    {light.--neutral-color} {light.--neutral-bg} {light.--neutral-border}",
    "    {light.--primary-color} {light.--secondary-color} {light.--focus-ring}",
    "    {light.--chart-1} {light.--chart-2} {light.--chart-3} {light.--chart-4} {light.--chart-5} {light.--chart-6}",
    "  }",
    "}",
    "",
    "/* Theme-independent scales */",
    ":root {",
    "  {scales.--space-1}  {scales.--space-2}  {scales.--space-3} {scales.--space-4}",
    "  {scales.--space-5} {scales.--space-6} {scales.--space-7} {scales.--space-8}",
    "",
    "  {scales.--radius-sm}",
    "  {scales.--radius-md}",
    "  {scales.--radius-lg}",
    "  {scales.--radius-pill}",
    "",
    "  {scales.--shadow-1}",
    "  {scales.--shadow-2}",
    "  {scales.--shadow-3}",
    "",
    "  /* Locked type scale: xs is for chips only. */",
    "  {scales.--font-xs} {scales.--font-sm} {scales.--font-base} {scales.--font-md} {scales.--font-lg} {scales.--font-xl}",
    "  {scales.--font-sans}",
    "  {scales.--font-mono}",
    "}",
    "",
    "/* Bloomberg-style terminal skin: same semantic names, tighter chrome, amber primary. */",
    ".cc-terminal-ui {",
    "  {terminal.--primary-color}",
    "  {terminal.--focus-ring}",
    "  {terminal.--radius-sm}",
    "  {terminal.--radius-md}",
    "  {terminal.--radius-lg}",
    "}",
    "",
    "/* The terminal palette is a DARK look: it must not override an explicit light theme, so it is",
    "   scoped to every root except [data-theme=\"light\"] (PR4, 2026-09-28). */",
    ":root:not([data-theme=\"light\"]) .cc-terminal-ui {",
    "  {terminal_dark.--bg-0}",
    "  {terminal_dark.--bg-1}",
    "  {terminal_dark.--bg-2}",
    "  {terminal_dark.--bg-3}",
    "  {terminal_dark.--border-color}",
    "  {terminal_dark.--border-subtle}",
    "  {terminal_dark.--text-0}",
    "  {terminal_dark.--text-1}",
    "  {terminal_dark.--text-2}",
    "  {terminal_dark.--text-3}",
    "  {terminal_dark.--warning-color}",
    "  {terminal_dark.--warning-bg}",
    "  {terminal_dark.--warning-border}",
    "}"
