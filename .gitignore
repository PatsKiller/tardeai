# ============================================================================
# Trade AI v12 .gitignore
# Philosophy: Git tracks CODE and SCHEMA only. Personal financial state stays
# out of version control entirely. Generated outputs stay out (regenerable
# from code + state).
# ============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json — now tracked for reproducible builds

# ── Claude Code ─────────────────────────────────────────────────────────────
.claude/

# ── Secrets — NEVER COMMIT ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json

# ── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Backups & archives (out-of-band backup strategy, not git) ──────────────
backups/
file_backups/
# WAVE G4 (2026-08-31): `archive/` is the §0.6 mechanism tree and MUST be
# tracked so `git mv` preserves history + ARCHIVE_MANIFEST.json is reviewable.
# Local bulk dumps belong in backups/ / file_backups/, not here.
# archive/  # retired — was incompatible with the archive mechanism
*.tar.gz
*.zip
*.bak
*_backup_*

# ── Audit/screenshot workspace (tmp analysis folders) ──────────────────────
cc_audit/
sandbox/

# ── All portfolio/personal data — PII, holdings, AI outputs, CSVs ──────────
# Option A: state stays out of git
data/*
# Exceptions: integrity manifest is a deployment artifact (source of truth).
# A bare `data/` excludes the whole tree, which makes the file-level negation
# below ineffective (git won't descend into an excluded directory). Un-ignore
# the runtime dir, re-ignore its contents, then exempt the one tracked file.
!data/runtime/
data/runtime/*
!data/runtime/file_integrity_manifest.json

# ── Generated reports (regenerable from code + state) ──────────────────────
/reports/

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Temporary ───────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Yesterday's experimental files at repo root (review before keeping) ─────
# These were created during Phase 2/3 iteration. Uncomment to exclude, or
# leave to track. If unsure, ignore for now and decide later.
# patch_ai_tab_v2.py
# phase1b_fix.py
# phase2_weekly.py
# phase2b_analyst.py

# ── Other scripts/binaries that need review ────────────────────────────────
# cleanup_ms01.sh    # keep if you want to version your cleanup scripts

apps/command-center-v2-backup-*

# ── Additional artifact exclusions ─────────────────────────────────────────
*.bak_session*
docs/project/docx_patch_*.json
docs/project/docx_patch_*.py
*.tst
docs/session33_patches.tar.gz
backups/doc_exports/*.zip

# ── SearXNG / Docker infrastructure ──────────────────────────────────────
infra/searxng/.env
data/searxng_queries/

# YouTube auth cookies (secret — never commit)
config/youtube_cookies.txt

# broker-admin secrets (never commit)
config/broker_credentials.env
apps/broker-admin/.admin_password

# Hermes runtime artifacts (machine-generated each challenger/loop cycle — not source)
docs/hermes/phase3b_dryrun/
docs/hermes/**/latest_*.json
hermes_sidecar/.hermes/channel_directory.json

# Hermes runtime / retired sidecar artifacts (git hygiene after Stage D rename-retire 2026-06-06)
# NOTE: wrappers hermes_sidecar/run_hermes_readonly.sh + run_hermes_gateway.sh stay TRACKED (retirement stubs)
hermes_sidecar/.hermes/
hermes_sidecar/.hermes.*
hermes_sidecar/install/
hermes_sidecar/install.*
hermes_sidecar/**/*.db
hermes_sidecar/**/*.db-shm
hermes_sidecar/**/*.db-wal
hermes_sidecar/**/gateway.pid
hermes_sidecar/**/gateway.lock
hermes_sidecar/**/auth.lock
hermes_sidecar/**/sessions/request_dump_*.json
imports/schwab_gainloss/
imports/schwab_history/
data/state_guard_audit.jsonl
data/backups/state_snapshots/
config/snaptrade_accounts.json

# ── Generated/snapshot docs ─────────────────────────────────────────────────
# Auto-generated reports/briefs/status snapshots. Untracked on main (keep dev
# diffs quiet); snapshotted to the `generated-docs-backup` branch by the daily
# docs-backup cron (linux_launchers/backup_generated_docs.sh). Authored docs in
# these dirs (PHASE*.md, HERMES_*.md) stay tracked — only generated patterns here.
docs/governance/*latest*
docs/maturity_hardening/*latest*
docs/hermes/backlog_health/
docs/hermes/embedding_promotion_reviews/
docs/hermes/observations/
docs/hermes/librarian_loop_dryruns/
docs/openclaw_aegis_morning_brief_*.md
docs/project/STATE_OF_REPO_LATEST.md
docs/project/SYSTEM_FACTS_LATEST.md
docs/project/*.docx.bak_*

# Generated runtime state (regenerated by runtime processes; not source). Keeps the release tree
# clean through churn. hermes_llm_capabilities.json stays tracked (stable config, not churn).
data/runtime/*_latest.json
data/runtime/*_history.json
data/runtime/catalyst_calibration.json
state/trade_in_view_profit_capture.json
state/hermes/
docs/project/Trade_AI_v12_Reference_Architecture.pdf

# ── Secrets-hygiene hardening (2026-07-04 due-diligence audit) ──
# cookie backups slipped past *.bak (file was youtube_cookies.txt.bak.20260509)
config/youtube_cookies.txt*
*.bak.*
*cookies.txt
*cookies.txt.*
# runtime trading state — never commit (momentum_scalp state was tracked)
state/
# drive-inventory logs leak personal Drive filenames
logs/drive_cleanup_*/
# ephemeral run artifacts (Playwright captures etc.) — docs/runbooks/PLAYWRIGHT_ARTIFACTS_POLICY.md
artifacts/
data/runtime/gain_guardian_charts/
data/runtime/ri_snapshots/
apps/command-center-v3/test-results/

# Claude Code project skills are shared config (settings.local stays ignored)
!.claude/
.claude/*
!.claude/skills/

# Schwab auto-reauth runtime (persistent browser profile carries session cookies — never commit)
data/runtime/schwab_browser_profile/
data/runtime/schwab_reauth_debug/
data/runtime/schwab_auto_reauth_state.json

# cc-whole-site-residual-v1: generated truth evidence. Every artifact under here is
# regenerated by `python3 scripts/emit_whole_site_evidence.py` and
# `python3 -m scripts.cc_browser_matrix`; committing timestamped copies would be
# runtime churn, and the campaign archive is the durable record.
evidence/whole_site/

# Generated build stamp. Written by the deploy (cio_phase2_exact_main_deploy.sh),
# never by hand, and it records the commit it was built FROM — so it is always one
# behind the commit that would contain it and can never be committed cleanly.
# Its dist twin is already ignored by the bare `dist/` rule above; this restores
# the symmetry. Release copies are authored by the deploy and are unaffected.
apps/command-center-v3/build-meta.json
