# Copy to ~/.config/tradeai/n8n/n8n.env (mode 0600, directory 0700), or let
# `scripts/ops/n8n_compose_cutover.py --prepare-env` write it: the two secrets from the old bake-off .env,
# the gateway from `docker network inspect m8m-n8n_lab`. Only these three keys. Never commit the real file.
N8N_PG_PASSWORD=replace-me
N8N_ENCRYPTION_KEY=replace-me
N8N_RELAY_GATEWAY=replace-me
