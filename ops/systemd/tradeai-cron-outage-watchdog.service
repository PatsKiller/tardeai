[Unit]
Description=Independent TradeAI wrapper refusal and missed-success monitor

[Service]
Type=oneshot
WorkingDirectory=%h/trade-ai-releases/portfolio-server/CURRENT
Environment=TRADEAI_STATE_ROOT=%h/trade-ai-releases/persistent-state
ExecStart=%h/trade-ai-releases/portfolio-server/CURRENT/.venv/bin/python scripts/cron_outage_watchdog.py --run --send-alerts
# Exit 1 = findings (CRIT) were observed and reported: the run itself succeeded. 2+ stay unit failures. A crash
# (traceback, also exit 1) writes no fresh cron_outage_watchdog_latest.json, so Health turns UNKNOWN after 180 s.
SuccessExitStatus=1
TimeoutStartSec=45
# Installed by the release (scripts/install_staged_units.py via config/staged_user_units.json, dry-run first);
# never safe_flock/notifier/n8n: the alert path must not depend on what it watches.
