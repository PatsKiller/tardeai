# Trade AI — passwordless start/status for main Postgres only.
# Incident 2026-09-18: disk hygiene freed space but postgresql@17-main stayed down.
#
# Install (operator gate — requires root):
#   sudo install -m 440 -o root -g root \
#     linux_launchers/sudoers/tradeai-postgres-main-start \
#     /etc/sudoers.d/tradeai-postgres-main-start
#   sudo visudo -cf /etc/sudoers.d/tradeai-postgres-main-start
#
# Scope is intentionally narrow: start + is-active + status only. No stop/restart/reset-failed.

# Cover both /bin and /usr/bin (Ubuntu resolves systemctl via /usr/bin; sudo
# matches the resolved argv path). Without /usr/bin, `sudo -n systemctl …`
# still demands a password even though the drop-in is installed.
johnclaw ALL=(root) NOPASSWD: /bin/systemctl start postgresql@17-main, /usr/bin/systemctl start postgresql@17-main
johnclaw ALL=(root) NOPASSWD: /bin/systemctl is-active postgresql@17-main, /usr/bin/systemctl is-active postgresql@17-main
johnclaw ALL=(root) NOPASSWD: /bin/systemctl status postgresql@17-main, /usr/bin/systemctl status postgresql@17-main
